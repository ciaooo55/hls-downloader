import { LineEdit, TextEdit, SpinBox } from "std-widgets.slint";
import { Tokens, HotButton, FieldLabel, HotCheckBox, HotScrollView, HotComboBox, Panel, WorkbenchIcon } from "theme.slint";
import { DialogHeader, DialogFooter } from "dialog_components.slint";

export component TaskEditorWindow inherits Window {
    icon: @image-url("../../assets/app-icon.png");
    title: root.mode == "batch" ? "批量添加" : root.mode == "curl" ? "导入 cURL" : "新建下载";
    default-font-family: Tokens.type-face;
    default-font-size: 13px;
    background: Tokens.canvas;
    preferred-width: 720px; preferred-height: 660px;
    min-width: 460px; min-height: 360px;
    in-out property <string> mode: "new";
    in-out property <string> url;
    in-out property <string> filename;
    in-out property <string> download-dir;
    in-out property <string> kind: "自动识别";
    in-out property <string> method: "GET";
    in-out property <string> headers;
    in-out property <string> cookie;
    in-out property <string> proxy;
    in-out property <string> body-path;
    in-out property <string> checksum;
    in-out property <string> mirrors;
    in-out property <int> concurrency: 0;
    in-out property <int> speed-limit: 0;
    in-out property <string> start-at;
    in-out property <string> stop-at;
    in-out property <string> queue-id: "default";
    in property <[string]> queue-names: ["默认队列"];
    in-out property <int> queue-index: 0;
    in-out property <[string]> variants;
    in-out property <int> variant-index: 0;
    in-out property <string> audio;
    in-out property <bool> start-paused: false;
    in-out property <bool> allow-duplicate: false;
    in-out property <bool> legal-accepted: false;
    in property <string> batch-preview: "支持通配符：[001-050]、[1-100:2]、[a-z]";
    in property <bool> batch-preview-active: false;
    in property <bool> batch-preview-warning: false;
    in-out property <string> result;
    // 页脚状态语气：info / success / warning / error，由 Rust 随状态文字一起设置。
    in property <string> result-tone: "warning";
    in-out property <bool> busy: false;
    in-out property <bool> advanced-expanded: false;
    out property <bool> has-advanced-values: root.method != "GET" || root.concurrency != 0 || root.speed-limit != 0 || root.headers != "" || root.cookie != "" || root.proxy != "" || root.body-path != "" || root.checksum != "" || root.mirrors != "" || root.start-at != "" || root.stop-at != "" || (root.queue-id != "" && root.queue-id != "default");
    private property <bool> show-advanced: root.advanced-expanded;
    callback action(string);
    callback queue-selected(int);
    callback url-edited(string);
    VerticalLayout {
        spacing: 0px;
        DialogHeader { heading: root.title; description: root.mode == "batch" ? "每行一个链接，批量添加到下载队列" : root.mode == "curl" ? "粘贴浏览器复制的 cURL 命令" : "粘贴下载地址，选择保存位置与下载选项"; icon: root.mode == "new" ? "new" : root.mode == "curl" ? "import" : "batch"; }
        HotScrollView {
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.width;
            VerticalLayout {
                padding: 20px; padding-left: 24px; padding-right: 24px; spacing: 14px; alignment: start;
                // 核心高频项放进首屏主卡片，减少视觉干扰。
                Panel {
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        // 所有字段统一“左侧 80px 标签列 + 右侧控件”，多行输入的标签与首行对齐。
                        if root.mode == "new": HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "下载地址"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.url; accessible-label: "下载地址"; placeholder-text: "HTTP、HLS、DASH、FTP、SFTP 或磁力链接"; } }
                        if root.mode != "new": HorizontalLayout {
                            spacing: Tokens.control-gap;
                            FieldLabel { label: root.mode == "curl" ? "cURL 命令" : "下载地址"; width: 80px; height: Tokens.control-height; vertical-alignment: center; y: 0px; }
                            VerticalLayout {
                                spacing: 6px;
                                TextEdit {
                                    text <=> root.url;
                                    accessible-label: "下载地址";
                                    min-height: 132px;
                                    preferred-height: 132px;
                                    edited(value) => { root.url-edited(value); }
                                }
                                if root.mode == "batch": Rectangle {
                                    min-height: 26px;
                                    border-radius: Tokens.control-radius;
                                    background: root.batch-preview-warning ? Tokens.warn-surface : root.batch-preview-active ? Tokens.info-surface : Tokens.surface-2;
                                    border-width: 1px;
                                    border-color: root.batch-preview-warning ? Tokens.warn.with-alpha(Tokens.dark ? 0.38 : 0.28) : root.batch-preview-active ? Tokens.accent-border : Tokens.hairline;
                                    animate background, border-color { duration: Tokens.motion-fast; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        spacing: 6px;
                                        WorkbenchIcon {
                                            name: root.batch-preview-warning ? "failed" : root.batch-preview-active ? "batch" : "info";
                                            ink: root.batch-preview-warning ? Tokens.warn : root.batch-preview-active ? Tokens.accent : Tokens.faint;
                                            width: 13px;
                                            height: 13px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: root.batch-preview;
                                            color: root.batch-preview-warning ? Tokens.warn : root.batch-preview-active ? Tokens.accent : Tokens.faint;
                                            font-size: 11px;
                                            font-weight: root.batch-preview-active || root.batch-preview-warning ? 600 : 400;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Tokens.control-gap;
                            FieldLabel { label: "保存位置"; width: 80px; }
                            LineEdit { height: Tokens.control-height; text <=> root.download-dir; accessible-label: "保存位置"; }
                            HotButton { label: "浏览…"; icon: "folder"; clicked => { root.action("folder"); } }
                        }
                        HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "文件名"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.filename; accessible-label: "文件名"; placeholder-text: "留空自动确定"; } }
                        HorizontalLayout {
                            spacing: Tokens.control-gap;
                            FieldLabel { label: "类型"; width: 80px; }
                            HotComboBox {
                                height: Tokens.control-height;
                                model: ["自动识别", "普通文件", "HLS", "DASH", "直播", "种子 / 磁力"];
                                property <string> bound: root.kind;
                                current-index: root.kind == "种子 / 磁力" ? 5 : root.kind == "直播" ? 4 : root.kind == "DASH" ? 3 : root.kind == "HLS" ? 2 : root.kind == "普通文件" ? 1 : 0;
                                changed bound => { self.current-index = root.kind == "种子 / 磁力" ? 5 : root.kind == "直播" ? 4 : root.kind == "DASH" ? 3 : root.kind == "HLS" ? 2 : root.kind == "普通文件" ? 1 : 0; }
                                selected(value) => { root.kind = value; }
                            }
                            HotButton { label: "识别 / 探测"; icon: "search"; enabled: !root.busy; clicked => { root.action("probe"); } }
                        }
                        if root.variants.length > 0: HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "清晰度"; width: 80px; } HotComboBox { height: Tokens.control-height; model: root.variants; current-index <=> root.variant-index; } }
                        HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "音轨"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.audio; accessible-label: "音轨标识"; placeholder-text: "语言或音轨标识，留空自动选择"; } }
                    }
                }
                // 高级选项折叠卡片：新建默认收起，已有高级参数时由 Rust 初始展开，用户可随时自由收起或展开。
                Panel {
                    VerticalLayout {
                        padding: 0px; spacing: 0px;
                        adv-toggle := Rectangle {
                            height: 44px;
                            border-radius: Tokens.panel-radius;
                            background: adv-touch.pressed ? Tokens.control-pressed : adv-touch.has-hover ? Tokens.surface-2 : transparent;
                            animate background { duration: Tokens.motion-fast; }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 8px;
                                WorkbenchIcon { name: "settings"; ink: root.show-advanced ? Tokens.accent : Tokens.muted; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                                Text { text: "高级选项"; color: Tokens.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                Text { text: root.has-advanced-values ? "已填写自定义参数" : "请求头、Cookie、代理、限速、校验与计划"; color: root.has-advanced-values ? Tokens.accent : Tokens.faint; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                WorkbenchIcon { name: root.show-advanced ? "chevron-up" : "chevron-down"; ink: Tokens.muted; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                            }
                            adv-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: root.show-advanced ? "收起高级选项" : "展开高级选项";
                                clicked => { root.advanced-expanded = !root.advanced-expanded; }
                            }
                        }
                        Rectangle {
                            height: root.show-advanced ? adv-body.preferred-height : 0px;
                            opacity: root.show-advanced ? 1 : 0;
                            visible: self.height > 0px;
                            clip: true;
                            animate height, opacity { duration: Tokens.motion-slow; easing: ease-out; }
                            adv-body := VerticalLayout {
                                y: 0px;
                                height: self.preferred-height;
                                padding: 0px;
                                spacing: 0px;
                                Rectangle { height: 1px; background: Tokens.hairline; }
                                VerticalLayout {
                                    padding: 16px; spacing: 12px;
                                    HorizontalLayout {
                                        spacing: Tokens.control-gap;
                                        FieldLabel { label: "请求方法"; width: 80px; }
                                        HotComboBox {
                                            height: Tokens.control-height;
                                            model: ["GET", "POST", "PUT", "PATCH", "HEAD"];
                                            property <string> bound: root.method;
                                            current-index: root.method == "HEAD" ? 4 : root.method == "PATCH" ? 3 : root.method == "PUT" ? 2 : root.method == "POST" ? 1 : 0;
                                            changed bound => { self.current-index = root.method == "HEAD" ? 4 : root.method == "PATCH" ? 3 : root.method == "PUT" ? 2 : root.method == "POST" ? 1 : 0; }
                                            selected(value) => { root.method = value; }
                                        }
                                        FieldLabel { label: "并发连接"; }
                                        SpinBox { value <=> root.concurrency; accessible-label: "并发连接"; height: Tokens.control-height; minimum: 0; maximum: 128; }
                                    }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "正文文件"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.body-path; accessible-label: "正文文件"; placeholder-text: "POST 等请求的可重放正文文件"; } }
                                    HorizontalLayout {
                                        spacing: Tokens.control-gap;
                                        FieldLabel { label: "请求头"; width: 80px; height: Tokens.control-height; vertical-alignment: center; y: 0px; }
                                        VerticalLayout {
                                            spacing: 4px;
                                            TextEdit { text <=> root.headers; accessible-label: "请求头"; min-height: 80px; preferred-height: 80px; }
                                            Text { text: "每行一个，格式 Name: Value"; color: Tokens.faint; font-size: 11px; }
                                        }
                                    }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "Cookie"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.cookie; accessible-label: "Cookie"; input-type: password; } }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "代理"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.proxy; accessible-label: "代理"; placeholder-text: "留空使用设置"; } }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "校验值"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.checksum; accessible-label: "校验值"; placeholder-text: "SHA-256、SHA-1 或 MD5"; } }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "镜像地址"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.mirrors; accessible-label: "镜像地址"; placeholder-text: "多个地址使用 | 分隔"; } }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "限速 KiB/s"; width: 80px; } SpinBox { value <=> root.speed-limit; accessible-label: "任务限速 KiB/s"; height: Tokens.control-height; minimum: 0; maximum: 1000000; } Text { text: "0 表示不限速"; color: Tokens.faint; font-size: 11px; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "计划开始"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.start-at; accessible-label: "计划开始"; placeholder-text: "HH:mm 或 2026-01-01T22:00:00+08:00"; } }
                                    HorizontalLayout { spacing: Tokens.control-gap; FieldLabel { label: "计划停止"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.stop-at; accessible-label: "计划停止"; placeholder-text: "HH:mm 或 2026-01-01T23:30:00+08:00"; } }
                                    HorizontalLayout {
                                        spacing: Tokens.control-gap;
                                        FieldLabel { label: "下载队列"; width: 80px; }
                                        HotComboBox {
                                            height: Tokens.control-height;
                                            model: root.queue-names;
                                            a11y-label: "下载队列";
                                            property <int> bound: root.queue-index;
                                            current-index: root.queue-index;
                                            changed bound => { self.current-index = root.queue-index; }
                                            selected(value) => {
                                                root.queue-index = self.current-index;
                                                root.queue-selected(self.current-index);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Panel {
                    VerticalLayout {
                        padding: 14px; padding-left: 16px; padding-right: 16px; spacing: 8px;
                        HotCheckBox { text: "添加后暂不开始"; checked <=> root.start-paused; }
                        HotCheckBox { text: "允许重复任务"; checked <=> root.allow-duplicate; }
                        HotCheckBox { text: "我已确认有权下载，并接受使用条款"; checked <=> root.legal-accepted; }
                    }
                }
            }
        }
        DialogFooter {
            status: root.result; tone: root.result-tone;
            HotButton { label: root.busy ? "关闭" : "取消"; clicked => { root.action("close"); } }
            HotButton { label: root.busy ? "处理中…" : "添加任务"; icon: "new"; primary: true; enabled: !root.busy && root.legal-accepted && root.url != ""; clicked => { root.action("create"); } }
        }
    }
}
