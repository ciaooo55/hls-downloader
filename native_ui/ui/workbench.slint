import { ListView } from "std-widgets.slint";
import { Tokens, HotCheckBox, HotCloseButton, HotScrollView, ScrollCue, SegmentBlock, SegmentMapBar, Panel } from "theme.slint";
import { WorkbenchIcon, WorkbenchButton, NavigationItem, FileTile, StatusBadge } from "workbench_components.slint";
import { MediaSurface, MediaView } from "media.slint";

export struct TaskRow {
    id: string,
    name: string,
    status: string,
    size: string,
    speed: string,
    eta: string,
    progress: float,
    selected: bool,
    kind: string,
    protocol: string,
    metadata: string,
    status-code: string,
    primary-action: string,
    primary-label: string,
}

export struct NavigationRow { id: string, label: string, count: int, active: bool, icon: string, group: string, heading: string }
export struct TaskMenuRow { label: string, action: string, icon: string, enabled: bool, divider: bool }
export struct TaskColumn { id: string, label: string, width: float }
export struct ToolbarItem { action: string, label: string, icon: string }

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> sortable: true;
    in property <string> sort-direction: "";
    in property <length> label-x: 16px;
    in property <length> hit-x: 0px;
    callback clicked;
    height: 34px;
    background: !root.sortable ? transparent : touch.pressed ? Tokens.control-pressed : touch.has-hover ? Tokens.control-hover : transparent;
    animate background { duration: Tokens.motion-fast; }
    HorizontalLayout {
        x: root.label-x;
        width: max(0px, parent.width - root.label-x - 6px);
        height: parent.height;
        spacing: 4px;
        alignment: start;
        Text {
            text: root.label;
            color: root.sort-direction != "" ? Tokens.ink : root.sortable && touch.has-hover ? Tokens.ink : Tokens.muted;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: Tokens.motion-fast; }
        }
        if root.sort-direction != "": WorkbenchIcon {
            name: root.sort-direction == "desc" ? "chevron-down" : "chevron-up";
            ink: Tokens.accent;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
        }
    }
    touch := TouchArea {
        x: root.hit-x;
        width: max(0px, parent.width - root.hit-x);
        height: parent.height;
        mouse-cursor: root.sortable ? pointer : default;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

component TaskInspector inherits Rectangle {
    in property <string> title-text;
    in property <string> kind: "file";
    in property <string> status;
    in property <string> status-code;
    in property <string> transfer;
    in property <string> speed-stats;
    in property <string> connections;
    in property <string> bt;
    in property <string> mirrors;
    in property <string> checksum;
    in property <string> checksum-tone;
    in property <string> av;
    in property <string> av-tone;
    in property <string> diagnostic;
    in property <string> logs;
    in property <float> progress;
    in property <[SegmentBlock]> segments;
    in property <[float]> speed-history;
    in property <bool> can-open-folder;
    private property <bool> has-telemetry: root.bt != "" || root.mirrors != "" || root.checksum != "" || root.av != "";
    private property <bool> is-processing: root.status-code == "merging" || root.status-code == "checking" || root.status-code == "processing" || root.status-code == "remuxing" || root.status-code == "finalizing";
    callback open-folder();
    callback open-details();
    callback collapse();

    border-radius: Tokens.panel-radius;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.line;
    drop-shadow-offset-y: 2px;
    drop-shadow-blur: 8px;
    drop-shadow-color: Tokens.shadow;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        // 抽屉顶部栏
        Rectangle {
            height: 44px;
            background: Tokens.surface-2;
            HorizontalLayout {
                padding-left: 14px; padding-right: 8px; spacing: 8px;
                WorkbenchIcon { name: "panel-right"; ink: Tokens.accent; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                Text { text: "任务检视"; color: Tokens.ink; font-size: 13px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                if root.title-text != "" && root.can-open-folder: WorkbenchButton {
                    label: "打开位置"; icon: "folder"; icon-only: true; subtle: true; width: 28px; height: 28px; y: (parent.height - self.height) / 2;
                    clicked => { root.open-folder(); }
                }
                if root.title-text != "": WorkbenchButton {
                    label: "完整详情"; icon: "details"; icon-only: true; subtle: true; width: 28px; height: 28px; y: (parent.height - self.height) / 2;
                    clicked => { root.open-details(); }
                }
                WorkbenchButton {
                    label: "收起检视"; hint: "收起检视抽屉 (Alt+I)"; icon: "chevron-right"; icon-only: true; subtle: true; width: 28px; height: 28px; y: (parent.height - self.height) / 2;
                    clicked => { root.collapse(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line; }
        }

        if root.title-text == "": VerticalLayout {
            vertical-stretch: 1;
            padding: 24px;
            spacing: 10px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px; height: 48px; border-radius: 12px;
                    background: Tokens.surface-2; border-width: 1px; border-color: Tokens.line;
                    WorkbenchIcon { name: "details"; ink: Tokens.faint; width: 22px; height: 22px; x: 13px; y: 13px; }
                }
            }
            Text { text: "未选中任务"; color: Tokens.ink; font-size: 13.5px; font-weight: 600; horizontal-alignment: center; }
            Text { text: "点选列表中的任意下载项，即可在此实时检视传输概览、分段连接与活动日志"; color: Tokens.faint; font-size: 11.5px; wrap: word-wrap; horizontal-alignment: center; }
        }

        if root.title-text != "": HotScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.visible-width;
            viewport-height: insp-body.preferred-height;
            insp-body := VerticalLayout {
                width: parent.visible-width;
                padding: 12px;
                spacing: 10px;
                alignment: start;

                // ── 1. 传输概览 ──────────────────────────────────────────────
                Rectangle {
                    border-radius: Tokens.card-radius;
                    background: Tokens.surface-2;
                    border-width: 1px;
                    border-color: Tokens.hairline;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "传输概览"; color: Tokens.muted; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            StatusBadge { label: root.status; status-code: root.status-code; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            FileTile { kind: root.kind; width: 34px; height: 34px; y: (parent.height - self.height) / 2; }
                            VerticalLayout {
                                alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
                                Text { text: root.title-text; color: Tokens.ink; font-size: 12.5px; font-weight: 700; overflow: elide; }
                                Text { text: root.transfer; color: Tokens.muted; font-size: 11px; overflow: elide; }
                            }
                        }
                        Rectangle {
                            height: 6px; border-radius: 3px; background: Tokens.surface-3; clip: true;
                            Rectangle {
                                x: 0px; height: parent.height;
                                width: parent.width * Math.clamp(root.progress, 0, 1);
                                border-radius: 3px;
                                background: root.status-code == "paused" || root.is-processing ? Tokens.warn : root.status-code == "completed" || root.status-code == "done" ? Tokens.done : root.status-code == "failed" || root.status-code == "canceled" ? Tokens.fail : Tokens.accent;
                            }
                        }
                        if root.speed-stats != "": Text { text: root.speed-stats; color: Tokens.faint; font-size: 10.5px; overflow: elide; }
                        if root.speed-history.length > 0: Rectangle {
                            height: 36px; border-radius: 6px; background: Tokens.surface; border-width: 1px; border-color: Tokens.hairline; clip: true;
                            Rectangle {
                                x: 6px; y: 5px; width: parent.width - 12px; height: parent.height - 10px;
                                for sample[idx] in root.speed-history: Rectangle {
                                    width: max(2px, parent.width / max(root.speed-history.length, 1) - 1px);
                                    x: idx * (parent.width / max(root.speed-history.length, 1));
                                    height: max(2px, parent.height * sample);
                                    y: parent.height - self.height;
                                    border-top-left-radius: 1.5px; border-top-right-radius: 1.5px;
                                    background: Tokens.accent; opacity: 0.82;
                                }
                            }
                        }
                        if root.has-telemetry: VerticalLayout {
                            spacing: 4px;
                            if root.bt != "": Text { text: root.bt; color: Tokens.info; font-size: 11px; font-weight: 600; wrap: word-wrap; }
                            if root.mirrors != "": Text { text: root.mirrors; color: Tokens.muted; font-size: 11px; wrap: word-wrap; }
                            if root.checksum != "": Text { text: root.checksum; color: root.checksum-tone == "success" ? Tokens.done : Tokens.fail; font-size: 11px; font-weight: 600; wrap: word-wrap; }
                            if root.av != "": Text { text: root.av; color: root.av-tone == "success" ? Tokens.done : root.av-tone == "fail" ? Tokens.fail : root.av-tone == "warn" ? Tokens.warn : Tokens.muted; font-size: 11px; font-weight: 600; wrap: word-wrap; }
                        }
                        if root.diagnostic != "": Rectangle {
                            border-radius: 6px; background: Tokens.warn-surface; border-width: 1px; border-color: Tokens.warn.with-alpha(Tokens.dark ? 0.34 : 0.24);
                            HorizontalLayout {
                                padding: 8px; spacing: 6px;
                                WorkbenchIcon { name: "failed"; ink: Tokens.warn; width: 14px; height: 14px; y: 2px; }
                                Text { text: root.diagnostic; color: Tokens.ink; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }

                // ── 2. 分段连接状态 ──────────────────────────────────────────
                Rectangle {
                    border-radius: Tokens.card-radius;
                    background: Tokens.surface-2;
                    border-width: 1px;
                    border-color: Tokens.hairline;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: "分段连接状态"; color: Tokens.muted; font-size: 11px; font-weight: 600; }
                        if root.segments.length > 0: SegmentMapBar { segments: root.segments; }
                        Text {
                            text: root.connections != "" ? root.connections : "单连接顺序传输";
                            color: Tokens.faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }

                // ── 3. 实时日志 ──────────────────────────────────────────────
                Rectangle {
                    border-radius: Tokens.card-radius;
                    background: Tokens.surface-2;
                    border-width: 1px;
                    border-color: Tokens.hairline;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            Text { text: "实时日志"; color: Tokens.muted; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            WorkbenchButton {
                                label: "查看完整日志"; icon: "details"; subtle: true; height: 24px;
                                clicked => { root.open-details(); }
                            }
                        }
                        Rectangle {
                            border-radius: 6px;
                            background: Tokens.surface;
                            border-width: 1px;
                            border-color: Tokens.hairline;
                            min-height: 76px;
                            VerticalLayout {
                                padding: 8px;
                                Text {
                                    text: root.logs != "" ? root.logs : "等待任务传输事件…";
                                    color: root.logs != "" ? Tokens.muted : Tokens.faint;
                                    font-size: 10.5px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component WorkbenchWindow inherits Window {
    in property <string> product-version;
    title: "HLS Downloader " + root.product-version;
    icon: @image-url("../../assets/app-icon.png");
    default-font-family: Tokens.type-face;
    default-font-size: 13px;
    background: Tokens.canvas;
    preferred-width: 1400px;
    preferred-height: 820px;
    min-width: 560px;
    min-height: 360px;
    in property <[TaskRow]> tasks;
    in-out property <length> viewport-width: 1400px;
    in-out property <length> viewport-height: 820px;
    changed width => {
        if (self.width > 0px && self.width != root.viewport-width) {
            root.viewport-width = self.width;
            root.viewport-resized(self.width / 1px);
        }
    }
    changed height => {
        if (self.height > 0px && self.height != root.viewport-height) {
            root.viewport-height = self.height;
        }
    }
    in property <[NavigationRow]> navigation;
    in property <[TaskMenuRow]> task-menu;
    in property <[TaskColumn]> columns;
    private property <bool> compact-columns: root.columns.length > 1 && root.columns[1].width < 140;
    in property <[ToolbarItem]> toolbar;
    in property <bool> engine-online: true;
    in property <string> connection: "正在连接下载引擎…";
    in property <string> browser-status: "浏览器未连接";
    in property <bool> speed-limit-enabled: false;
    in property <int> speed-limit-kib: 0;
    in property <string> speed-limit-label: "限速：关";
    in property <string> telemetry-speed: "0 B/s";
    in property <int> active-task-count: 0;
    in-out property <bool> power-action-pending: false;
    in property <string> summary;
    in property <string> notice;
    in property <string> notice-tone: "info";
    callback dismiss-notice();
    in property <string> heading: "全部任务";
    in property <int> selected-count;
    in-out property <bool> all-selected: false;
    in property <string> sort-column: "queue";
    in property <bool> sort-descending: false;
    in-out property <bool> file-drop-hover: false;
    in property <int> task-count;
    in property <int> visible-count;
    in property <bool> can-start;
    in property <bool> can-pause;
    in property <bool> can-delete;
    in property <bool> can-clear-completed: false;
    out property <bool> compact-sidebar: viewport-width < 1120px;
    out property <length> sidebar-width: compact-sidebar ? 64px : 228px;
    out property <length> content-inset: viewport-width < 900px ? 12px : 16px;
    out property <length> row-height: 64px;
    private property <length> task-scroll-y: 0px;
    in-out property <bool> queues-expanded: true;
    in-out property <bool> categories-expanded: true;
    in-out property <string> query;
    in-out property <bool> tools-open: false;
    in-out property <bool> context-open: false;
    in-out property <length> context-x;
    in-out property <length> context-y;
    private property <length> tools-x;
    private property <length> tools-y;
    in-out property <bool> ctrl-down: false;
    in-out property <bool> shift-down: false;
    in property <bool> media-visible;
    in property <bool> media-detached;
    in property <bool> media-fullscreen;
    in property <MediaView> media-state;
    in property <image> media-thumbnail;
    in property <string> media-notice;
    in-out property <bool> inspector-open: false;
    out property <bool> inspector-docked: root.inspector-open && !(root.media-visible && !root.media-detached) && root.viewport-width >= 900px;
    out property <length> inspector-width: root.inspector-docked ? 316px : 0px;
    callback inspector-opened();
    in property <string> inspector-title;
    in property <string> inspector-kind: "file";
    in property <string> inspector-status;
    in property <string> inspector-status-code;
    in property <string> inspector-transfer;
    in property <string> inspector-connections;
    in property <string> inspector-bt;
    in property <string> inspector-mirrors;
    in property <string> inspector-checksum;
    in property <string> inspector-checksum-tone;
    in property <string> inspector-av;
    in property <string> inspector-av-tone;
    in property <string> inspector-diagnostic;
    in property <string> inspector-logs;
    in property <string> inspector-speed-stats;
    in property <float> inspector-progress;
    in property <[SegmentBlock]> inspector-segments;
    in property <[float]> inspector-speed-history;
    in property <bool> inspector-can-open-folder;
    out property <length> video-x: media.video-x;
    out property <length> video-y: media.video-y;
    out property <length> video-width: media.video-width;
    out property <length> video-height: media.video-height;
    callback media-action(string);
    callback media-seek(float);
    callback media-preview(float);
    callback media-volume(float);
    callback media-audio(int);
    callback media-subtitle(int);
    forward-focus: keyboard;
    callback action(string);
    callback select-row(string, bool, bool);
    callback filter(string);
    callback sort(string);
    callback place-row(string, string);
    callback viewport-resized(float);
    callback query-edited(string);
    callback key-command(string, bool, bool);
    callback request-close;
    callback files-dropped([string]);
    callback response-json(string);

    keyboard := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            root.ctrl-down = event.modifiers.control;
            root.shift-down = event.modifiers.shift;
            if (root.media-fullscreen) {
                if (event.text == Key.Escape) { root.media-action("escape"); return accept; }
                return reject;
            }
            if (event.text == Key.Escape && search.has-focus) {
                if (root.query != "") { root.query = ""; root.query-edited(""); }
                keyboard.focus();
                return accept;
            }
            if (event.modifiers.control && (event.text == "a" || event.text == "A") && !search.has-focus) { root.key-command("select_all", true, false); return accept; }
            if (event.text == Key.Escape) { root.media-action("escape"); root.context-open = false; root.tools-open = false; root.key-command("clear_selection", false, false); return accept; }
            if (event.text == Key.Delete && !search.has-focus) { root.action("delete"); return accept; }
            if (event.text == Key.Return && !search.has-focus) { root.action("details"); return accept; }
            if (event.text == Key.UpArrow && !search.has-focus) { root.key-command("up", event.modifiers.control, event.modifiers.shift); return accept; }
            if (event.text == Key.DownArrow && !search.has-focus) { root.key-command("down", event.modifiers.control, event.modifiers.shift); return accept; }
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) { root.action("new"); return accept; }
            if (event.modifiers.control && (event.text == "v" || event.text == "V") && !search.has-focus) { root.action("paste"); return accept; }
            if (event.modifiers.control && (event.text == "c" || event.text == "C") && !search.has-focus) { root.action("task:copy_file"); return accept; }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) { search.focus(); return accept; }
            if (event.modifiers.control && event.text == ",") { root.action("settings"); return accept; }
            if (event.modifiers.alt && (event.text == "i" || event.text == "I")) {
                root.inspector-open = !root.inspector-open;
                if (root.inspector-open) { root.inspector-opened(); }
                root.viewport-resized(root.viewport-width / 1px);
                return accept;
            }
            if (event.text == " " && !search.has-focus && root.selected-count > 0) { root.key-command("toggle_pause", false, false); return accept; }
            return reject;
        }
        key-released(event) => { root.ctrl-down = event.modifiers.control; root.shift-down = event.modifiers.shift; return reject; }

        VerticalLayout {
            visible: !root.media-fullscreen;
            min-width: 0px;
            spacing: 0px;
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // ── 左侧导航栏（228px 旗舰玻璃感侧栏 + 底部传输遥测卡片）─────
                Rectangle {
                    width: root.sidebar-width;
                    background: Tokens.rail;
                    animate width { duration: Tokens.motion; easing: ease-out; }
                    VerticalLayout {
                        spacing: 0px;
                        // 品牌头 + 引擎在线胶囊
                        Rectangle {
                            height: 60px;
                            accessible-role: text;
                            accessible-label: root.connection;
                            HorizontalLayout {
                                padding-left: root.compact-sidebar ? 0px : 14px;
                                padding-right: root.compact-sidebar ? 0px : 12px;
                                spacing: 10px;
                                alignment: root.compact-sidebar ? center : start;
                                Rectangle {
                                    width: 34px; height: 34px; y: (parent.height - self.height) / 2;
                                    border-radius: 9px;
                                    background: Tokens.accent-soft;
                                    border-width: 1px; border-color: Tokens.accent-border;
                                    Image { source: @image-url("../../assets/app-icon.png"); width: 22px; height: 22px; image-fit: contain; }
                                    if root.compact-sidebar: Rectangle {
                                        x: parent.width - 7px; y: parent.height - 7px;
                                        width: 8px; height: 8px; border-radius: 4px;
                                        background: root.engine-online ? Tokens.done : Tokens.warn;
                                        border-width: 1.5px; border-color: Tokens.rail;
                                    }
                                }
                                if !root.compact-sidebar: VerticalLayout {
                                    alignment: center; spacing: 3px; horizontal-stretch: 1; min-width: 0px;
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        Text { text: "HLS Downloader"; color: Tokens.ink; font-size: 13.5px; font-weight: 700; overflow: elide; }
                                        Text { text: "v" + root.product-version; color: Tokens.faint; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        Rectangle {
                                            height: 18px;
                                            width: core-pill.preferred-width;
                                            border-radius: 9px;
                                            background: root.engine-online ? Tokens.success-surface : Tokens.warn-surface;
                                            border-width: 1px;
                                            border-color: (root.engine-online ? Tokens.done : Tokens.warn).with-alpha(Tokens.dark ? 0.34 : 0.24);
                                            core-pill := HorizontalLayout {
                                                padding-left: 7px; padding-right: 8px; spacing: 5px; alignment: center;
                                                Rectangle {
                                                    width: 5px; height: 5px; y: (parent.height - self.height) / 2;
                                                    border-radius: 2.5px;
                                                    background: root.engine-online ? Tokens.done : Tokens.warn;
                                                }
                                                Text {
                                                    text: root.connection;
                                                    color: root.engine-online ? Tokens.done : Tokens.warn;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.hairline; }
                        }

                        // 导航分组列表
                        VerticalLayout {
                            padding-left: 10px; padding-right: 2px; padding-top: 6px; padding-bottom: 10px; spacing: 8px;
                            vertical-stretch: 1;
                            nav-scroll := HotScrollView {
                                vertical-stretch: 1;
                                horizontal-scrollbar-policy: always-off;
                                viewport-width: self.visible-width;
                                viewport-height: nav-list.preferred-height;
                                nav-list := VerticalLayout {
                                    width: parent.visible-width;
                                    alignment: start;
                                    spacing: 2px; padding-right: 8px;
                                    for entry in root.navigation: VerticalLayout {
                                        spacing: 2px;
                                        if entry.heading != "" && !root.compact-sidebar: HorizontalLayout {
                                            height: entry.group == "status" ? 26px : 32px; spacing: 2px;
                                            padding-left: 10px; padding-top: entry.group == "status" ? 0px : 6px;
                                            Text { text: entry.heading; color: Tokens.faint; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
                                            if entry.group != "status": WorkbenchButton {
                                                label: entry.group == "queues" ? "展开或收起队列" : "展开或收起分类";
                                                y: (parent.height - self.height) / 2;
                                                icon: (entry.group == "queues" ? root.queues-expanded : root.categories-expanded) ? "chevron-up" : "chevron-down";
                                                icon-only: true; subtle: true; width: 24px; height: 24px;
                                                clicked => { if entry.group == "queues" { root.queues-expanded = !root.queues-expanded; } else { root.categories-expanded = !root.categories-expanded; } }
                                            }
                                        }
                                        if entry.heading != "" && root.compact-sidebar && entry.group != "status": Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; width: parent.width - 12px; background: Tokens.line; } }
                                        if root.compact-sidebar || entry.group == "status" || (entry.group == "queues" && root.queues-expanded) || (entry.group == "categories" && root.categories-expanded): NavigationItem {
                                            label: entry.label; icon: entry.icon; count: entry.count; active: entry.active; compact: root.compact-sidebar;
                                            clicked => { root.filter(entry.id); }
                                        }
                                    }
                                }
                            }

                            // ── 底部传输遥测卡片（Transfer Telemetry Card）──────
                            if !root.compact-sidebar: HorizontalLayout {
                                vertical-stretch: 0;
                                padding-right: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 0;
                                    height: telemetry-body.preferred-height;
                                    border-radius: 10px;
                                    background: Tokens.surface;
                                    border-width: 1px;
                                    border-color: Tokens.line;
                                    drop-shadow-offset-y: 1px;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Tokens.shadow;
                                telemetry-body := VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            spacing: 2px; horizontal-stretch: 1; min-width: 0px;
                                            Text { text: "全局速率"; color: Tokens.faint; font-size: 10px; font-weight: 600; }
                                            Text {
                                                text: root.telemetry-speed;
                                                color: root.active-task-count > 0 ? Tokens.accent : Tokens.ink;
                                                font-size: 14.5px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: end;
                                            Text { text: "活跃任务"; color: Tokens.faint; font-size: 10px; font-weight: 600; horizontal-alignment: right; }
                                            Rectangle {
                                                height: 20px;
                                                width: max(36px, act-lbl.preferred-width + 12px);
                                                border-radius: 10px;
                                                background: root.active-task-count > 0 ? Tokens.info-bg : Tokens.surface-2;
                                                border-width: 1px;
                                                border-color: root.active-task-count > 0 ? Tokens.accent-border : Tokens.hairline;
                                                act-lbl := Text {
                                                    text: root.active-task-count + " 项";
                                                    color: root.active-task-count > 0 ? Tokens.info : Tokens.muted;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Tokens.hairline; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        speed-pill := Rectangle {
                                            private property <bool> active: root.speed-limit-enabled && root.speed-limit-kib > 0;
                                            height: 24px;
                                            horizontal-stretch: 1;
                                            border-radius: 12px;
                                            background: self.active
                                                ? (speed-touch.pressed ? Tokens.warn-surface.darker(0.08) : speed-touch.has-hover ? Tokens.warn-surface.darker(0.04) : Tokens.warn-surface)
                                                : (speed-touch.pressed ? Tokens.control-pressed : speed-touch.has-hover ? Tokens.control-hover : Tokens.surface-2);
                                            border-width: 1px;
                                            border-color: self.active ? Tokens.warn.with-alpha(Tokens.dark ? 0.45 : 0.35) : Tokens.line;
                                            animate background, border-color { duration: Tokens.motion-fast; }
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 5px; alignment: center;
                                                Rectangle {
                                                    width: 6px; height: 6px; y: (parent.height - self.height) / 2;
                                                    border-radius: 3px;
                                                    background: speed-pill.active ? Tokens.warn : Tokens.faint;
                                                }
                                                Text {
                                                    text: root.speed-limit-label;
                                                    color: speed-pill.active ? Tokens.warn : Tokens.muted;
                                                    font-size: 10.5px;
                                                    font-weight: speed-pill.active ? 600 : 500;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            Tooltip { text: speed-pill.active ? @markdown("点击关闭全局限速") : @markdown("点击开启全局限速"); }
                                            speed-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                accessible-role: button;
                                                accessible-label: speed-pill.active ? "关闭全局限速" : "开启全局限速";
                                                clicked => { root.action("toggle_speed_limit"); }
                                            }
                                        }
                                        Rectangle {
                                            width: 26px; height: 24px; border-radius: 6px;
                                            background: Tokens.surface-2; border-width: 1px; border-color: Tokens.hairline;
                                            WorkbenchIcon {
                                                name: "extension";
                                                ink: root.browser-status == "浏览器已连接" ? Tokens.done : Tokens.faint;
                                                width: 13px; height: 13px;
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            }
                                            Tooltip { text: @markdown("\{root.browser-status}"); }
                                        }
                                        WorkbenchButton {
                                            label: "管理队列"; hint: "管理下载队列与计划"; icon: "queue"; icon-only: true; outlined: true; width: 26px; height: 24px;
                                            clicked => { root.action("queues"); }
                                        }
                                    }
                                }
                                }
                            }
                            if root.compact-sidebar: VerticalLayout {
                                vertical-stretch: 0;
                                padding-right: 8px; spacing: 6px;
                                WorkbenchButton { label: "管理队列"; hint: "管理下载队列与计划"; icon: "queue"; outlined: true; icon-only: true; clicked => { root.action("queues"); } }
                            }
                        }
                    }
                }
                Rectangle { width: 1px; background: Tokens.line; }

                // ── 右侧工作区：单一 60px 统一命令顶栏 + 悬浮卡片任务表 + 右侧检视抽屉 ──
                VerticalLayout {
                    spacing: 0px;
                    horizontal-stretch: 1;

                    // 统一命令顶栏（60px）—— 彻底移除旧三层堆叠工具栏
                    Rectangle {
                        height: 60px;
                        background: Tokens.surface;
                        HorizontalLayout {
                            padding-left: root.content-inset;
                            padding-right: root.content-inset;
                            spacing: root.viewport-width < 760px ? 4px : root.viewport-width < 1480px ? 6px : 8px;

                            // 视图标题 + 计数胶囊
                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                Text {
                                    text: root.heading;
                                    color: Tokens.ink;
                                    font-weight: 700;
                                    font-size: root.viewport-width < 920px ? 15px : 17px;
                                    vertical-alignment: center;
                                    max-width: root.viewport-width < 760px ? 60px : root.viewport-width < 1080px ? 96px : 136px;
                                    overflow: elide;
                                }
                                if root.viewport-width >= 720px: Rectangle {
                                    width: max(24px, total.preferred-width + 12px);
                                    height: 21px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 10.5px;
                                    background: Tokens.surface-2;
                                    border-width: 1px;
                                    border-color: Tokens.line;
                                    total := Text {
                                        text: root.visible-count;
                                        color: Tokens.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if root.viewport-width >= 720px: Rectangle { width: 1px; height: 20px; y: (parent.height - self.height) / 2; background: Tokens.hairline; }

                            // 核心动作与队列控制条（自适应切换图标/完整文字，绝不横向截断半个字符）
                            HorizontalLayout {
                                height: 60px;
                                spacing: root.viewport-width < 760px ? 4px : 6px;
                                alignment: start;
                                for item in root.toolbar: WorkbenchButton {
                                    y: (parent.height - self.height) / 2;
                                    label: item.action == "start" && root.selected-count > 0 ? "开始"
                                        : item.action == "pause" && root.selected-count > 0 ? "暂停"
                                        : item.label;
                                    icon: item.icon;
                                    primary: item.action == "new";
                                    tonal: item.action == "paste";
                                    subtle: item.action != "new" && item.action != "paste";
                                    icon-only: item.action == "new" ? root.viewport-width < 820px
                                        : item.action == "paste" ? (root.viewport-width < 1180px || (root.selected-count > 0 && root.viewport-width < 1520px))
                                        : root.viewport-width < 1480px;
                                    hint: !self.icon-only ? ""
                                        : item.action == "new" ? "新建下载 (Ctrl+N)"
                                        : item.action == "paste" ? "粘贴链接或种子 (Ctrl+V)"
                                        : item.action == "start" ? (root.selected-count > 0 ? "开始所选任务" : "全部开始")
                                        : item.action == "pause" ? (root.selected-count > 0 ? "暂停所选任务" : "全部暂停")
                                        : "清空已完成任务";
                                    enabled: item.action == "start" ? root.can-start
                                        : item.action == "pause" ? root.can-pause
                                        : item.action == "clear_completed" ? root.can-clear-completed
                                        : true;
                                    clicked => { root.action(item.action); }
                                }
                                if root.selected-count > 0: Rectangle {
                                    width: sel-layout.preferred-width;
                                    height: 30px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 15px;
                                    background: Tokens.selected;
                                    border-width: 1px;
                                    border-color: Tokens.accent-border;
                                    sel-layout := HorizontalLayout {
                                        padding-left: 10px; padding-right: 4px; spacing: 2px;
                                        Text { text: "已选 " + root.selected-count + " 项"; color: Tokens.accent; font-size: 11.5px; font-weight: 600; vertical-alignment: center; }
                                        if root.viewport-width >= 760px: WorkbenchButton { label: "移动到队列"; icon: "queue"; icon-only: true; subtle: true; width: 26px; height: 26px; y: (parent.height - self.height) / 2; clicked => { root.action("queues"); } }
                                        WorkbenchButton { label: "删除所选任务"; icon: "delete"; danger: true; icon-only: true; subtle: true; width: 26px; height: 26px; y: (parent.height - self.height) / 2; enabled: root.can-delete; clicked => { root.action("delete"); } }
                                        WorkbenchButton { label: "取消选择"; icon: "close"; icon-only: true; subtle: true; width: 26px; height: 26px; y: (parent.height - self.height) / 2; clicked => { root.key-command("clear_selection", false, false); } }
                                    }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; min-width: 0px; }

                            // 胶囊搜索框
                            Rectangle {
                                width: root.viewport-width < 760px ? 76px : root.viewport-width < 1080px ? 132px : root.viewport-width < 1480px ? 184px : 224px;
                                height: Tokens.control-height;
                                y: (parent.height - self.height) / 2;
                                background: search.has-focus ? Tokens.surface : Tokens.surface-2;
                                border-width: 1px;
                                border-color: search.has-focus ? Tokens.accent : Tokens.line;
                                border-radius: 17px;
                                animate background, border-color { duration: Tokens.motion-fast; }
                                Rectangle {
                                    x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px;
                                    border-radius: 20px; border-width: 2px;
                                    border-color: search.has-focus ? Tokens.accent-soft : transparent;
                                    animate border-color { duration: Tokens.motion-fast; }
                                }
                                HorizontalLayout {
                                    padding-left: 11px; padding-right: 6px; spacing: 6px;
                                    WorkbenchIcon { name: "search"; ink: search.has-focus ? Tokens.accent : Tokens.faint; width: 15px; height: 15px; y: (parent.height - self.height) / 2; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        if root.query == "": Text {
                                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                                            text: root.viewport-width < 760px ? "搜索" : root.viewport-width < 1080px ? "搜索 (Ctrl+F)" : "搜索任务或链接  Ctrl+F";
                                            color: Tokens.faint; font-size: 12px; vertical-alignment: center; horizontal-alignment: left; overflow: elide;
                                        }
                                        search := TextInput {
                                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                                            text <=> root.query; single-line: true; color: Tokens.ink; font-size: 12.5px; vertical-alignment: center; horizontal-alignment: left;
                                            selection-background-color: Tokens.accent; selection-foreground-color: Tokens.on-accent;
                                            accessible-role: text-input; accessible-label: "搜索任务"; accessible-value: root.query;
                                            edited => { root.query-edited(self.text); }
                                        }
                                    }
                                    if root.query != "": WorkbenchButton {
                                        label: "清除搜索"; icon: "close"; icon-only: true; subtle: true; width: 22px; height: 22px;
                                        y: (parent.height - self.height) / 2;
                                        clicked => { root.query = ""; root.query-edited(""); }
                                    }
                                }
                            }

                            // 轻量次级图标按钮群（带悬停提示；620x480 窄窗下亦保持导入/导出/工具/设置完整可见）
                            WorkbenchButton { label: "导入"; hint: "导入种子或链接列表"; icon: "import"; subtle: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("import"); } }
                            WorkbenchButton { label: "导出"; hint: "导出任务列表"; icon: "export"; subtle: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("export"); } }
                            if root.viewport-width >= 780px: WorkbenchButton { label: "刷新"; hint: "刷新任务快照"; icon: "refresh"; subtle: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("refresh"); } }
                            tools-button := WorkbenchButton {
                                label: "工具"; hint: self.icon-only ? "更多批量、抓取、投屏与系统工具" : ""; icon: "more"; open: root.tools-open; subtle: true;
                                icon-only: root.viewport-width < 1320px;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.context-open = false; root.tools-x = self.absolute-position.x; root.tools-y = self.absolute-position.y + self.height + 4px; root.tools-open = !root.tools-open; }
                            }
                            if root.viewport-width >= 820px: WorkbenchButton {
                                label: root.inspector-open ? "收起检视" : "任务检视";
                                hint: self.icon-only ? "切换右侧实时任务检视抽屉 (Alt+I)" : "";
                                icon: root.inspector-open ? "chevron-right" : "chevron-left";
                                active: root.inspector-open;
                                subtle: !root.inspector-open;
                                icon-only: root.viewport-width < 1480px;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    root.inspector-open = !root.inspector-open;
                                    if (root.inspector-open) { root.inspector-opened(); }
                                    root.viewport-resized(root.viewport-width / 1px);
                                }
                            }
                            if root.viewport-width >= 760px: Rectangle { width: 1px; height: 20px; y: (parent.height - self.height) / 2; background: Tokens.hairline; }
                            WorkbenchButton { label: "设置"; hint: "设置 (Ctrl+,)"; icon: "settings"; subtle: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("settings"); } }
                            if root.viewport-width >= 760px: WorkbenchButton { label: "切换主题"; hint: "切换主题（跟随系统 / 浅色 / 深色）"; icon: Tokens.dark ? "sun" : "theme"; subtle: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("theme"); } }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line; }
                    }

                    // 主内容画布：语义化可关闭提示横幅 + 悬浮任务表格卡片 + 右侧检视抽屉
                    VerticalLayout {
                        padding: root.content-inset;
                        spacing: 10px;
                        vertical-stretch: 1;

                        // 语义化通知条（info / success / warning / error + × 关闭按钮）
                        if root.notice != "": notice-banner := Rectangle {
                            private property <color> banner-fg: root.notice-tone == "error" ? Tokens.fail
                                : root.notice-tone == "warning" ? Tokens.warn
                                : root.notice-tone == "success" ? Tokens.done
                                : Tokens.info;
                            private property <color> banner-bg: root.notice-tone == "error" ? Tokens.fail-surface
                                : root.notice-tone == "warning" ? Tokens.warn-surface
                                : root.notice-tone == "success" ? Tokens.success-surface
                                : Tokens.info-bg;
                            private property <string> banner-icon: root.notice-tone == "error" ? "failed"
                                : root.notice-tone == "warning" ? "notices"
                                : root.notice-tone == "success" ? "completed"
                                : "info";
                            height: 36px;
                            border-radius: 8px;
                            background: self.banner-bg;
                            border-width: 1px;
                            border-color: self.banner-fg.with-alpha(Tokens.dark ? 0.36 : 0.24);
                            clip: true;
                            Rectangle {
                                x: 0px; y: 0px; width: 3px; height: parent.height;
                                background: notice-banner.banner-fg;
                            }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 6px; spacing: 8px;
                                WorkbenchIcon { name: notice-banner.banner-icon; ink: notice-banner.banner-fg; width: 15px; height: 15px; y: (parent.height - self.height) / 2; }
                                Text {
                                    text: root.notice;
                                    color: Tokens.ink;
                                    font-size: 12px;
                                    font-weight: 500;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    Tooltip { text: @markdown("\{root.notice}"); }
                                }
                                HotCloseButton {
                                    width: 24px; height: 24px;
                                    y: (parent.height - self.height) / 2;
                                    accessible-name: "关闭提示";
                                    clicked => { root.dismiss-notice(); }
                                }
                            }
                        }

                        // 任务卡片 + 右侧检视抽屉并排容器
                        HorizontalLayout {
                            spacing: root.inspector-docked ? 12px : 0px;
                            vertical-stretch: 1;

                            // ── 悬浮圆角任务单卡片（Elevated Task Sheet Card）──────
                            Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                background: Tokens.surface;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Tokens.line;
                                drop-shadow-offset-y: 2px;
                                drop-shadow-blur: 8px;
                                drop-shadow-color: Tokens.shadow;

                                Rectangle {
                                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                                    border-radius: 9px;
                                    clip: true;

                                    table-scroll := HotScrollView {
                                        width: parent.width; height: parent.height;
                                        vertical-scrollbar-policy: always-off;
                                        horizontal-scrollbar-policy: always-off;
                                        viewport-width: self.width;
                                        viewport-height: self.height;
                                        VerticalLayout {
                                            width: table-scroll.viewport-width; height: table-scroll.viewport-height; spacing: 0px;

                                            // 轻量 34px 表头栏
                                            Rectangle {
                                                height: 34px;
                                                background: Tokens.surface-2;
                                                border-top-left-radius: 9px;
                                                border-top-right-radius: 9px;
                                                HorizontalLayout {
                                                    spacing: 0px;
                                                    for column in root.columns: HeaderCell {
                                                        label: column.label;
                                                        label-x: column.id == "name" ? 96px : column.id == "actions" ? 10px : root.compact-columns ? 10px : 16px;
                                                        hit-x: column.id == "name" ? 44px : 0px;
                                                        sortable: column.id != "actions";
                                                        sort-direction: column.id != "actions" && root.sort-column == column.id ? (root.sort-descending ? "desc" : "asc") : "";
                                                        width: column.width * 1px;
                                                        horizontal-stretch: 0;
                                                        clicked => { if column.id != "actions" { root.sort(column.id); } }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                if root.sort-column != "" && root.sort-column != "queue" && root.columns.length > 0 && root.viewport-width >= 680px: WorkbenchButton {
                                                    private property <bool> compact-reset: root.columns[0].width < 280;
                                                    x: 146px;
                                                    y: (parent.height - self.height) / 2;
                                                    width: self.compact-reset ? 24px : self.min-width;
                                                    height: 22px;
                                                    icon-only: self.compact-reset;
                                                    label: "恢复队列排序";
                                                    hint: "恢复按任务队列顺序排列（支持拖拽排序）";
                                                    icon: "queue";
                                                    tonal: true;
                                                    clicked => { root.action("队列顺序"); }
                                                }
                                                if root.columns.length > 0: HotCheckBox {
                                                    x: 14px;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 20px;
                                                    checked <=> root.all-selected;
                                                    enabled: root.tasks.length > 0;
                                                    accessible-label: "全选当前列表";
                                                    toggled => {
                                                        if root.all-selected {
                                                            root.key-command("select_all", true, false);
                                                        } else {
                                                            root.key-command("clear_selection", false, false);
                                                        }
                                                    }
                                                }
                                                Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.hairline; }
                                            }

                                            // 虚拟化任务行列表（64px 行高）
                                            if root.tasks.length > 0: task-list := ListView {
                                                changed viewport-y => { root.task-scroll-y = self.viewport-y; }
                                                for row[index] in root.tasks: Rectangle {
                                                    height: root.row-height;
                                                    if index < root.tasks.length - 1: Rectangle {
                                                        height: 1px; x: 16px; y: parent.height - 1px; width: parent.width - 32px;
                                                        background: Tokens.hairline;
                                                    }
                                                    Rectangle {
                                                        x: 6px; y: 3px;
                                                        width: parent.width - 12px - (task-list.viewport-height > task-list.visible-height ? 8px : 0px);
                                                        height: parent.height - 6px;
                                                        border-radius: 8px;
                                                        background: row.selected ? Tokens.selected : row-touch.pressed ? Tokens.surface-3 : row-touch.has-hover ? Tokens.surface-2 : transparent;
                                                        border-width: row.selected ? 1px : 0px;
                                                        border-color: Tokens.accent-border;
                                                        animate background, border-color { duration: Tokens.motion-fast; }
                                                    }
                                                    if row.selected: Rectangle {
                                                        x: 6px; y: 14px; width: 3px; height: parent.height - 28px; border-radius: 1.5px;
                                                        background: Tokens.accent;
                                                    }
                                                    row-touch := TouchArea {
                                                        accessible-role: list-item; accessible-label: row.name + " " + row.status;
                                                        pointer-event(event) => {
                                                            if event.kind == PointerEventKind.down {
                                                                keyboard.focus();
                                                                if event.button != PointerEventButton.right || !row.selected { root.select-row(row.id, event.modifiers.control, event.modifiers.shift); }
                                                                if event.button == PointerEventButton.right {
                                                                    root.context-x = self.absolute-position.x + self.mouse-x;
                                                                    root.context-y = self.absolute-position.y + self.mouse-y;
                                                                    root.context-open = true;
                                                                }
                                                            }
                                                        }
                                                        double-clicked => { root.action("details"); }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 0px;
                                                        for column in root.columns: Rectangle {
                                                            width: column.width * 1px; horizontal-stretch: 0;

                                                            if column.id == "name": HorizontalLayout {
                                                                padding-left: 14px; padding-right: 12px; spacing: 12px;
                                                                HotCheckBox { checked <=> row.selected; width: 20px; accessible-label: "选择 " + row.name; toggled => { root.select-row(row.id, true, false); } }
                                                                FileTile { kind: row.kind; y: (parent.height - self.height) / 2; }
                                                                VerticalLayout {
                                                                    alignment: center; spacing: 4px; horizontal-stretch: 1; min-width: 0px;
                                                                    Text {
                                                                        text: row.name;
                                                                        color: Tokens.ink;
                                                                        overflow: elide;
                                                                        font-size: 13.5px;
                                                                        font-weight: 700;
                                                                    }
                                                                    HorizontalLayout {
                                                                        spacing: 6px;
                                                                        alignment: start;
                                                                        if row.protocol != "": Rectangle {
                                                                            height: 16px;
                                                                            width: proto-lbl.preferred-width + 10px;
                                                                            y: (parent.height - self.height) / 2;
                                                                            border-radius: 4px;
                                                                            background: row.protocol == "BT" ? Tokens.torrent-bg : Tokens.info-bg;
                                                                            border-width: 1px;
                                                                            border-color: row.protocol == "BT" ? Tokens.torrent-border : Tokens.accent-border;
                                                                            proto-lbl := Text {
                                                                                text: row.protocol;
                                                                                color: row.protocol == "BT" ? Tokens.torrent-ink : Tokens.info;
                                                                                font-size: 9.5px;
                                                                                font-weight: 700;
                                                                                horizontal-alignment: center;
                                                                                vertical-alignment: center;
                                                                            }
                                                                        }
                                                                        Text {
                                                                            text: row.metadata;
                                                                            color: Tokens.faint;
                                                                            overflow: elide;
                                                                            font-size: 11px;
                                                                            vertical-alignment: center;
                                                                            horizontal-stretch: 1;
                                                                            min-width: 0px;
                                                                        }
                                                                    }
                                                                }
                                                            }

                                                            if column.id == "size" || column.id == "speed": Text {
                                                                x: root.compact-columns ? 10px : 16px;
                                                                width: parent.width - self.x - 4px;
                                                                text: column.id == "size" ? row.size : row.speed;
                                                                color: column.id == "speed" && row.speed != "—" ? Tokens.ink : Tokens.muted;
                                                                vertical-alignment: center;
                                                                font-size: 12px;
                                                                font-weight: column.id == "speed" && row.speed != "—" ? 600 : 400;
                                                                overflow: elide;
                                                            }

                                                            if column.id == "progress": HorizontalLayout {
                                                                private property <bool> is-processing: row.status-code == "merging" || row.status-code == "checking" || row.status-code == "processing" || row.status-code == "remuxing" || row.status-code == "finalizing";
                                                                padding-left: root.compact-columns ? 10px : 16px;
                                                                padding-right: root.compact-columns ? 8px : 14px;
                                                                spacing: root.compact-columns ? 6px : 10px;
                                                                Rectangle {
                                                                    height: 6px; y: (parent.height - self.height) / 2; border-radius: 3px; background: Tokens.surface-3; horizontal-stretch: 1;
                                                                    Rectangle {
                                                                        x: 0px; height: parent.height;
                                                                        width: row.progress <= 0 ? 0px : max(parent.height * 2, parent.width * Math.clamp(row.progress, 0, 1));
                                                                        background: row.status-code == "paused" || is-processing ? Tokens.warn : row.status-code == "failed" || row.status-code == "canceled" ? Tokens.fail : row.status-code == "completed" || row.status-code == "done" ? Tokens.done : Tokens.accent;
                                                                        border-radius: 3px;
                                                                        animate width { duration: Tokens.motion; easing: ease-out; }
                                                                        animate background { duration: Tokens.motion-fast; }
                                                                    }
                                                                }
                                                                Text {
                                                                    text: row.status-code == "merging" || row.status-code == "remuxing" ? "合并中" : row.status-code == "checking" ? "校验中" : row.status-code == "processing" || row.status-code == "finalizing" ? "处理中" : round(row.progress * 100) + "%";
                                                                    width: root.compact-columns ? 38px : 44px;
                                                                    color: row.status-code == "failed" || row.status-code == "canceled" ? Tokens.fail : is-processing ? Tokens.warn : row.status-code == "completed" || row.status-code == "done" ? Tokens.done : Tokens.muted;
                                                                    font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right;
                                                                }
                                                            }

                                                            if column.id == "status": VerticalLayout {
                                                                alignment: center;
                                                                padding-left: root.compact-columns ? 10px : 16px;
                                                                padding-right: 6px;
                                                                spacing: 3px;
                                                                StatusBadge {
                                                                    label: row.status;
                                                                    status-code: row.status-code;
                                                                    show-dot: column.width >= 100;
                                                                }
                                                                if row.eta != "": Text { text: row.eta; color: Tokens.faint; font-size: 10px; overflow: elide; }
                                                            }

                                                            if column.id == "actions": HorizontalLayout {
                                                                spacing: 3px; padding-left: 4px;
                                                                if row.primary-action != "": WorkbenchButton {
                                                                    label: row.primary-label + "：" + row.name;
                                                                    icon: row.primary-action == "pause" ? "pause" : row.primary-action == "retry" ? "retry" : row.primary-action == "open" ? "file" : row.primary-action == "open_folder" ? "folder" : "play";
                                                                    subtle: true; icon-only: true; width: 30px; height: 30px; y: (parent.height - self.height) / 2;
                                                                    clicked => { root.select-row(row.id, false, false); root.action("task:" + row.primary-action); }
                                                                }
                                                                WorkbenchButton {
                                                                    label: "更多操作：" + row.name; icon: "more"; subtle: true; icon-only: true; width: 30px; height: 30px; y: (parent.height - self.height) / 2;
                                                                    clicked => { if !row.selected { root.select-row(row.id, false, false); } root.context-x = self.absolute-position.x; root.context-y = self.absolute-position.y + self.height; root.context-open = true; }
                                                                }
                                                                Rectangle {
                                                                    width: 22px; height: 30px;
                                                                    y: (parent.height - self.height) / 2;
                                                                    border-radius: 6px;
                                                                    background: drag.pressed ? Tokens.control-pressed : drag.has-hover ? Tokens.control-hover : transparent;
                                                                    opacity: row-touch.has-hover || drag.has-hover || drag.pressed ? 1 : 0.24;
                                                                    animate background, opacity { duration: Tokens.motion-fast; }
                                                                    WorkbenchIcon { name: "drag"; ink: drag.pressed ? Tokens.accent : drag.has-hover ? Tokens.ink : Tokens.muted; width: 14px; height: 14px; x: 4px; y: 8px; }
                                                                    Tooltip { text: @markdown("按队列顺序拖动排序"); }
                                                                    drag := TouchArea {
                                                                        mouse-cursor: grab; accessible-role: button; accessible-label: "调整任务队列顺序";
                                                                        pointer-event(event) => {
                                                                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                                                                if abs(self.mouse-y - self.pressed-y) >= root.row-height * 0.4 {
                                                                                    root.place-row(row.id, root.tasks[max(0, min(root.tasks.length - 1, index + round((self.mouse-y - self.pressed-y) / root.row-height)))].id);
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                }
                                            }

                                            // ── 现代化空状态卡片 ─────────────────────────────
                                            if root.tasks.length == 0: Rectangle {
                                                background: Tokens.surface; vertical-stretch: 1;
                                                VerticalLayout {
                                                    alignment: center; spacing: 12px; padding: 24px;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 88px; height: 88px; border-radius: 24px;
                                                            background: Tokens.info-bg;
                                                            border-width: 1px; border-color: Tokens.accent-border;
                                                            Rectangle {
                                                                width: 58px; height: 58px; border-radius: 16px;
                                                                background: Tokens.surface;
                                                                border-width: 1px; border-color: Tokens.line;
                                                                drop-shadow-offset-y: 4px; drop-shadow-blur: 14px;
                                                                drop-shadow-color: Tokens.accent.with-alpha(0.20);
                                                                WorkbenchIcon {
                                                                    name: root.task-count > 0 ? "search" : "running";
                                                                    ink: Tokens.accent;
                                                                    width: 28px; height: 28px;
                                                                    x: (parent.width - self.width) / 2;
                                                                    y: (parent.height - self.height) / 2;
                                                                }
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: root.task-count > 0 ? "当前筛选下没有匹配任务" : "开始你的第一个下载";
                                                        color: Tokens.ink; font-size: 19px; font-weight: 700; horizontal-alignment: center;
                                                    }
                                                    Text {
                                                        text: root.task-count > 0 ? "试试调整搜索关键词、任务状态或左侧队列分类筛选" : "拖入链接、磁力或种子，或在浏览器一键嗅探流媒体";
                                                        color: Tokens.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap;
                                                    }
                                                    Rectangle { height: 2px; }
                                                    if root.task-count > 0: HorizontalLayout {
                                                        alignment: center;
                                                        WorkbenchButton {
                                                            label: "重置筛选"; icon: "refresh"; outlined: true;
                                                            clicked => { root.query = ""; root.query-edited(""); root.filter("all"); }
                                                        }
                                                    }
                                                    if root.task-count == 0: HorizontalLayout {
                                                        alignment: center; spacing: 10px;
                                                        WorkbenchButton { label: "新建下载"; icon: "new"; primary: true; clicked => { root.action("new"); } }
                                                        WorkbenchButton { label: "粘贴剪贴板链接"; icon: "paste"; tonal: true; outlined: true; clicked => { root.action("paste"); } }
                                                    }
                                                    if root.task-count == 0: HorizontalLayout {
                                                        alignment: center; spacing: 6px; padding-top: 4px;
                                                        for hint in ["HLS / DASH 流媒体", "HTTP / FTP / SFTP", "BT / 磁力种子", "边下边播"]: Rectangle {
                                                            height: 22px; width: hint-lbl.preferred-width + 14px; border-radius: 11px;
                                                            background: Tokens.surface-2; border-width: 1px; border-color: Tokens.hairline;
                                                            hint-lbl := Text { text: hint; color: Tokens.faint; font-size: 10.5px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    ScrollCue {
                                        x: parent.width - self.width; y: 34px; height: parent.height - 34px;
                                        viewport-y: root.task-scroll-y; viewport-height: root.tasks.length * root.row-height; visible-height: parent.height - 34px;
                                    }
                                }
                            }

                            // ── 右侧任务检视抽屉（TaskInspector）────────────────────
                            if root.inspector-docked: TaskInspector {
                                width: root.inspector-width;
                                vertical-stretch: 1;
                                title-text: root.inspector-title;
                                kind: root.inspector-kind;
                                status: root.inspector-status;
                                status-code: root.inspector-status-code;
                                transfer: root.inspector-transfer;
                                speed-stats: root.inspector-speed-stats;
                                connections: root.inspector-connections;
                                bt: root.inspector-bt;
                                mirrors: root.inspector-mirrors;
                                checksum: root.inspector-checksum;
                                checksum-tone: root.inspector-checksum-tone;
                                av: root.inspector-av;
                                av-tone: root.inspector-av-tone;
                                diagnostic: root.inspector-diagnostic;
                                logs: root.inspector-logs;
                                progress: root.inspector-progress;
                                segments: root.inspector-segments;
                                speed-history: root.inspector-speed-history;
                                can-open-folder: root.inspector-can-open-folder;
                                open-folder => { root.action("task:open_folder"); }
                                open-details => { root.action("details"); }
                                collapse => {
                                    root.inspector-open = false;
                                    root.viewport-resized(root.viewport-width / 1px);
                                }
                            }
                        }
                    }
                }
            }

            dock := Rectangle {
                height: root.media-visible && !root.media-detached ? min(390px, root.viewport-height * 0.48) : 0px;
                animate height { duration: Tokens.motion-slow; easing: ease-out; }
            }
        }

        // 窄窗口（< 900px）时，任务检视抽屉以右侧浮层方式展开，不挤压主表最小列宽
        if !root.media-fullscreen && root.inspector-open && !root.inspector-docked && !(root.media-visible && !root.media-detached): TaskInspector {
            x: max(0px, parent.width - self.width - 12px);
            y: 68px;
            width: min(316px, parent.width - 24px);
            height: max(180px, parent.height - 80px);
            title-text: root.inspector-title;
            kind: root.inspector-kind;
            status: root.inspector-status;
            status-code: root.inspector-status-code;
            transfer: root.inspector-transfer;
            speed-stats: root.inspector-speed-stats;
            connections: root.inspector-connections;
            bt: root.inspector-bt;
            mirrors: root.inspector-mirrors;
            checksum: root.inspector-checksum;
            checksum-tone: root.inspector-checksum-tone;
            av: root.inspector-av;
            av-tone: root.inspector-av-tone;
            diagnostic: root.inspector-diagnostic;
            logs: root.inspector-logs;
            progress: root.inspector-progress;
            segments: root.inspector-segments;
            speed-history: root.inspector-speed-history;
            can-open-folder: root.inspector-can-open-folder;
            open-folder => { root.action("task:open_folder"); }
            open-details => { root.action("details"); }
            collapse => { root.inspector-open = false; }
        }

        // Fullscreen changes the overlay, not the workbench's native size constraints.
        media := MediaSurface {
            visible: root.media-visible && !root.media-detached;
            opacity: self.visible ? 1 : 0;
            animate opacity { duration: Tokens.motion; easing: ease-out; }
            x: 0px; y: root.media-fullscreen ? 0px : dock.y;
            width: parent.width; height: root.media-fullscreen ? parent.height : dock.height;
            state: root.media-state; fullscreen: root.media-fullscreen; detached: false;
            thumbnail: root.media-thumbnail; notice: root.media-notice;
            action(value) => { root.media-action(value); } seek(value) => { root.media-seek(value); } preview(value) => { root.media-preview(value); }
            volume(value) => { root.media-volume(value); } audio(value) => { root.media-audio(value); } subtitle(value) => { root.media-subtitle(value); }
        }

        drop-overlay := Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: parent.height;
            opacity: root.file-drop-hover ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Tokens.motion; easing: ease-out; }
            background: Tokens.dark ? #0c1017d9 : #f4f7fbd9;
            Rectangle {
                x: 24px; y: 24px;
                width: parent.width - 48px; height: parent.height - 48px;
                border-radius: Tokens.panel-radius + 4px;
                background: Tokens.info-bg;
                border-width: 2px;
                border-color: Tokens.accent;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 64px; height: 64px;
                            border-radius: 16px;
                            background: Tokens.surface;
                            border-width: 1px;
                            border-color: Tokens.accent-border;
                            drop-shadow-offset-y: 4px;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: Tokens.accent.with-alpha(0.24);
                            WorkbenchIcon { name: "import"; ink: Tokens.accent; width: 28px; height: 28px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        }
                    }
                    Text {
                        text: "松开鼠标即可导入种子、链接文件或批量任务";
                        color: Tokens.ink;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "支持 .torrent、.magnet、.txt、.json、.url、.metalink、.m3u8 等文件";
                        color: Tokens.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if !root.media-fullscreen && (root.tools-open || root.context-open): TouchArea { clicked => { root.tools-open = false; root.context-open = false; } }
        menu := Rectangle {
            private property <bool> context: false;
            in property <bool> context-open: root.context-open;
            in property <bool> tools-open: root.tools-open;
            changed context-open => { if self.context-open { self.context = true; } }
            changed tools-open => { if self.tools-open { self.context = false; } }
            private property <length> base-y: min(max(0px, self.context ? root.context-y : root.tools-y), root.height - self.height);
            width: 228px; height: min(menu-layout.preferred-height, root.height - 12px);
            x: min(max(0px, self.context ? root.context-x : root.tools-x), root.width - self.width);
            y: self.base-y + ((root.tools-open || root.context-open) ? 0px : -6px);
            background: Tokens.dialog; border-width: 1px; border-color: Tokens.line; border-radius: 10px;
            drop-shadow-offset-y: 8px; drop-shadow-blur: 24px; drop-shadow-color: Tokens.dark ? #00000070 : #0f172a24;
            opacity: root.tools-open || root.context-open ? 1 : 0;
            visible: !root.media-fullscreen && self.opacity > 0;
            animate opacity, y { duration: Tokens.motion-fast; easing: ease-out; }
            HotScrollView {
                menu-layout := VerticalLayout {
                    padding: 6px; spacing: 1px;
                    if menu.context: VerticalLayout {
                        spacing: 1px;
                        for item[index] in root.task-menu: VerticalLayout {
                            spacing: 1px;
                            if item.divider && index > 0: Rectangle { height: 9px; Rectangle { x: 8px; y: 4px; height: 1px; width: parent.width - 16px; background: Tokens.line; } }
                            WorkbenchButton {
                                label: item.label; icon: item.icon; enabled: root.context-open && item.enabled; menu-item: true;
                                danger: item.action == "delete" || item.action == "delete_files";
                                clicked => { root.context-open = false; root.action(item.action); }
                            }
                        }
                    }
                    if !menu.context: VerticalLayout {
                        spacing: 1px;
                        Text { text: "  批量与资源"; color: Tokens.faint; font-size: 10.5px; font-weight: 600; height: 22px; vertical-alignment: center; }
                        for item in ["批量添加", "导入 cURL", "页面抓取", "抓站与同步项目", "ZIP 内容预览"]: WorkbenchButton {
                            label: item;
                            menu-item: true;
                            enabled: root.tools-open;
                            icon: item == "批量添加" ? "batch" : item == "导入 cURL" ? "import" : item == "页面抓取" ? "harvest" : item == "抓站与同步项目" ? "network" : "archive";
                            clicked => { root.tools-open = false; root.action(item); }
                        }
                        Rectangle { height: 9px; Rectangle { x: 8px; y: 4px; height: 1px; width: parent.width - 16px; background: Tokens.line; } }
                        Text { text: "  媒体与推送"; color: Tokens.faint; font-size: 10.5px; font-weight: 600; height: 22px; vertical-alignment: center; }
                        for item in ["投屏到电视", "TVBox 推送"]: WorkbenchButton {
                            label: item;
                            menu-item: true;
                            enabled: root.tools-open;
                            icon: item == "投屏到电视" ? "cast" : "tvbox";
                            clicked => { root.tools-open = false; root.action(item); }
                        }
                        Rectangle { height: 9px; Rectangle { x: 8px; y: 4px; height: 1px; width: parent.width - 16px; background: Tokens.line; } }
                        Text { text: "  队列与系统"; color: Tokens.faint; font-size: 10.5px; font-weight: 600; height: 22px; vertical-alignment: center; }
                        for item in ["队列顺序", "浏览器插件", "通知", "检查更新", "关于"]: WorkbenchButton {
                            label: item;
                            menu-item: true;
                            enabled: root.tools-open;
                            icon: item == "队列顺序" ? "queue" : item == "浏览器插件" ? "extension" : item == "检查更新" ? "refresh" : item == "通知" ? "notices" : "info";
                            clicked => { root.tools-open = false; root.action(item); }
                        }
                        if root.power-action-pending: Rectangle { height: 9px; Rectangle { x: 8px; y: 4px; height: 1px; width: parent.width - 16px; background: Tokens.line; } }
                        if root.power-action-pending: WorkbenchButton {
                            label: "取消完成动作";
                            icon: "close";
                            danger: true;
                            menu-item: true;
                            enabled: root.tools-open;
                            clicked => { root.tools-open = false; root.action("取消完成动作"); }
                        }
                    }
                }
            }
        }
    }
}
