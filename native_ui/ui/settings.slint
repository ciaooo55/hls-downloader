import { ScrollView, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";
import { Tokens, HotButton } from "theme.slint";
import { DialogHeader, DialogFooter } from "dialog_components.slint";
import { NavigationItem } from "workbench_components.slint";
import { SiteRulesEditor, SiteRuleRow } from "site_rules.slint";
export { SiteRuleRow } from "site_rules.slint";

export struct SettingField { key: string, label: string, value: string, checked: bool, kind: string, choices: [string] }

export component SettingsWindow inherits Window {
    icon: @image-url("../../assets/app-icon.png");
    title: "设置"; default-font-family: Tokens.type-face; default-font-size: 13px;
    background: Tokens.canvas;
    preferred-width: 880px; preferred-height: 700px; min-width: 640px; min-height: 360px;
    in property <[string]> groups;
    in property <[SettingField]> fields;
    in-out property <string> selected-group: "通用";
    changed selected-group => { content.viewport-y = 0px; }
    in property <string> status;
    in property <bool> busy: false;
    in property <[SiteRuleRow]> site-rules;
    callback group-selected(string);
    callback edited(string, string);
    callback action(string);
    callback site-rule-edited(int, string, string);
    callback site-rule-action(int, string);
    VerticalLayout {
        spacing: 0px;
        DialogHeader { heading: "设置"; description: "下载、网络与界面偏好"; icon: "settings"; }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
            width: 156px; background: Tokens.rail;
            ScrollView {
                width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    padding: 12px; spacing: 4px;
                    for group in root.groups: NavigationItem {
                        label: group; active: root.selected-group == group; show-count: false; enabled: !root.busy;
                        icon: group == "通用" ? "settings" : group == "下载" ? "running" : group == "计划" ? "queued" : group == "网络" ? "network" : group == "媒体" ? "media" : group == "字幕翻译" ? "subtitle" : group == "BT" ? "torrent" : group == "投屏与推送" ? "tvbox" : group == "浏览器" ? "extension" : group == "外观" ? "theme" : "security";
                        clicked => { root.selected-group = group; root.group-selected(group); }
                    }
                }
            }
            }
            Rectangle { width: 1px; background: Tokens.line; }
            VerticalLayout {
            padding: 20px; spacing: 16px;
            Text { text: root.selected-group; color: Tokens.ink; font-size: 17px; font-weight: 600; }
            Rectangle {
                background: Tokens.surface;
                border-radius: Tokens.panel-radius;
                border-width: 1px; border-color: Tokens.line;
            content := ScrollView {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                horizontal-scrollbar-policy: always-off;
                viewport-width: self.width;
                enabled: !root.busy;
                VerticalLayout {
                    padding: 16px; spacing: 16px; alignment: start;
                    for field in root.fields: VerticalLayout {
                        spacing: 8px;
                        if field.kind != "bool": Text { text: field.label; color: Tokens.muted; font-size: 12px; wrap: word-wrap; }
                        if field.kind == "bool": CheckBox { text: field.label; checked <=> field.checked; toggled => { root.edited(field.key, self.checked ? "true" : "false"); } }
                        if field.kind == "choice": ComboBox { model: field.choices; current-value <=> field.value; height: Tokens.control-height; selected(value) => { root.edited(field.key, value); } }
                        if field.kind == "text" || field.kind == "number" || field.kind == "directory": HorizontalLayout {
                            spacing: Tokens.control-gap;
                            LineEdit { text <=> field.value; height: Tokens.control-height; accessible-label: field.label; edited(value) => { root.edited(field.key, value); } }
                            if field.kind == "directory": HotButton { label: "浏览…"; icon: "folder"; clicked => { root.action("folder:" + field.key); } }
                        }
                    }
                    if root.selected-group == "网络": SiteRulesEditor {
                        rows: root.site-rules; enabled: !root.busy;
                        edited(index, key, value) => { root.site-rule-edited(index, key, value); }
                        action(index, action) => { root.site-rule-action(index, action); }
                    }
                    if root.selected-group == "网络": HotButton { label: "管理默认 Cookie"; icon: "security"; clicked => { root.action("default_cookie"); } }
                    if root.selected-group == "字幕翻译": HotButton { label: "读取字幕服务配置"; icon: "subtitle"; clicked => { root.action("subtitle"); } }
                    if root.selected-group == "安全": HotButton { label: "检查更新"; icon: "refresh"; clicked => { root.action("update"); } }
                    if root.selected-group == "浏览器": HotButton { label: "浏览器扩展管理"; icon: "extension"; clicked => { root.action("extension"); } }
                }
            }
            }
            }
        }
        DialogFooter {
            status: root.status;
            HotButton { label: "取消"; clicked => { root.action("close"); } }
            HotButton { label: root.busy ? "保存中…" : "保存设置"; icon: "save"; primary: true; enabled: !root.busy; clicked => { root.action("save"); } }
        }
    }
}
