import { Tokens, HotButton, HotComboBox, WorkbenchIcon } from "theme.slint";
import { WorkbenchButton } from "workbench_components.slint";

export struct MediaView {
    title: string, paused: bool, speed: float, position: float, duration: float,
    time: string, volume: float, muted: bool, buffering: bool,
    audio: [string], subtitles: [string], audio-index: int, subtitle-index: int,
    translating: bool, caption: string, translation-notice: string,
}

export component MediaSeek inherits FocusScope {
    in property <float> value;
    in property <float> maximum;
    in property <string> label: "播放进度";
    in property <float> step: 5;
    private property <float> target: max(0, min(root.maximum, pointer.mouse-x / max(1px, root.width) * root.maximum));
    private property <float> preview-position: pointer.has-hover && root.enabled ? root.target : -1;
    callback seek(float);
    callback preview(float);
    height: 22px; horizontal-stretch: 1;
    accessible-role: slider; accessible-label: root.label;
    accessible-enabled: root.enabled; accessible-value: root.value;
    accessible-value-minimum: 0; accessible-value-maximum: root.maximum; accessible-value-step: root.step;
    accessible-action-set-value(v) => { if root.enabled && v.is-float() { root.seek(max(0,min(root.maximum,v.to-float()))); } }
    accessible-action-increment => { if root.enabled { root.seek(min(root.maximum,root.value+root.step)); } }
    accessible-action-decrement => { if root.enabled { root.seek(max(0,root.value - root.step)); } }
    changed preview-position => { root.preview(root.preview-position); }
    key-pressed(event) => {
        if !root.enabled { return reject; }
        if event.text == Key.RightArrow { root.seek(min(root.maximum,root.value+root.step)); return accept; }
        if event.text == Key.LeftArrow { root.seek(max(0,root.value - root.step)); return accept; }
        if event.text == Key.Home { root.seek(0); return accept; }
        if event.text == Key.End { root.seek(root.maximum); return accept; }
        return reject;
    }
    // 轨道、已播放段都从左缘开始（x: 0），否则 Slint 会把未指定 x 的子元素水平居中。
    private property <length> track-h: root.enabled && (pointer.has-hover || pointer.pressed) ? 6px : 4px;
    Rectangle {
        x: 0px; y: (parent.height - root.track-h) / 2; height: root.track-h; width: parent.width;
        background: root.enabled && (pointer.has-hover || pointer.pressed) ? Tokens.accent-soft : Tokens.surface-3;
        border-radius: root.track-h / 2;
        animate height, background { duration: Tokens.motion-fast; easing: ease-out; }
    }
    Rectangle {
        x: 0px; y: (parent.height - root.track-h) / 2; height: root.track-h;
        width: parent.width * max(0, min(1, root.value / max(1, root.maximum)));
        background: root.enabled ? Tokens.accent : Tokens.faint;
        border-radius: root.track-h / 2;
        animate height { duration: Tokens.motion-fast; easing: ease-out; }
    }
    Rectangle {
        x: max(0px, min(parent.width - self.width, parent.width * root.value / max(1, root.maximum) - self.width / 2));
        y: (parent.height - self.height) / 2;
        width: root.enabled && pointer.pressed ? 16px : root.enabled && pointer.has-hover ? 15px : 12px; height: self.width; border-radius: self.width / 2;
        background: root.enabled && pointer.pressed ? Tokens.selected : Tokens.surface;
        border-width: root.has-focus ? 3.5px : 2.5px;
        border-color: !root.enabled ? Tokens.faint : pointer.pressed ? Tokens.accent-pressed : pointer.has-hover ? Tokens.accent-hover : Tokens.accent;
        animate width, height { duration: Tokens.motion-fast; easing: ease-out; }
        animate background, border-color { duration: Tokens.motion-fast; }
        drop-shadow-blur: 4px; drop-shadow-offset-y: 1px; drop-shadow-color: Tokens.shadow;
    }
    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.focus(); root.seek(root.target); }
        moved => { if self.pressed { root.seek(root.target); } }
    }
}

export component MediaSurface inherits Rectangle {
    background: Tokens.cinema-bar;
    in property <MediaView> state;
    in property <bool> detached;
    in property <bool> fullscreen;
    in property <image> thumbnail;
    in property <string> notice;
    out property <length> video-x: video.absolute-position.x;
    out property <length> video-y: video.absolute-position.y;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;
    callback action(string);
    callback seek(float);
    callback preview(float);
    callback volume(float);
    callback audio(int);
    callback subtitle(int);
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 46px;
            background: Tokens.cinema-bar;
            HorizontalLayout {
                width: parent.width; height: parent.height; padding: 6px; padding-left: 14px; padding-right: 12px; spacing: Tokens.control-gap;
                Rectangle {
                    width: 26px; height: 26px; y: (parent.height - self.height) / 2;
                    border-radius: 6px; background: Tokens.selected; border-width: 1px; border-color: Tokens.accent-border;
                    WorkbenchIcon { name: "media"; ink: Tokens.accent; width: 14px; height: 14px; x: 6px; y: 6px; }
                }
                Text { text: root.state.title; color: Tokens.ink; font-size: 13px; font-weight: 600; overflow: elide; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; }
                if root.state.buffering: Rectangle {
                    height: 22px; width: buf-chip.preferred-width + 16px; y: (parent.height - self.height) / 2;
                    border-radius: 11px; background: Tokens.info-surface; border-width: 1px; border-color: Tokens.accent-border;
                    buf-chip := Text { text: "缓冲中"; color: Tokens.accent; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
                WorkbenchButton { label: root.detached ? "回到主窗" : "画中画"; icon: root.detached ? "dock" : "pip"; outlined: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action(root.detached ? "dock" : "pip"); } }
                WorkbenchButton { label: root.fullscreen ? "退出全屏" : "全屏"; icon: root.fullscreen ? "restore" : "fullscreen"; outlined: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("fullscreen"); } }
                WorkbenchButton { label: "停止"; icon: "stop"; outlined: true; danger: true; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("stop"); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line; }
        }
        // Native video occupies this rectangle only. All controls are outside
        // it, so the child HWND cannot cover a menu, track picker or preview.
        video := Rectangle {
            background: Tokens.cinema-bg; min-height: 40px; vertical-stretch: 1;
            if root.state.buffering: Rectangle {
                width: buf-pill.preferred-width + 24px; height: 30px;
                border-radius: 15px; background: Tokens.cinema-pill; border-width: 1px; border-color: Tokens.cinema-pill-border;
                buf-pill := Text { text: "正在缓冲…"; color: #e2e8f0; font-size: 12px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if root.state.translating: Rectangle {
            // 字幕条接在视频下方，与视频同一块深色影院底，两种主题下都不出现浅色夹条。
            background: Tokens.cinema-bg;
            // 固定高度：字幕条不参与纵向拉伸，视频区域保持最大。
            height: root.state.caption == "" ? 34px : 68px; vertical-stretch: 0;
            Rectangle {
                x: 16px; y: 4px; width: parent.width - 32px; height: parent.height - 8px;
                border-radius: 8px;
                background: root.state.caption == "" ? transparent : Tokens.cinema-pill;
                border-width: root.state.caption == "" ? 0px : 1px;
                border-color: Tokens.cinema-pill-border;
                Text {
                    x: 14px; width: parent.width - 28px; height: parent.height;
                    text: root.state.caption == "" ? root.state.translation-notice : root.state.caption;
                    color: root.state.caption == "" ? #94a3b8 : #f8fafc;
                    font-size: root.state.caption == "" ? 12px : 16px;
                    font-weight: root.state.caption == "" ? 400 : 500;
                    wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; accessible-label: "翻译字幕";
                }
            }
        }
        if root.thumbnail.width > 0: Rectangle {
            height: 112px; background: Tokens.cinema-subbar;
            Rectangle { y: 0px; height: 1px; background: Tokens.line; }
            HorizontalLayout {
                padding: 8px; padding-left: 14px; padding-right: 14px; spacing: 12px;
                Rectangle {
                    width: 176px; height: 96px; border-radius: 6px; background: Tokens.cinema-bg;
                    border-width: 1px; border-color: Tokens.line; clip: true;
                    Image { source: root.thumbnail; width: parent.width; height: parent.height; image-fit: contain; }
                }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: "时间点预览"; color: Tokens.ink; font-size: 12px; font-weight: 600; }
                    Text { text: "悬停进度条可快速定位画面"; color: Tokens.faint; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; }
                HotButton { label: "关闭预览"; y: (parent.height - self.height) / 2; clicked => { root.action("clear_preview"); } }
            }
        }
        Rectangle {
            height: 138px;
            background: Tokens.cinema-bar;
            Rectangle { y: 0px; height: 1px; background: Tokens.line; }
            VerticalLayout {
                padding: 0px; spacing: 0px;
                VerticalLayout {
                    padding: 8px; padding-left: 14px; padding-right: 14px; spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        MediaSeek { maximum: max(1, root.state.duration); value: root.state.position; enabled: root.state.duration > 0; seek(value) => { root.seek(value); } preview(value) => { root.preview(value); } }
                        Rectangle {
                            height: 24px; width: max(96px, time-txt.preferred-width + 16px); y: (parent.height - self.height) / 2;
                            border-radius: 6px; background: Tokens.surface-2; border-width: 1px; border-color: Tokens.line;
                            time-txt := Text { text: root.state.time; color: Tokens.ink; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: Tokens.control-gap;
                        WorkbenchButton { label: root.state.paused ? "播放" : "暂停"; icon: root.state.paused ? "play" : "pause"; primary: true; icon-only: true; width: 38px; clicked => { root.action(root.state.paused ? "resume" : "pause"); } }
                        WorkbenchButton { label: "后退 10 秒"; icon: "back"; outlined: true; icon-only: true; clicked => { root.action("seek_back"); } }
                        WorkbenchButton { label: "前进 10 秒"; icon: "forward"; outlined: true; icon-only: true; clicked => { root.action("seek_fwd"); } }
                        WorkbenchButton { label: root.state.muted ? "取消静音" : "静音"; icon: root.state.muted ? "muted" : "volume"; icon-only: true; clicked => { root.action("mute"); } }
                        // 音量条与进度条同款（钴蓝强调色），不使用随系统强调色变化的 Fluent Slider。
                        MediaSeek { label: "音量"; step: 5; maximum: 100; value: root.state.volume; min-width: 60px; preferred-width: 88px; horizontal-stretch: 0; height: Tokens.control-height; seek(value) => { root.volume(value); } }
                        HotComboBox {
                            a11y-label: "播放速度";
                            model: ["0.25×", "0.5×", "0.75×", "1×", "1.25×", "1.5×", "2×", "4×"];
                            property <float> bound: root.state.speed;
                            current-index: root.state.speed == 0.25 ? 0 : root.state.speed == 0.5 ? 1 : root.state.speed == 0.75 ? 2 : root.state.speed == 1 ? 3 : root.state.speed == 1.25 ? 4 : root.state.speed == 1.5 ? 5 : root.state.speed == 2 ? 6 : root.state.speed == 4 ? 7 : -1;
                            changed bound => {
                                self.current-index = root.state.speed == 0.25 ? 0 : root.state.speed == 0.5 ? 1 : root.state.speed == 0.75 ? 2 : root.state.speed == 1 ? 3 : root.state.speed == 1.25 ? 4 : root.state.speed == 1.5 ? 5 : root.state.speed == 2 ? 6 : root.state.speed == 4 ? 7 : -1;
                                self.current-value = "" + root.state.speed + "×";
                            }
                            current-value: "" + root.state.speed + "×";
                            min-width: 82px; preferred-width: 82px; height: Tokens.control-height; horizontal-stretch: 0;
                            selected(value) => { root.action("speed:" + (self.current-index == 0 ? "0.25" : self.current-index == 1 ? "0.5" : self.current-index == 2 ? "0.75" : self.current-index == 3 ? "1" : self.current-index == 4 ? "1.25" : self.current-index == 5 ? "1.5" : self.current-index == 6 ? "2" : "4")); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        WorkbenchButton { label: "预览帧"; icon: "media"; outlined: true; icon-only: true; clicked => { root.action("preview"); } }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Tokens.cinema-subbar;
                    Rectangle { y: 0px; height: 1px; background: Tokens.hairline; }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: Tokens.control-gap;
                        Text { text: "音轨"; color: Tokens.muted; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                        HotComboBox {
                            model: root.state.audio; a11y-label: "音轨"; min-width: 136px; height: Tokens.control-height; y: (parent.height - self.height) / 2; enabled: root.state.audio.length > 0;
                            property <int> bound: root.state.audio-index;
                            current-index: root.state.audio-index;
                            changed bound => { self.current-index = root.state.audio-index; }
                            selected(value) => { root.audio(self.current-index); }
                        }
                        Text { text: "字幕"; color: Tokens.muted; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                        HotComboBox {
                            model: root.state.subtitles; a11y-label: "字幕"; min-width: 104px; height: Tokens.control-height; y: (parent.height - self.height) / 2;
                            property <int> bound: root.state.subtitle-index;
                            current-index: root.state.subtitle-index;
                            changed bound => { self.current-index = root.state.subtitle-index; }
                            selected(value) => { root.subtitle(self.current-index); }
                        }
                        WorkbenchButton { label: root.state.translating ? "停止翻译" : "字幕翻译"; icon: "subtitle"; outlined: !root.state.translating; active: root.state.translating; icon-only: true; y: (parent.height - self.height) / 2; clicked => { root.action("translate"); } }
                        Text { text: root.notice; color: Tokens.warn; overflow: elide; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; Tooltip { text: @markdown("\{root.notice}"); } }
                    }
                }
            }
        }
    }
}

export component PlayerWindow inherits Window {
    icon: @image-url("../../assets/app-icon.png");
    title: "HLS 播放器 · 画中画";
    background: Tokens.surface;
    default-font-family: Tokens.type-face;
    default-font-size: 12px;
    always-on-top: true;
    preferred-width: 760px; preferred-height: 480px;
    min-width: 560px; min-height: 300px;
    in property <MediaView> state;
    in property <image> thumbnail;
    in property <string> notice;
    in property <bool> fullscreen;
    out property <length> video-x: surface.video-x;
    out property <length> video-y: surface.video-y;
    out property <length> video-width: surface.video-width;
    out property <length> video-height: surface.video-height;
    callback action(string);
    callback seek(float);
    callback preview(float);
    callback volume(float);
    callback audio(int);
    callback subtitle(int);
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.action("escape"); return accept; }
            if event.text == " " { root.action(root.state.paused ? "resume" : "pause"); return accept; }
            return reject;
        }
        surface := MediaSurface {
            width: parent.width; height: parent.height;
            state: root.state; detached: true; fullscreen: root.fullscreen; thumbnail: root.thumbnail; notice: root.notice;
            action(value) => { root.action(value); } seek(value) => { root.seek(value); } preview(value) => { root.preview(value); }
            volume(value) => { root.volume(value); } audio(value) => { root.audio(value); } subtitle(value) => { root.subtitle(value); }
        }
    }
}
