import { Tokens, WorkbenchIcon } from "theme.slint";
export { WorkbenchIcon } from "theme.slint";

export component WorkbenchButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> hint: label;
    in property <bool> icon-only: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> menu-item: false;
    in property <bool> outlined: false;
    in property <bool> drag-source: false;
    private property <bool> drag-started: false;
    callback clicked;
    callback dragged;
    height: Tokens.control-height;
    min-width: icon-only ? 0px : content.min-width;
    preferred-width: icon-only ? Tokens.control-height : content.min-width;
    horizontal-stretch: menu-item ? 1 : 0;
    border-radius: Tokens.control-radius;
    border-width: focus.has-focus || outlined || primary ? 1px : 0px;
    border-color: focus.has-focus || primary ? Tokens.accent : Tokens.line;
    background: primary ? (touch.has-hover && enabled ? Tokens.accent-hover : Tokens.accent) : touch.pressed && enabled ? Tokens.control-pressed : touch.has-hover && enabled ? Tokens.control-hover : outlined ? Tokens.surface : transparent;
    drop-shadow-offset-y: primary || outlined ? 1px : 0px;
    drop-shadow-blur: primary ? 5px : outlined ? 2px : 0px;
    drop-shadow-color: primary || outlined ? Tokens.shadow : transparent;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: Tokens.motion-fast; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    Tooltip { text: @markdown("\{root.hint}"); }
    content := HorizontalLayout {
        padding-left: root.icon-only ? 0px : root.primary ? 16px : 10px;
        padding-right: root.icon-only ? 0px : root.primary ? 16px : 10px;
        spacing: 7px;
        alignment: root.menu-item ? start : center;
        WorkbenchIcon { name: root.icon; ink: root.primary ? Tokens.on-accent : root.danger ? Tokens.fail : Tokens.muted; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
        if !root.icon-only: Text { text: root.label; color: root.primary ? Tokens.on-accent : root.danger ? Tokens.fail : Tokens.ink; font-size: 13px; font-weight: root.primary ? 600 : 500; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-started = false; } }
        moved => {
            if root.drag-source && self.pressed && !root.drag-started && (abs(self.mouse-x - self.pressed-x) >= 4px || abs(self.mouse-y - self.pressed-y) >= 4px) {
                root.drag-started = true; root.dragged();
            }
        }
        clicked => { if !root.drag-started { focus.focus(); root.clicked(); } }
    }
}

export component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <int> count;
    in property <bool> active;
    in property <bool> compact;
    in property <bool> show-count: true;
    in property <bool> enabled: true;
    callback clicked;
    height: 40px; border-radius: 8px;
    background: active ? Tokens.selected : touch.pressed ? Tokens.surface-3 : touch.has-hover ? Tokens.surface-3.with-alpha(0.65) : transparent;
    animate background { duration: Tokens.motion-fast; }
    opacity: root.enabled ? 1 : 0.48;
    accessible-role: tab; accessible-label: root.show-count ? root.label + "，" + root.count + " 项" : root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Tooltip { text: root.show-count ? @markdown("\{root.label}（\{root.count}）") : @markdown("\{root.label}"); }
    HorizontalLayout {
        padding-left: root.compact ? 5px : 10px; padding-right: root.compact ? 5px : 10px; spacing: root.compact ? 5px : 10px;
        Rectangle { width: 3px; height: 16px; y: (parent.height - self.height) / 2; border-radius: 2px; background: root.active ? Tokens.accent : transparent; }
        WorkbenchIcon { name: root.icon; ink: root.active ? Tokens.accent : touch.has-hover ? Tokens.ink : Tokens.muted; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
        if !root.compact: Text { text: root.label; color: root.active ? Tokens.accent : touch.has-hover ? Tokens.ink : Tokens.muted; font-size: 13px; font-weight: root.active ? 600 : 400; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        if !root.compact && root.show-count: Rectangle {
            width: max(24px, count-label.preferred-width + 10px); height: 22px; y: (parent.height - self.height) / 2; border-radius: 6px;
            background: root.active ? Tokens.surface.with-alpha(0.7) : transparent;
            count-label := Text { text: root.count; color: root.active ? Tokens.accent : Tokens.faint; font-size: 11px; font-weight: root.active ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if root.compact && root.count > 0: Text { x: 21px; y: 0px; width: parent.width - 21px; text: root.count > 99 ? "99+" : root.count; color: root.active ? Tokens.accent : Tokens.muted; font-size: 8px; horizontal-alignment: right; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    forward-focus: focus;
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { focus.focus(); root.clicked(); } }
}

export component FileTile inherits Rectangle {
    in property <string> kind;
    private property <color> tint: kind == "media" ? (Tokens.dark ? #bdadff : #8060ce) : kind == "archive" ? (Tokens.dark ? #ebbc73 : #b77823) : kind == "program" ? Tokens.accent : Tokens.muted;
    width: 34px; height: 36px; border-radius: 9px;
    background: tint.with-alpha(Tokens.dark ? 0.14 : 0.09);
    border-width: 1px; border-color: tint.with-alpha(0.08);
    WorkbenchIcon { name: root.kind; ink: root.tint; width: 19px; height: 19px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}
