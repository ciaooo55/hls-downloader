import { Tokens, WorkbenchIcon, FocusRing } from "theme.slint";
export { WorkbenchIcon } from "theme.slint";

export component WorkbenchButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> hint: label;
    in property <bool> icon-only: false;
    in property <bool> primary: false;
    in property <bool> tonal: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> menu-item: false;
    in property <bool> outlined: false;
    in property <bool> subtle: false;
    in property <bool> active: false;
    in property <bool> drag-source: false;
    in property <bool> open: false;
    private property <bool> drag-started: false;
    callback clicked;
    callback dragged;
    height: menu-item ? 32px : Tokens.control-height;
    min-width: icon-only ? 0px : content.min-width;
    preferred-width: icon-only ? Tokens.control-height : content.min-width;
    horizontal-stretch: menu-item ? 1 : 0;
    border-radius: menu-item ? 6px : 7px;
    private property <bool> focus-visible: false;
    border-width: outlined || primary || tonal || active || (danger && !menu-item && touch.has-hover && enabled) ? 1px : 0px;
    border-color: primary ? Tokens.accent
        : active ? Tokens.accent-border
        : tonal ? (touch.has-hover && enabled ? Tokens.accent-border : Tokens.line)
        : danger && touch.has-hover && enabled ? Tokens.fail.with-alpha(0.45)
        : outlined && touch.has-hover && enabled ? Tokens.border-strong
        : Tokens.line;
    background: primary
        ? (touch.pressed && enabled ? Tokens.accent-pressed : touch.has-hover && enabled ? Tokens.accent-hover : Tokens.accent)
        : danger && touch.has-hover && enabled
            ? (touch.pressed ? Tokens.fail-surface.darker(0.06) : Tokens.fail-surface)
            : active
                ? (touch.pressed && enabled ? Tokens.selected.mix(Tokens.accent, 0.82) : touch.has-hover && enabled ? Tokens.selected.mix(Tokens.accent, 0.90) : Tokens.selected)
                : tonal
                    ? (touch.pressed && enabled ? Tokens.control-pressed : touch.has-hover && enabled ? Tokens.control-hover : Tokens.surface-2)
                    : (touch.pressed || root.open) && enabled
                        ? Tokens.control-pressed
                        : touch.has-hover && enabled
                            ? Tokens.control-hover
                            : outlined ? Tokens.surface : transparent;
    drop-shadow-offset-y: subtle ? 0px : primary ? 2px : outlined ? 1px : 0px;
    drop-shadow-blur: subtle ? 0px : primary ? 10px : outlined ? 2px : 0px;
    drop-shadow-color: subtle || !enabled ? transparent : primary ? Tokens.accent.with-alpha(Tokens.dark ? 0.22 : 0.26) : outlined ? Tokens.shadow : transparent;
    opacity: enabled ? 1 : 0.52;
    animate background, border-color { duration: Tokens.motion-fast; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    Tooltip { text: @markdown("\{root.hint}"); }
    if root.primary && !touch.pressed && root.enabled: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: 1px;
        border-radius: max(0px, parent.border-radius - 1px);
        background: Tokens.dark ? #ffffff40 : #ffffff38;
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; radius: root.border-radius; shown: root.focus-visible && focus.has-focus; }
    content := HorizontalLayout {
        padding-left: root.icon-only ? 0px : root.primary ? 15px : 11px;
        padding-right: root.icon-only ? 0px : root.primary ? 15px : 11px;
        spacing: 6px;
        alignment: root.menu-item ? start : center;
        WorkbenchIcon {
            name: root.icon;
            ink: root.primary ? Tokens.on-accent : root.danger ? Tokens.fail : root.active ? Tokens.accent : touch.has-hover && root.enabled ? Tokens.ink : Tokens.muted;
            width: root.menu-item ? 16px : 17px;
            height: root.menu-item ? 16px : 17px;
            y: (parent.height - self.height) / 2;
        }
        if !root.icon-only: Text {
            text: root.label;
            color: root.primary ? Tokens.on-accent : root.danger ? Tokens.fail : root.active ? Tokens.accent : Tokens.ink;
            font-size: 12.5px;
            font-weight: root.primary ? 600 : root.menu-item ? 400 : 500;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-started = false; } }
        moved => {
            if root.drag-source && self.pressed && !root.drag-started && (abs(self.mouse-x - self.pressed-x) >= 4px || abs(self.mouse-y - self.pressed-y) >= 4px) {
                root.drag-started = true; root.dragged();
            }
        }
        clicked => { if !root.drag-started { focus.focus(); root.clicked(); } }
    }
}

export component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <int> count;
    in property <bool> active;
    in property <bool> compact;
    in property <bool> show-count: true;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px; border-radius: 8px;
    private property <bool> focus-visible: false;
    border-width: 1px;
    border-color: active ? Tokens.accent-border : transparent;
    background: active
        ? (touch.pressed && enabled ? Tokens.selected.mix(Tokens.accent, 0.80) : touch.has-hover && enabled ? Tokens.selected.mix(Tokens.accent, 0.90) : Tokens.selected)
        : touch.pressed ? Tokens.control-pressed : touch.has-hover ? Tokens.control-hover : transparent;
    animate background, border-color { duration: Tokens.motion-fast; }
    opacity: root.enabled ? 1 : 0.58;
    accessible-role: tab; accessible-label: root.show-count ? root.label + "，" + root.count + " 项" : root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Tooltip { text: root.show-count ? @markdown("\{root.label}（\{root.count}）") : @markdown("\{root.label}"); }
    FocusRing { x: -1px; y: -1px; width: root.width + 2px; height: root.height + 2px; radius: 8px; shown: root.focus-visible && focus.has-focus; }
    Rectangle { x: 3px; width: 3px; height: root.active ? 16px : 0px; y: (parent.height - self.height) / 2; border-radius: 1.5px; background: Tokens.accent; animate height { duration: Tokens.motion; easing: ease-out; } }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 12px; padding-right: root.compact ? 0px : 8px; spacing: 10px;
        alignment: root.compact ? center : start;
        WorkbenchIcon { name: root.icon; ink: root.active ? Tokens.accent : touch.has-hover ? Tokens.ink : Tokens.muted; width: 17px; height: 17px; y: (parent.height - self.height) / 2; }
        if !root.compact: Text { text: root.label; color: root.active ? Tokens.ink : touch.has-hover ? Tokens.ink : Tokens.muted; font-size: 13px; font-weight: root.active ? 600 : 500; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        if !root.compact && root.show-count && root.count > 0: Rectangle {
            width: max(22px, count-label.preferred-width + 12px); height: 20px; y: (parent.height - self.height) / 2; border-radius: 10px;
            background: root.active ? Tokens.accent-soft : Tokens.surface-3;
            count-label := Text { text: root.count; color: root.active ? Tokens.accent : Tokens.muted; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if root.compact && root.count > 0: Rectangle {
        x: parent.width - self.width - 4px; y: 3px; height: 14px; width: max(14px, compact-count.preferred-width + 6px); border-radius: 7px;
        background: root.active ? Tokens.accent : Tokens.surface-3;
        compact-count := Text { text: root.count > 99 ? "99+" : root.count; color: root.active ? Tokens.on-accent : Tokens.muted; font-size: 8px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
    focus := FocusScope { enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    forward-focus: focus;
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { focus.focus(); root.clicked(); } }
}

export component NavButton inherits NavigationItem {}

export component FileTile inherits Rectangle {
    in property <string> kind;
    private property <color> bg: kind == "media" ? Tokens.media-bg
        : kind == "archive" ? Tokens.archive-bg
        : kind == "program" ? Tokens.program-bg
        : kind == "torrent" ? Tokens.torrent-bg
        : Tokens.document-bg;
    private property <color> fg: kind == "media" ? Tokens.media-ink
        : kind == "archive" ? Tokens.archive-ink
        : kind == "program" ? Tokens.program-ink
        : kind == "torrent" ? Tokens.torrent-ink
        : Tokens.document-ink;
    private property <color> rim: kind == "media" ? Tokens.media-border
        : kind == "archive" ? Tokens.archive-border
        : kind == "program" ? Tokens.program-border
        : kind == "torrent" ? Tokens.torrent-border
        : Tokens.document-border;
    private property <string> glyph: kind == "media" || kind == "archive" || kind == "program" || kind == "torrent" || kind == "document" ? kind : "file";
    width: 38px; height: 38px; border-radius: 10px;
    background: root.bg;
    border-width: 1px;
    border-color: root.rim;
    animate background, border-color { duration: Tokens.motion-fast; }
    WorkbenchIcon {
        name: root.glyph;
        ink: root.fg;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <string> status-code;
    in property <bool> show-dot: true;
    private property <bool> is-processing: status-code == "merging" || status-code == "checking" || status-code == "processing" || status-code == "remuxing" || status-code == "finalizing";
    private property <color> tone: status-code == "paused" || is-processing ? Tokens.warn
        : status-code == "completed" || status-code == "done" ? Tokens.done
        : status-code == "failed" || status-code == "canceled" || status-code == "error" ? Tokens.fail
        : status-code == "queued" ? Tokens.muted
        : Tokens.info;
    private property <color> fill: status-code == "paused" || is-processing ? Tokens.warn-surface
        : status-code == "completed" || status-code == "done" ? Tokens.success-surface
        : status-code == "failed" || status-code == "canceled" || status-code == "error" ? Tokens.fail-surface
        : status-code == "queued" ? Tokens.surface-3
        : Tokens.info-bg;
    height: 24px;
    width: badge-layout.preferred-width;
    border-radius: 999px;
    background: root.fill;
    border-width: 1px;
    border-color: root.tone.with-alpha(Tokens.dark ? 0.36 : 0.24);
    animate background, border-color { duration: Tokens.motion-fast; }
    badge-layout := HorizontalLayout {
        padding-left: root.show-dot ? 9px : 8px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        if root.show-dot: Rectangle {
            width: 6px;
            Rectangle {
                width: 6px; height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: root.tone;
            }
        }
        Text {
            text: root.label;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
