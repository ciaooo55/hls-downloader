import { Tokens, WorkbenchIcon, FocusRing } from "theme.slint";
export { WorkbenchIcon } from "theme.slint";

export component WorkbenchButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> hint: label;
    in property <bool> icon-only: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> menu-item: false;
    in property <bool> outlined: false;
    in property <bool> drag-source: false;
    // 菜单按钮在菜单展开期间保持按下底色，说明菜单从哪里来。
    in property <bool> open: false;
    private property <bool> drag-started: false;
    callback clicked;
    callback dragged;
    height: menu-item ? 32px : Tokens.control-height;
    min-width: icon-only ? 0px : content.min-width;
    preferred-width: icon-only ? Tokens.control-height : content.min-width;
    horizontal-stretch: menu-item ? 1 : 0;
    border-radius: Tokens.control-radius;
    private property <bool> focus-visible: false;
    border-width: outlined || primary ? 1px : 0px;
    border-color: primary ? Tokens.accent : Tokens.line;
    background: primary ? (touch.pressed && enabled ? Tokens.accent-pressed : touch.has-hover && enabled ? Tokens.accent-hover : Tokens.accent) : danger && menu-item && touch.has-hover && enabled ? Tokens.fail-surface : (touch.pressed || root.open) && enabled ? Tokens.control-pressed : touch.has-hover && enabled ? Tokens.control-hover : outlined ? Tokens.surface : transparent;
    drop-shadow-offset-y: primary || outlined ? 1px : 0px;
    drop-shadow-blur: primary ? 8px : outlined ? 2px : 0px;
    drop-shadow-color: !enabled ? transparent : primary ? Tokens.accent.with-alpha(Tokens.dark ? 0.18 : 0.26) : outlined ? Tokens.shadow : transparent;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: Tokens.motion-fast; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    Tooltip { text: @markdown("\{root.hint}"); }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: root.focus-visible && focus.has-focus; }
    content := HorizontalLayout {
        padding-left: root.icon-only ? 0px : root.primary ? 16px : 10px;
        padding-right: root.icon-only ? 0px : root.primary ? 16px : 10px;
        spacing: 7px;
        alignment: root.menu-item ? start : center;
        WorkbenchIcon { name: root.icon; ink: root.primary ? Tokens.on-accent : root.danger ? Tokens.fail : touch.has-hover && root.enabled ? Tokens.ink : Tokens.muted; width: root.menu-item ? 16px : 18px; height: root.menu-item ? 16px : 18px; y: (parent.height - self.height) / 2; }
        if !root.icon-only: Text { text: root.label; color: root.primary ? Tokens.on-accent : root.danger ? Tokens.fail : Tokens.ink; font-size: 13px; font-weight: root.primary ? 600 : root.menu-item ? 400 : 500; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-started = false; } }
        moved => {
            if root.drag-source && self.pressed && !root.drag-started && (abs(self.mouse-x - self.pressed-x) >= 4px || abs(self.mouse-y - self.pressed-y) >= 4px) {
                root.drag-started = true; root.dragged();
            }
        }
        clicked => { if !root.drag-started { focus.focus(); root.clicked(); } }
    }
}

export component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <int> count;
    in property <bool> active;
    in property <bool> compact;
    in property <bool> show-count: true;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px; border-radius: Tokens.control-radius;
    private property <bool> focus-visible: false;
    background: active ? (touch.pressed && enabled ? Tokens.selected.mix(Tokens.accent, 0.80) : touch.has-hover && enabled ? Tokens.selected.mix(Tokens.accent, 0.90) : Tokens.selected) : touch.pressed ? Tokens.control-pressed : touch.has-hover ? Tokens.control-hover : transparent;
    animate background { duration: Tokens.motion-fast; }
    opacity: root.enabled ? 1 : 0.48;
    accessible-role: tab; accessible-label: root.show-count ? root.label + "，" + root.count + " 项" : root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Tooltip { text: root.show-count ? @markdown("\{root.label}（\{root.count}）") : @markdown("\{root.label}"); }
    // 与按钮一致：只在 Tab 键切换时显示焦点环，鼠标点击不显示。侧栏内收 1px，避免被侧栏裁掉。
    FocusRing { x: -1px; y: -1px; width: root.width + 2px; height: root.height + 2px; shown: root.focus-visible && focus.has-focus; }
    // 选中指示条贴在左缘，紧凑模式下同样可见。
    Rectangle { x: 3px; width: 3px; height: root.active ? 16px : 0px; y: (parent.height - self.height) / 2; border-radius: 1.5px; background: Tokens.accent; animate height { duration: Tokens.motion; easing: ease-out; } }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 12px; padding-right: root.compact ? 0px : 8px; spacing: 10px;
        alignment: root.compact ? center : start;
        WorkbenchIcon { name: root.icon; ink: root.active ? Tokens.accent : touch.has-hover ? Tokens.ink : Tokens.muted; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
        if !root.compact: Text { text: root.label; color: root.active ? Tokens.ink : touch.has-hover ? Tokens.ink : Tokens.muted; font-size: 13px; font-weight: root.active ? 600 : 400; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        if !root.compact && root.show-count && root.count > 0: Rectangle {
            width: max(22px, count-label.preferred-width + 12px); height: 20px; y: (parent.height - self.height) / 2; border-radius: 10px;
            background: root.active ? Tokens.accent : Tokens.surface-3;
            count-label := Text { text: root.count; color: root.active ? Tokens.on-accent : Tokens.muted; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if root.compact && root.count > 0: Rectangle {
        x: parent.width - self.width - 4px; y: 3px; height: 14px; width: max(14px, compact-count.preferred-width + 6px); border-radius: 7px;
        background: root.active ? Tokens.accent : Tokens.surface-3;
        compact-count := Text { text: root.count > 99 ? "99+" : root.count; color: root.active ? Tokens.on-accent : Tokens.muted; font-size: 8px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
    focus := FocusScope { enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    forward-focus: focus;
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { focus.focus(); root.clicked(); } }
}

export component FileTile inherits Rectangle {
    in property <string> kind;
    private property <color> tint: kind == "media" ? Tokens.media-tint : kind == "archive" ? Tokens.archive-tint : kind == "program" ? Tokens.accent : Tokens.muted;
    width: 36px; height: 36px; border-radius: Tokens.card-radius;
    background: tint.with-alpha(Tokens.dark ? 0.16 : 0.10);
    WorkbenchIcon { name: root.kind; ink: root.tint; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}
