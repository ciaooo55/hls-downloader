import { Tokens } from "theme.slint";
import { WorkbenchIcon } from "workbench_components.slint";

export component DialogHeader inherits Rectangle {
    in property <string> heading;
    in property <string> description;
    in property <string> icon;
    height: 88px;
    background: Tokens.surface;
    HorizontalLayout {
        padding-left: 24px; padding-right: 24px; spacing: 14px;
        Rectangle {
            width: 42px; height: 42px; y: (parent.height - self.height) / 2;
            border-radius: 12px; background: Tokens.selected;
            WorkbenchIcon { name: root.icon; ink: Tokens.accent; width: 22px; height: 22px; x: 10px; y: 10px; }
        }
        VerticalLayout {
            alignment: center; spacing: 5px;
            Text { text: root.heading; font-size: 21px; font-weight: 700; color: Tokens.ink; overflow: elide; }
            Text { text: root.description; font-size: 12px; color: Tokens.faint; overflow: elide; }
        }
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Tokens.line; }
}

export component DialogFooter inherits Rectangle {
    in property <string> status;
    height: root.status == "" ? 72px : 112px;
    background: Tokens.surface;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Tokens.line; }
    if root.status != "": Text {
        x: 24px; y: 10px; width: parent.width - 48px; height: 38px;
        text: root.status; color: Tokens.warn; font-size: 12px; wrap: word-wrap; overflow: elide;
    }
    Tooltip { text: @markdown("\{root.status}"); }
    HorizontalLayout {
        x: 24px; y: root.status == "" ? 18px : 58px; width: parent.width - 48px; height: Tokens.control-height; spacing: Tokens.control-gap;
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}
