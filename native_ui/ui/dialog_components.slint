import { Tokens } from "theme.slint";
import { WorkbenchIcon } from "workbench_components.slint";

export component DialogHeader inherits Rectangle {
    in property <string> heading;
    in property <string> description;
    in property <string> icon;
    height: 58px;
    background: Tokens.canvas;
    HorizontalLayout {
        padding-left: 24px; padding-right: 24px; spacing: 12px;
        Rectangle {
            width: 34px; height: 34px; y: (parent.height - self.height) / 2;
            border-radius: 8px; background: Tokens.info-bg;
            border-width: 1px; border-color: Tokens.accent-border;
            WorkbenchIcon { name: root.icon; ink: Tokens.accent; width: 18px; height: 18px; x: 8px; y: 8px; }
        }
        VerticalLayout {
            alignment: center; spacing: 2px;
            Text { text: root.heading; font-size: 15px; font-weight: 700; color: Tokens.ink; overflow: elide; }
            Text { text: root.description; font-size: 11.5px; color: Tokens.muted; overflow: elide; }
        }
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Tokens.line; }
}

export component DialogFooter inherits Rectangle {
    in property <string> status;
    // 状态语气：info（说明，蓝/中性）、success（完成，绿）、warning（需注意，琥珀）、error（失败，红）。
    in property <string> tone: "warning";
    private property <color> tone-ink: tone == "success" ? Tokens.done : tone == "error" ? Tokens.fail : tone == "info" ? Tokens.info : Tokens.warn;
    private property <color> tone-icon-ink: tone == "info" ? Tokens.info : root.tone-ink;
    private property <string> tone-icon: tone == "success" ? "completed" : tone == "info" ? "info" : tone == "warning" ? "notices" : "failed";
    height: 64px;
    background: Tokens.rail;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Tokens.line; }
    HorizontalLayout {
        x: 24px; y: 1px; width: parent.width - 48px; height: parent.height - 1px; spacing: Tokens.control-gap;
        status-area := HorizontalLayout {
            horizontal-stretch: 1; min-width: 0px; spacing: 8px; padding-right: 8px;
            if root.status != "": WorkbenchIcon { name: root.tone-icon; ink: root.tone-icon-ink; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
            if root.status != "": Rectangle {
                min-width: 0px; horizontal-stretch: 1;
                status-text := Text {
                    x: 0px; width: parent.width;
                    height: min(self.preferred-height, 36px); y: (parent.height - self.height) / 2;
                    text: root.status; color: root.tone-ink; font-size: 12px;
                    wrap: word-wrap; overflow: elide; vertical-alignment: top;
                }
                Tooltip { text: @markdown("\{root.status}"); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.control-gap; alignment: end; horizontal-stretch: 0;
            padding-top: (parent.height - Tokens.control-height) / 2; padding-bottom: (parent.height - Tokens.control-height) / 2;
            @children
        }
    }
}
