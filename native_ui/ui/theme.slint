import "../fonts/NotoSansCJKsc-Regular.otf";
import { Palette, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";

export global Tokens {
    in-out property <bool> dark: false;
    public function apply-theme(value: bool) {
        self.dark = value;
        Palette.color-scheme = value ? ColorScheme.dark : ColorScheme.light;
    }
    in-out property <bool> reduce-motion: false;
    out property <duration> motion: reduce-motion ? 1ms : 160ms;
    out property <duration> motion-fast: reduce-motion ? 1ms : 90ms;
    // 面板展开、提示出现等“回应用户操作”的过渡；减少动态效果时同样降到 1ms。
    out property <duration> motion-slow: reduce-motion ? 1ms : 220ms;
    out property <string> type-face: "Noto Sans CJK SC";
    // 统一视觉系统 "Graphite + Cobalt"：中性石墨底色 + 单一钴蓝强调色。
    // 只改取值、不改名字，所有窗口和 Rust 绑定保持兼容。
    out property <length> control-height: 34px;
    // 圆角只有两档，与 Windows 11 / Fluent 标准控件一致：
    // 控件（按钮、输入框、选择块、行高亮、导航项）4px；卡片、横幅、图标块、菜单、弹窗 8px。
    // 状态胶囊、计数徽章、进度轨道用高度一半的全圆角，属于形状而不是档位。
    out property <length> control-radius: 4px;
    out property <length> card-radius: 8px;
    out property <length> panel-radius: 8px;
    out property <length> control-gap: 8px;
    out property <color> surface: dark ? #171a20 : #ffffff;
    out property <color> surface-2: dark ? #1c2027 : #f6f7f9;
    out property <color> surface-3: dark ? #262b34 : #eceef2;
    out property <color> control-hover: dark ? #232833 : #f0f2f6;
    out property <color> control-pressed: dark ? #2c3340 : #e6e9ef;
    out property <color> canvas: dark ? #0f1115 : #f2f3f6;
    out property <color> rail: dark ? #12141a : #f8f9fb;
    out property <color> faint: dark ? #8b93a1 : #5f6b7d;
    out property <color> selected: dark ? #1b2741 : #eef3ff;
    out property <color> hairline: dark ? #20242c : #eef0f3;
    out property <color> shadow: dark ? #00000040 : #1018280f;
    out property <color> success-surface: dark ? #13301f : #ecfaf1;
    out property <color> warn-surface: dark ? #33280f : #fff6e5;
    out property <color> fail-surface: dark ? #3a1a1a : #fef1f0;
    out property <color> info-surface: dark ? #182540 : #eef3ff;
    out property <color> ink: dark ? #eef1f6 : #0c111d;
    out property <color> muted: dark ? #b6bcc8 : #475467;
    out property <color> accent: dark ? #7aa2ff : #2e5bea;
    out property <color> accent-hover: dark ? #97b6ff : #2149cf;
    out property <color> accent-soft: dark ? #7aa2ff26 : #2e5bea14;
    // 主按钮按下：比悬停再深一档，代替原来整体降透明度（降透明度会让按钮看起来像被禁用）。
    out property <color> accent-pressed: dark ? #6489e6 : #1a3cb0;
    // 键盘焦点环：只在 Tab 导航时出现，鼠标点击不出现，颜色取强调色。
    out property <color> focus-ring: dark ? #97b6ff : #2e5bea;
    out property <color> on-accent: dark ? #0f1115 : #ffffff;
    // 状态色按主题取值，浅色/深色底上都保持 ≥4.5:1。
    out property <color> done: dark ? #3ccf7a : #157f3c;
    out property <color> warn: dark ? #f5a524 : #b54708;
    out property <color> fail: dark ? #ff7a73 : #c4271b;
    out property <color> media-tint: dark ? #c3b2ff : #6941c6;
    out property <color> archive-tint: dark ? #f2c27a : #b25e09;
    out property <color> line: dark ? #2a2f39 : #e2e5eb;
}

// Existing toolbar artwork is shared with the desktop UI. The remaining
// outline symbols use the same 24-unit grid and follow the active palette.
export component WorkbenchIcon inherits Rectangle {
    in property <string> name;
    in property <color> ink: Tokens.muted;
    width: 18px; height: 18px;
    private property <bool> artwork: name == "paste" || name == "play" || name == "pause" || name == "refresh" || name == "retry" || name == "settings" || name == "theme" || name == "batch" || name == "harvest" || name == "extension";
    if root.artwork: Image {
        width: parent.width; height: parent.height; colorize: root.ink; image-fit: contain;
        source: root.name == "paste" ? @image-url("../../assets/toolbar-paste.svg") : root.name == "play" ? @image-url("../../assets/toolbar-play.svg") : root.name == "pause" ? @image-url("../../assets/toolbar-pause.svg") : root.name == "refresh" ? @image-url("../../assets/toolbar-refresh.svg") : root.name == "retry" ? @image-url("../../assets/toolbar-retry.svg") : root.name == "settings" ? @image-url("../../assets/toolbar-settings.svg") : root.name == "theme" ? @image-url("../../assets/toolbar-theme.svg") : root.name == "batch" ? @image-url("../../assets/toolbar-batch.svg") : root.name == "harvest" ? @image-url("../../assets/toolbar-harvest.svg") : @image-url("../../assets/toolbar-extension.svg");
    }
    if !root.artwork: Path {
        width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24;
        fill: transparent; stroke: root.ink; stroke-width: 1.7px; stroke-line-cap: round; stroke-line-join: round;
        commands: root.name == "new" ? "M12 5V19 M5 12H19" :
            root.name == "more" ? "M4 12H5 M11.5 12H12.5 M19 12H20" :
            root.name == "search" ? "M20 20L16 16 M17 10A7 7 0 1 1 3 10A7 7 0 1 1 17 10Z" :
            root.name == "close" ? "M6 6L18 18 M6 18L18 6" :
            root.name == "sun" ? "M12 2V4 M12 20V22 M2 12H4 M20 12H22 M5 5L6.5 6.5 M17.5 17.5L19 19 M5 19L6.5 17.5 M17.5 6.5L19 5 M16 12A4 4 0 1 1 8 12A4 4 0 1 1 16 12Z" :
            root.name == "network" ? "M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12Z M3 12H21 M12 3C7 8 7 16 12 21C17 16 17 8 12 3Z" :
            root.name == "security" ? "M12 3L20 6V12C20 17 16 20 12 22C8 20 4 17 4 12V6Z M8 12L11 15L16 10" :
            root.name == "subtitle" ? "M3 5H21V19H3Z M6 9H10 M14 9H18 M6 14H8 M11 14H18" :
            root.name == "torrent" ? "M12 8V3 M9 3H15 M12 8L6 16 M12 8L18 16 M8 18A3 3 0 1 1 2 18A3 3 0 1 1 8 18Z M22 18A3 3 0 1 1 16 18A3 3 0 1 1 22 18Z" :
            root.name == "notices" ? "M5 17H19L17 14V9A5 5 0 0 0 7 9V14Z M10 21H14 M12 2V4" :
            root.name == "info" ? "M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12Z M12 11V17 M12 7V7.2" :
            root.name == "save" ? "M4 3H17L21 7V21H3V3Z M7 3V9H16V3 M7 21V14H17V21" :
            root.name == "check" ? "M4 12L9 17L20 6" :
            root.name == "stop" ? "M5 5H19V19H5Z" :
            root.name == "volume" ? "M3 9H7L12 5V19L7 15H3Z M16 8A6 6 0 0 1 16 16 M19 5A10 10 0 0 1 19 19" :
            root.name == "muted" ? "M3 9H7L12 5V19L7 15H3Z M16 9L22 15 M16 15L22 9" :
            root.name == "back" ? "M11 6L5 12L11 18 M19 6L13 12L19 18" :
            root.name == "forward" ? "M5 6L11 12L5 18 M13 6L19 12L13 18" :
            root.name == "pip" ? "M3 4H21V20H3Z M12 12H18V17H12Z" :
            root.name == "dock" ? "M3 4H21V20H3Z M3 14H21 M8 8L12 11L16 8" :
            root.name == "fullscreen" ? "M3 9V3H9 M15 3H21V9 M21 15V21H15 M9 21H3V15" :
            root.name == "restore" ? "M9 3V9H3 M21 9H15V3 M15 21V15H21 M3 15H9V21" :
            root.name == "down" ? "M7 9L12 14L17 9" :
            root.name == "arrow-up" ? "M12 19V5 M6 11L12 5L18 11" :
            root.name == "arrow-down" ? "M12 5V19 M6 13L12 19L18 13" :
            root.name == "up" ? "M7 14L12 9L17 14" :
            root.name == "running" ? "M12 3V14 M8 10L12 14L16 10 M5 16V20H19V16" :
            root.name == "queued" ? "M12 6V12L16 14 M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12Z" :
            root.name == "paused" ? "M9 8V16 M15 8V16 M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12Z" :
            root.name == "completed" ? "M7 12L10.5 15.5L17 9 M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12Z" :
            root.name == "failed" ? "M12 7V12 M12 16V16.2 M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12Z" :
            root.name == "media" ? "M3 5H21V19H3Z M3 16L9 10L14 15L17 12L21 16 M16 8H16.2" :
            root.name == "program" ? "M4 4H10V10H4Z M14 4H20V10H14Z M4 14H10V20H4Z M14 14H20V20H14Z" :
            root.name == "archive" ? "M3 6H10L12 8H21V20H3Z M15 8V10H17V12H15V14H17V17H15V19" :
            root.name == "file" ? "M5 3H14L19 8V21H5Z M14 3V8H19" :
            root.name == "queue" ? "M4 6H15 M4 11H15 M4 16H11 M17 12L22 16L17 20Z" :
            root.name == "cast" ? "M3 5H21V19H14 M3 12A7 7 0 0 1 10 19 M3 16A3 3 0 0 1 6 19 M3 19H3.2" :
            root.name == "tvbox" ? "M3 6H21V19H3Z M8 3L12 6L16 3 M8 22H16" :
            root.name == "import" ? "M4 4H14 M4 4V20H20V11 M20 3L12 11 M12 5V11H18" :
            root.name == "export" ? "M4 4H14 M4 4V20H20V11 M12 11L20 3 M14 3H20V9" :
            root.name == "delete" ? "M4 6H20 M9 6V3H15V6 M6 6L7 21H17L18 6 M10 10V17 M14 10V17" :
            root.name == "drag" ? "M5 9H19 M5 15H19" :
            root.name == "details" ? "M4 4H20V20H4Z M8 8H16 M8 12H16 M8 16H13" :
            root.name == "folder" ? "M3 6H10L12 8H21V20H3Z" :
            "M5 3H14L19 8V21H5Z M14 3V8H19";
    }
}

// 键盘焦点环：画在控件外侧 2px，不改变控件自身的边框和尺寸，因此主按钮（本身就是强调色边框）
// 也能看出焦点。shown 由各控件按 FocusReason 决定：Tab 导航显示，鼠标点击不显示。
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius: Tokens.control-radius;
    // 使用处给出 x/y = -3px、宽高 = 控件 + 6px（组件定义里不能引用 parent）。
    border-radius: root.radius + 3px;
    border-width: 2px;
    border-color: Tokens.focus-ring;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Tokens.motion-fast; easing: ease-out; }
}

// 进行中指示：三个圆点依次明暗。不用旋转，软件渲染器也能正确绘制；减少动态效果时静止。
export component BusyDots inherits HorizontalLayout {
    in property <color> ink: Tokens.on-accent;
    private property <float> phase: Tokens.reduce-motion ? 0 : mod(animation-tick() / 1ms, 900) / 300;
    spacing: 3px;
    alignment: center;
    for i in 3: Rectangle {
        width: 4px; height: 4px; y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.ink;
        opacity: Tokens.reduce-motion ? 0.85 : (Math.floor(root.phase) == i ? 1 : 0.38);
    }
}

export component HotButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // 进行中：保留按钮颜色与宽度、显示进行中圆点并拦截点击。与 enabled=false 区分，
    // 避免“正在开始下载”看起来像按钮被禁用。
    in property <bool> busy: false;
    in property <string> busy-label: root.label;
    callback clicked;
    private property <bool> active: root.enabled && !root.busy;
    private property <bool> focus-visible: false;
    private property <bool> down: touch.pressed && root.active;
    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.busy ? root.busy-label : root.label;
    accessible-enabled: root.active;
    accessible-action-default => { if root.active { root.clicked(); } }
    min-width: max(72px, content.min-width);
    preferred-width: content.min-width;
    horizontal-stretch: 0;
    height: Tokens.control-height;
    border-radius: Tokens.control-radius;
    opacity: root.enabled || root.busy ? 1 : 0.48;
    animate opacity { duration: Tokens.motion-fast; easing: ease-out; }
    background: root.primary
        ? (root.down ? Tokens.accent-pressed : touch.has-hover && root.active ? Tokens.accent-hover : Tokens.accent)
        : root.danger && touch.has-hover && root.active
            ? (root.down ? Tokens.fail-surface.darker(0.06) : Tokens.fail-surface)
            : (root.down ? Tokens.control-pressed : touch.has-hover && root.active ? Tokens.control-hover : Tokens.surface);
    border-width: 1px;
    border-color: root.danger ? Tokens.fail.with-alpha(0.45) : root.primary ? Tokens.accent : touch.has-hover && root.active ? Tokens.faint.with-alpha(0.5) : Tokens.line;
    // 按下时阴影收起，配合内容下移 1px，形成“按进去”的反馈。
    drop-shadow-offset-y: root.down ? 0px : root.primary ? 2px : 1px;
    drop-shadow-blur: root.down ? 0px : root.primary ? 8px : 2px;
    drop-shadow-color: !root.enabled && !root.busy ? transparent : root.primary ? Tokens.accent.with-alpha(Tokens.dark ? 0.18 : 0.26) : Tokens.shadow;
    animate background, border-color { duration: Tokens.motion-fast; easing: ease-out; }
    animate drop-shadow-blur, drop-shadow-offset-y { duration: Tokens.motion-fast; easing: ease-out; }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: root.focus-visible && key-focus.has-focus; }
    content := HorizontalLayout {
        y: root.down ? 1px : 0px;
        animate y { duration: Tokens.motion-fast; easing: ease-out; }
        padding-left: root.primary ? 16px : 12px;
        padding-right: root.primary ? 16px : 12px;
        spacing: 6px;
        alignment: center;
        if root.busy: BusyDots { ink: root.primary ? Tokens.on-accent : Tokens.accent; }
        if root.icon != "" && !root.busy: WorkbenchIcon {
            name: root.icon;
            ink: root.primary ? Tokens.on-accent : root.danger ? Tokens.fail : touch.has-hover && root.active ? Tokens.ink : Tokens.muted;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.busy ? root.busy-label : root.label;
            color: root.primary ? Tokens.on-accent : (root.danger ? Tokens.fail : Tokens.ink);
            font-size: 13px;
            font-weight: root.primary ? 600 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    key-focus := FocusScope {
        enabled: root.active;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.focus-visible = true; root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.active; mouse-cursor: root.active ? pointer : root.busy ? progress : default; clicked => { key-focus.focus(); root.clicked(); } }
}

export component HotCloseButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> accessible-name: "关闭";
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: Tokens.control-radius;
    private property <bool> focus-visible: false;
    opacity: enabled ? 1 : 0.45;
    background: touch.pressed && enabled ? Tokens.control-pressed : touch.has-hover && enabled ? Tokens.surface-3 : transparent;
    animate background { duration: Tokens.motion-fast; easing: ease-out; }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: root.focus-visible && focus.has-focus; }
    WorkbenchIcon {
        name: "close"; ink: touch.has-hover && root.enabled ? Tokens.ink : Tokens.muted;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.accessible-name;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected: false;
    // 列表式选择（例如投屏设备）左对齐，分段/标签式选择居中。
    in property <bool> align-start: false;
    in property <bool> enabled: true;
    callback clicked;
    height: Tokens.control-height;
    border-radius: Tokens.control-radius;
    border-width: 1px;
    border-color: selected ? Tokens.accent.with-alpha(0.7) : Tokens.line;
    background: selected ? Tokens.selected : (touch.pressed && root.enabled ? Tokens.control-pressed : touch.has-hover && root.enabled ? Tokens.control-hover : Tokens.surface);
    animate background, border-color { duration: Tokens.motion-fast; easing: ease-out; }
    min-width: choice-content.min-width;
    preferred-width: choice-content.preferred-width;
    choice-content := HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: root.align-start ? stretch : center;
        if root.icon != "": WorkbenchIcon { name: root.icon; ink: root.selected ? Tokens.accent : Tokens.muted; y: (parent.height - self.height) / 2; }
        Text {
            text: root.label;
            color: root.selected ? Tokens.accent : Tokens.ink;
            font-size: root.align-start ? 13px : 12px;
            // 选中只改颜色、底色和描边，不改字重，避免文字宽度变化导致布局抖动。
            font-weight: 500;
            horizontal-alignment: root.align-start ? left : center;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: root.align-start ? 1 : 0;
        }
        if root.align-start && root.selected: WorkbenchIcon { name: "check"; ink: Tokens.accent; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
    }
    opacity: enabled ? 1 : 0.48;
    private property <bool> focus-visible: false;
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: root.focus-visible && focus.has-focus; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; accessible-role: button; accessible-label: root.label; clicked => { focus.focus(); root.clicked(); } }
}

export component FieldLabel inherits Text {
    in property <string> label;
    text: label;
    color: Tokens.muted;
    font-size: 12px;
    font-weight: 500;
    vertical-alignment: center;
}

export component HotLineEdit inherits LineEdit {
    height: Tokens.control-height;
    font-size: 13px;
}

// 统一的复选框：钴蓝强调色 + 4px 控件圆角，不跟随系统强调色（Fluent 自带复选框会随系统变成青色/绿色等，
// 且自带 2px 圆角，与其它控件的 4px 不一致）。接口与 std CheckBox 保持一致：text / checked / enabled / toggled。
export component HotCheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;
    in-out property <bool> checked: false;
    out property <bool> has-focus: focus.has-focus;
    callback toggled;
    private property <bool> focus-visible: false;
    private property <bool> ring: root.focus-visible && focus.has-focus;
    min-height: 22px;
    horizontal-stretch: 0;
    min-width: layout.min-width;
    preferred-width: layout.preferred-width;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    forward-focus: focus;
    layout := HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px; height: 18px; y: (parent.height - self.height) / 2;
            border-radius: Tokens.control-radius;
            background: !root.enabled ? (root.checked ? Tokens.faint : Tokens.surface-2) : root.checked ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) : (touch.pressed ? Tokens.control-pressed : touch.has-hover ? Tokens.control-hover : Tokens.surface);
            border-width: root.checked && !root.ring ? 0px : root.ring ? 2px : 1px;
            border-color: root.ring ? (root.checked ? Tokens.accent-hover : Tokens.accent) : touch.has-hover && root.enabled ? Tokens.muted : Tokens.faint;
            animate background, border-color { duration: Tokens.motion-fast; easing: ease-out; }
            if root.checked: Path {
                x: 3px; y: 3px; width: 12px; height: 12px; viewbox-width: 24; viewbox-height: 24;
                fill: transparent; stroke: Tokens.on-accent; stroke-width: 2.2px; stroke-line-cap: round; stroke-line-join: round;
                commands: "M4 12.5L9.5 18L20 6.5";
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? Tokens.ink : Tokens.faint;
            font-size: root.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => {
            if event.text == " " { root.checked = !root.checked; root.toggled(); return accept; }
            return reject;
        }
    }
    // 点击区域只覆盖复选框和文字，空白处不切换。
    touch := TouchArea {
        x: 0px; width: min(root.width, layout.preferred-width);
        enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default;
        clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); }
    }
}

export component CheckRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> checked: false;
    callback toggled(bool);
    height: 30px;
    forward-focus: checkbox;
    checkbox := HotCheckBox {
        width: parent.width; height: parent.height;
        text: root.label;
        checked <=> root.checked;
        enabled: root.enabled;
        font-size: 12px;
        toggled => { root.toggled(self.checked); }
    }
}

export component Panel inherits Rectangle {
    border-radius: Tokens.panel-radius;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.dark ? Tokens.line : Tokens.line.darker(0.04);
    @children
}

export component WindowDragArea inherits TouchArea {
    callback drag(float, float);
    min-height: 24px;
    mouse-cursor: move;
    moved => {
        root.drag((self.mouse-x - self.pressed-x) / 1px, (self.mouse-y - self.pressed-y) / 1px);
    }
}


export struct SegmentBlock {
    width-ratio: float,
    fill-ratio: float,
    state: string,
}

export component SegmentMapBar inherits Rectangle {
    in property <[SegmentBlock]> segments;
    height: 7px;
    border-radius: 3.5px;
    background: Tokens.surface-3;
    clip: true;
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 1px;
        for seg[i] in root.segments: Rectangle {
            horizontal-stretch: seg.width-ratio;
            height: parent.height;
            // 软件渲染器不会按圆角裁剪子元素，首尾分段自己带圆角。
            border-top-left-radius: i == 0 ? root.border-radius : 0px;
            border-bottom-left-radius: i == 0 ? root.border-radius : 0px;
            border-top-right-radius: i == root.segments.length - 1 ? root.border-radius : 0px;
            border-bottom-right-radius: i == root.segments.length - 1 ? root.border-radius : 0px;
            background: seg.state == "done" ? Tokens.done.with-alpha(0.88) : seg.state == "active" ? Tokens.accent.with-alpha(0.28) : Tokens.surface-3;
            animate background { duration: Tokens.motion-fast; }
            if seg.state == "active": Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: parent.width * Math.clamp(seg.fill-ratio, 0.0, 1.0);
                border-top-left-radius: parent.border-top-left-radius;
                border-bottom-left-radius: parent.border-bottom-left-radius;
                background: Tokens.accent;
                animate width { duration: Tokens.motion; easing: ease-out; }
            }
        }
    }
}

// 深色主题下 Fluent 滚动条的细线颜色是 FluentPalette.border（8% 白），几乎看不见；
// 这里按 Fluent ScrollBar 的几何（14px 轨道、上下各 16px 留白、细线距右缘 4px、宽 2px）
// 在同一位置叠一根可见的细线。它不含 TouchArea，拖动、滚轮、悬停仍由原滚动条处理。
export component ScrollCue inherits Rectangle {
    in property <length> viewport-y;
    in property <length> viewport-height;
    in property <length> visible-height;
    private property <length> maximum: root.viewport-height - root.visible-height;
    private property <length> track: root.height - 32px;
    private property <length> thumb: root.maximum <= 0px ? 0px : max(min(16px, root.height), root.track * (root.visible-height / root.viewport-height));
    width: 14px;
    visible: Tokens.dark && root.maximum > 0.5px;
    Rectangle {
        x: parent.width - 6px; width: 2px; border-radius: 1px;
        y: 16px + (root.track - root.thumb) * Math.clamp(-root.viewport-y / max(1px, root.maximum), 0, 1);
        height: root.thumb;
        background: Tokens.faint.with-alpha(0.72);
    }
}

// 与 std ScrollView 接口一致的包装：深色主题下叠加 ScrollCue，浅色主题保持 Fluent 原样。
export component HotScrollView {
    in property <bool> enabled: true;
    out property <length> visible-width <=> sv.visible-width;
    out property <length> visible-height <=> sv.visible-height;
    in-out property <length> viewport-width <=> sv.viewport-width;
    in-out property <length> viewport-height <=> sv.viewport-height;
    in-out property <length> viewport-x <=> sv.viewport-x;
    in-out property <length> viewport-y <=> sv.viewport-y;
    in property <ScrollBarPolicy> vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
    callback scrolled <=> sv.scrolled;
    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;
    sv := ScrollView {
        x: 0px; y: 0px; width: root.width; height: root.height;
        enabled: root.enabled;
        vertical-scrollbar-policy: root.vertical-scrollbar-policy;
        horizontal-scrollbar-policy: root.horizontal-scrollbar-policy;
        @children
    }
    if root.vertical-scrollbar-policy != ScrollBarPolicy.always-off: ScrollCue {
        x: root.width - self.width; y: 0px; height: root.height;
        viewport-y: sv.viewport-y; viewport-height: sv.viewport-height; visible-height: sv.visible-height;
    }
}

// Fluent ComboBox 禁用态边框是 FluentPalette.border（浅色 45% 黑），比启用态还重；
// 禁用时在原边框上叠一层与输入框一致的 Tokens.line 细边框（Fluent 下拉框圆角 3px）。
export component HotComboBox {
    in property <[string]> model;
    in property <bool> enabled: true;
    // 读屏名称转给内部的 ComboBox（包装层本身不是可访问控件）。
    in property <string> a11y-label;
    out property <bool> has-focus: cb.has-focus;
    in-out property <int> current-index <=> cb.current-index;
    in-out property <string> current-value <=> cb.current-value;
    callback selected(string);
    min-width: cb.min-width;
    min-height: cb.min-height;
    preferred-width: cb.preferred-width;
    preferred-height: cb.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: cb;
    cb := ComboBox {
        x: 0px; y: 0px; width: root.width; height: root.height;
        model: root.model;
        enabled: root.enabled;
        accessible-label: root.a11y-label;
        selected(value) => { root.selected(value); }
    }
    if !root.enabled: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        border-radius: 3px; border-width: 1px; border-color: Tokens.line;
    }
}
