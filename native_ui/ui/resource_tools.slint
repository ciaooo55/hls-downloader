import { ListView, LineEdit } from "std-widgets.slint";
import { Tokens, HotButton, FieldLabel, HotCheckBox, HotScrollView, HotComboBox, ScrollCue } from "theme.slint";
import { DialogFooter } from "dialog_components.slint";
import { WorkbenchIcon } from "workbench_components.slint";

export struct ResourceRow { id: string, label: string, detail: string, selected: bool }

export component ResourceToolsWindow inherits Window {
    icon: @image-url("../../assets/app-icon.png");
    title: root.mode == "zip" ? "ZIP 内容预览" : root.mode == "crawl" ? "抓站与同步项目" : root.mode == "torrent" ? "种子文件选择" : "页面资源抓取";
    background: Tokens.canvas; default-font-family: Tokens.type-face; default-font-size: 13px;
    preferred-width: 880px; preferred-height: 650px; min-width: 640px;
    // 最小高度跟随内容：各模式下表单、标题、摘要与列表最小高度都能完整放下，最小尺寸时不裁切。
    min-height: max(420px, main-layout.min-height);
    in property <string> mode;
    in-out property <string> source;
    in-out property <string> output-dir;
    in-out property <string> queue-id: "default";
    in property <[string]> queue-names: ["默认队列"];
    in-out property <int> queue-index: 0;
    in-out property <string> extensions;
    in-out property <string> includes;
    in-out property <string> excludes;
    in-out property <string> max-depth: "2";
    in-out property <string> max-pages: "500";
    in-out property <string> concurrency: "2";
    in-out property <string> sync-interval: "0";
    in-out property <bool> same-origin: true;
    in-out property <bool> offline: false;
    in-out property <bool> creating: true;
    in-out property <int> project-index: 0;
    in property <[string]> projects;
    in property <[ResourceRow]> rows;
    in property <bool> has-torrent-selection;
    in property <bool> busy;
    in property <string> status;
    // 页脚状态语气：info / success / warning / error，由 Rust 随状态文字一起设置。
    in property <string> status-tone: "warning";
    in property <string> summary;
    private property <bool> form-only: root.mode == "crawl" && root.creating && root.rows.length == 0;
    callback action(string);
    callback toggle(string, bool);
    callback select-project(int);
    callback queue-selected(int);
    main-layout := VerticalLayout {
        spacing: 0px;
        VerticalLayout {
        padding: 20px; padding-left: 24px; padding-right: 24px; spacing: 12px;
        if root.mode != "crawl" || root.creating: HorizontalLayout {
            spacing: 8px;
            // 页面抓取与下一行“保存目录”共用 80px 标签列、124px 按钮列，两个输入框左右缘都对齐。
            if root.mode == "harvest": FieldLabel { label: "页面地址"; width: 80px; }
            LineEdit { text <=> root.source; height: Tokens.control-height; placeholder-text: root.mode == "zip" ? "ZIP 本地路径或 HTTP 地址" : root.mode == "torrent" ? "种子路径或磁力链接" : "页面地址"; accessible-label: "资源来源"; enabled: !root.busy; }
            if root.mode == "zip" || root.mode == "torrent": HotButton { label: "选择文件"; icon: "folder"; enabled: !root.busy; clicked => { root.action("file"); } }
            HotButton { label: root.busy ? "处理中…" : "读取 / 发现"; icon: "search"; primary: true; min-width: root.mode == "harvest" ? 124px : 0px; enabled: !root.busy; clicked => { root.action("inspect"); } }
        }
        if root.mode == "crawl": HorizontalLayout {
            spacing: 8px;
            HotComboBox {
                model: root.projects; height: Tokens.control-height; enabled: !root.busy;
                property <int> bound: root.project-index;
                current-index: root.project-index;
                changed bound => { self.current-index = root.project-index; }
                selected(value) => { root.select-project(self.current-index); }
            }
            HotButton { label: "新项目"; icon: "new"; enabled: !root.busy; clicked => { root.action("new_project"); } }
            HotButton { label: "刷新"; icon: "refresh"; enabled: !root.busy; clicked => { root.action("list"); } }
        }
        if root.mode == "harvest": HorizontalLayout {
            spacing: 8px;
            FieldLabel { label: "保存目录"; width: 80px; } LineEdit { text <=> root.output-dir; height: Tokens.control-height; enabled: !root.busy; }
            HotButton { label: "浏览…"; icon: "folder"; width: 124px; enabled: !root.busy; clicked => { root.action("folder"); } }
        }
        // 抓站表单放进与设置页相同的卡片：卡片右缘与上方输入行对齐，滚动条落在卡片内边距里，不压住输入框。
        if root.mode == "crawl" && root.creating: Rectangle {
            min-height: root.form-only ? 160px : 136px; preferred-height: 372px; vertical-stretch: root.form-only ? 1 : 0;
            background: Tokens.surface; border-radius: Tokens.card-radius; border-width: 1px; border-color: Tokens.line;
            HotScrollView {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            enabled: !root.busy;
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.width;
            VerticalLayout {
                padding: 16px; spacing: 12px; alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { label: "保存目录"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.output-dir; }
                    HotButton { label: "浏览…"; icon: "folder"; clicked => { root.action("folder"); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { spacing: 6px; FieldLabel { label: "最大深度 0–10"; } LineEdit { height: Tokens.control-height; text <=> root.max-depth; } }
                    VerticalLayout { spacing: 6px; FieldLabel { label: "最多页面 1–500"; } LineEdit { height: Tokens.control-height; text <=> root.max-pages; } }
                    VerticalLayout { spacing: 6px; FieldLabel { label: "页面并发 1–2"; } LineEdit { height: Tokens.control-height; text <=> root.concurrency; } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { spacing: 6px; FieldLabel { label: "扩展名（逗号分隔）"; } LineEdit { height: Tokens.control-height; text <=> root.extensions; } }
                    VerticalLayout { spacing: 6px; FieldLabel { label: "包含路径前缀"; } LineEdit { height: Tokens.control-height; text <=> root.includes; } }
                    VerticalLayout { spacing: 6px; FieldLabel { label: "排除路径前缀"; } LineEdit { height: Tokens.control-height; text <=> root.excludes; } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { label: "下载队列"; }
                        HotComboBox {
                            height: Tokens.control-height;
                            model: root.queue-names;
                            a11y-label: "下载队列";
                            property <int> bound: root.queue-index;
                            current-index: root.queue-index;
                            changed bound => { self.current-index = root.queue-index; }
                            selected(value) => {
                                root.queue-index = self.current-index;
                                root.queue-selected(self.current-index);
                            }
                        }
                    }
                    VerticalLayout { spacing: 6px; FieldLabel { label: "同步间隔秒（0 关闭，最少 60）"; } LineEdit { height: Tokens.control-height; text <=> root.sync-interval; } }
                }
                HotCheckBox { text: "只访问同源页面"; checked <=> root.same-origin; }
                HotCheckBox { text: "保存静态离线页面和引用资源"; checked <=> root.offline; }
            }
            }
        }
        if root.mode == "crawl" && !root.creating: HorizontalLayout {
            spacing: 8px;
            HotButton { label: "暂停发现"; icon: "pause"; enabled: !root.busy; clicked => { root.action("pause"); } }
            HotButton { label: "继续发现"; icon: "play"; enabled: !root.busy; clicked => { root.action("resume"); } }
            HotButton { label: "立即同步"; icon: "refresh"; enabled: !root.busy; clicked => { root.action("sync"); } }
        }
        // 新建抓站项目时还没有任何发现结果，隐藏空列表，把高度留给表单。
        if !root.form-only: HorizontalLayout {
            Text { text: root.mode == "zip" ? "归档内容" : root.mode == "torrent" ? "文件列表" : "发现的资源"; color: Tokens.ink; font-size: 15px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: root.rows.length + " 项"; color: Tokens.faint; font-size: 12px; vertical-alignment: center; }
        }
        if root.summary != "" && !root.form-only: Text { text: root.summary; color: Tokens.muted; font-size: 12px; wrap: word-wrap; }
        if !root.form-only: list-card := Rectangle {
        // 列表可滚动时，行高亮与文字给覆盖式滚动条让出右侧 12px，滚动条不压在选中行上。
        property <length> scroll-gutter: rows-list.viewport-height > rows-list.visible-height ? 12px : 0px;
        vertical-stretch: 1; min-height: 110px;
        background: Tokens.surface; border-radius: Tokens.card-radius; border-width: 1px; border-color: Tokens.line; clip: true;
        if root.rows.length == 0: VerticalLayout {
            padding: 20px; spacing: 8px; alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px; height: 48px; border-radius: Tokens.card-radius; background: Tokens.surface-2;
                    WorkbenchIcon { name: root.mode == "zip" ? "archive" : root.mode == "torrent" ? "torrent" : root.mode == "crawl" ? "network" : "harvest"; width: 24px; height: 24px; x: 12px; y: 12px; ink: Tokens.faint; }
                }
            }
            Text { text: root.busy ? "正在读取资源…" : root.mode == "torrent" ? "没有可供选择的种子文件" : "填写来源后，点击「读取 / 发现」"; color: Tokens.faint; font-size: 13px; horizontal-alignment: center; }
        }
        rows-list := ListView {
            width: parent.width; height: parent.height;
            for row[index] in root.rows: Rectangle {
                height: 64px;
                if index < root.rows.length - 1: Rectangle { x: 16px; y: parent.height - 1px; height: 1px; width: parent.width - 32px - list-card.scroll-gutter; background: Tokens.hairline; }
                Rectangle { x: 5px; y: 3px; width: parent.width - 10px - list-card.scroll-gutter; height: parent.height - 6px; border-radius: Tokens.control-radius; background: row.selected ? Tokens.selected : transparent; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px + list-card.scroll-gutter; spacing: 10px;
                    if root.mode != "zip": HotCheckBox { width: 20px; checked <=> row.selected; accessible-label: "选择 " + row.label; enabled: !root.busy; toggled => { root.toggle(row.id, self.checked); } }
                    Rectangle {
                        width: 36px; height: 36px; y: (parent.height - self.height) / 2; border-radius: Tokens.card-radius;
                        background: row.selected ? Tokens.accent-soft : Tokens.surface-2;
                        WorkbenchIcon { name: "file"; ink: row.selected ? Tokens.accent : Tokens.faint; width: 18px; height: 18px; x: 9px; y: 9px; }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 3px;
                        Text { text: row.label; color: Tokens.ink; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: row.detail; color: Tokens.muted; font-size: 11px; overflow: elide; }
                    }
                }
            }
        }
        ScrollCue {
            x: parent.width - self.width; y: 0px; height: parent.height;
            viewport-y: rows-list.viewport-y; viewport-height: rows-list.viewport-height; visible-height: rows-list.visible-height;
        }
        }
        }
        DialogFooter {
            status: root.status; tone: root.status-tone;
            HotButton { label: "关闭"; clicked => { root.action("close"); } }
            if root.mode != "zip" && root.rows.length > 0: HotButton { label: "全选"; enabled: !root.busy; clicked => { root.action("select_all"); } }
            if root.mode != "zip" && root.rows.length > 0: HotButton { label: "清空选择"; enabled: !root.busy; clicked => { root.action("select_none"); } }
            if root.mode == "harvest": HotButton { label: "探测所选"; icon: "search"; enabled: !root.busy; clicked => { root.action("probe"); } }
            if root.mode != "zip" && !(root.mode == "crawl" && root.creating): HotButton {
                label: root.mode == "torrent" ? "保存文件选择" : "下载所选"; primary: true;
                enabled: !root.busy && (root.mode != "torrent" || root.has-torrent-selection);
                clicked => { root.action("download"); }
            }
        }
    }
}
