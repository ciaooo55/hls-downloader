import { ScrollView, ListView, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";
import { Tokens, HotButton, FieldLabel } from "theme.slint";
import { DialogHeader, DialogFooter } from "dialog_components.slint";
import { WorkbenchIcon } from "workbench_components.slint";

export struct ResourceRow { id: string, label: string, detail: string, selected: bool }

export component ResourceToolsWindow inherits Window {
    icon: @image-url("../../assets/app-icon.png");
    title: root.mode == "zip" ? "ZIP 内容预览" : root.mode == "crawl" ? "抓站与同步项目" : root.mode == "torrent" ? "种子文件选择" : "页面资源抓取";
    background: Tokens.canvas; default-font-family: Tokens.type-face; default-font-size: 13px;
    preferred-width: 880px; preferred-height: 720px; min-width: 640px; min-height: 420px;
    in property <string> mode;
    in-out property <string> source;
    in-out property <string> output-dir;
    in-out property <string> queue-id: "default";
    in-out property <string> extensions;
    in-out property <string> includes;
    in-out property <string> excludes;
    in-out property <string> max-depth: "2";
    in-out property <string> max-pages: "500";
    in-out property <string> concurrency: "2";
    in-out property <string> sync-interval: "0";
    in-out property <bool> same-origin: true;
    in-out property <bool> offline: false;
    in-out property <bool> creating: true;
    in-out property <int> project-index: 0;
    in property <[string]> projects;
    in property <[ResourceRow]> rows;
    in property <bool> busy;
    in property <string> status;
    in property <string> summary;
    callback action(string);
    callback toggle(string, bool);
    callback select-project(int);
    VerticalLayout {
        spacing: 0px;
        DialogHeader {
            heading: root.title;
            description: root.mode == "zip" ? "先查看归档内容，再决定需要下载的文件" : root.mode == "crawl" ? "发现站点资源，保存离线页面并按计划同步" : root.mode == "torrent" ? "选择需要下载的文件，保留已有任务与进度" : "发现页面链接，探测并批量添加下载";
            icon: root.mode == "zip" ? "archive" : root.mode == "torrent" ? "torrent" : root.mode == "crawl" ? "network" : "harvest";
        }
        VerticalLayout {
        padding: 20px; spacing: 12px;
        if root.mode != "crawl" || root.creating: HorizontalLayout {
            spacing: 8px;
            LineEdit { text <=> root.source; height: Tokens.control-height; placeholder-text: root.mode == "zip" ? "ZIP 本地路径或 HTTP 地址" : root.mode == "torrent" ? "种子路径或磁力链接" : "页面地址"; accessible-label: "资源来源"; enabled: !root.busy; }
            if root.mode == "zip" || root.mode == "torrent": HotButton { label: "选择文件"; icon: "folder"; enabled: !root.busy; clicked => { root.action("file"); } }
            HotButton { label: root.busy ? "处理中…" : "读取 / 发现"; icon: "search"; primary: true; enabled: !root.busy; clicked => { root.action("inspect"); } }
        }
        if root.mode == "crawl": HorizontalLayout {
            spacing: 8px;
            ComboBox { model: root.projects; current-index: root.project-index; height: Tokens.control-height; enabled: !root.busy; selected(value) => { root.select-project(self.current-index); } }
            HotButton { label: "新项目"; icon: "new"; enabled: !root.busy; clicked => { root.action("new_project"); } }
            HotButton { label: "刷新"; icon: "refresh"; enabled: !root.busy; clicked => { root.action("list"); } }
        }
        if root.mode == "harvest": HorizontalLayout {
            spacing: 8px;
            FieldLabel { label: "保存目录"; width: 65px; } LineEdit { text <=> root.output-dir; height: Tokens.control-height; enabled: !root.busy; }
            HotButton { label: "浏览…"; icon: "folder"; enabled: !root.busy; clicked => { root.action("folder"); } }
        }
        if root.mode == "crawl" && root.creating: ScrollView {
            min-height: 160px; preferred-height: 260px; enabled: !root.busy;
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.width;
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { label: "保存目录"; width: 80px; } LineEdit { height: Tokens.control-height; text <=> root.output-dir; }
                    HotButton { label: "浏览…"; icon: "folder"; clicked => { root.action("folder"); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { FieldLabel { label: "最大深度 0–10"; } LineEdit { height: Tokens.control-height; text <=> root.max-depth; } }
                    VerticalLayout { FieldLabel { label: "最多页面 1–500"; } LineEdit { height: Tokens.control-height; text <=> root.max-pages; } }
                    VerticalLayout { FieldLabel { label: "页面并发 1–2"; } LineEdit { height: Tokens.control-height; text <=> root.concurrency; } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { FieldLabel { label: "扩展名（逗号分隔）"; } LineEdit { height: Tokens.control-height; text <=> root.extensions; } }
                    VerticalLayout { FieldLabel { label: "包含路径前缀"; } LineEdit { height: Tokens.control-height; text <=> root.includes; } }
                    VerticalLayout { FieldLabel { label: "排除路径前缀"; } LineEdit { height: Tokens.control-height; text <=> root.excludes; } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { FieldLabel { label: "队列 ID"; } LineEdit { height: Tokens.control-height; text <=> root.queue-id; } }
                    VerticalLayout { FieldLabel { label: "同步间隔秒（0 关闭，最少 60）"; } LineEdit { height: Tokens.control-height; text <=> root.sync-interval; } }
                }
                CheckBox { text: "只访问同源页面"; checked <=> root.same-origin; }
                CheckBox { text: "保存静态离线页面和引用资源"; checked <=> root.offline; }
            }
        }
        if root.mode == "crawl" && !root.creating: HorizontalLayout {
            spacing: 8px;
            HotButton { label: "暂停发现"; icon: "pause"; enabled: !root.busy; clicked => { root.action("pause"); } }
            HotButton { label: "继续发现"; icon: "play"; enabled: !root.busy; clicked => { root.action("resume"); } }
            HotButton { label: "立即同步"; icon: "refresh"; enabled: !root.busy; clicked => { root.action("sync"); } }
        }
        HorizontalLayout {
            Text { text: root.mode == "zip" ? "归档内容" : root.mode == "torrent" ? "文件列表" : "发现的资源"; color: Tokens.ink; font-size: 15px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: root.rows.length + " 项"; color: Tokens.faint; font-size: 12px; vertical-alignment: center; }
        }
        if root.summary != "": Text { text: root.summary; color: Tokens.muted; font-size: 12px; wrap: word-wrap; }
        Rectangle {
        vertical-stretch: 1; min-height: 110px;
        background: Tokens.surface; border-radius: 10px; border-width: 1px; border-color: Tokens.line; clip: true;
        if root.rows.length == 0: VerticalLayout {
            padding: 20px; spacing: 8px; alignment: center;
            HorizontalLayout {
                alignment: center;
                WorkbenchIcon { name: root.mode == "zip" ? "archive" : root.mode == "torrent" ? "torrent" : root.mode == "crawl" ? "network" : "harvest"; width: 30px; height: 30px; ink: Tokens.faint; }
            }
            Text { text: root.busy ? "正在读取资源…" : "填写来源后，点击「读取 / 发现」"; color: Tokens.faint; font-size: 13px; horizontal-alignment: center; }
        }
        ListView {
            width: parent.width; height: parent.height;
            for row in root.rows: Rectangle {
                height: 64px; background: row.selected ? Tokens.selected : Tokens.surface;
                Rectangle { x: 16px; y: parent.height - 1px; height: 1px; width: parent.width - 32px; background: Tokens.hairline; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                    if root.mode != "zip": CheckBox { checked <=> row.selected; accessible-label: "选择 " + row.label; enabled: !root.busy; toggled => { root.toggle(row.id, self.checked); } }
                    WorkbenchIcon { name: "file"; ink: row.selected ? Tokens.accent : Tokens.faint; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
                    VerticalLayout {
                        alignment: center; spacing: 5px;
                        Text { text: row.label; color: Tokens.ink; overflow: elide; }
                        Text { text: row.detail; color: Tokens.muted; font-size: 11px; overflow: elide; }
                    }
                }
            }
        }
        }
        }
        DialogFooter {
            status: root.status;
            HotButton { label: "关闭"; clicked => { root.action("close"); } }
            if root.mode != "zip": HotButton { label: "全选"; enabled: !root.busy; clicked => { root.action("select_all"); } }
            if root.mode != "zip": HotButton { label: "清空选择"; enabled: !root.busy; clicked => { root.action("select_none"); } }
            if root.mode == "harvest": HotButton { label: "探测所选"; icon: "search"; enabled: !root.busy; clicked => { root.action("probe"); } }
            if root.mode != "zip" && !(root.mode == "crawl" && root.creating): HotButton {
                label: root.mode == "torrent" ? "保存文件选择" : "下载所选"; primary: true; enabled: !root.busy;
                clicked => { root.action("download"); }
            }
        }
    }
}
