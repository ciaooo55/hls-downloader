import { CheckBox, ComboBox, LineEdit, TextEdit } from "std-widgets.slint";

export struct TaskRow {
    task_id: string,
    title: string,
    filename: string,
    status: string,
    progress: float,
    ranges: float,
    speed: string,
    size: string,
    workers: string,
    eta: string,
    kind: string,
    live: bool,
    accent: color,
    picked: bool,
    map_cells: [int],
}

export struct HarvestRow {
    url: string,
    label: string,
    category: string,
    detail: string,
    picked: bool,
}

export global Tokens {
    in-out property <bool> dark: false;
    in-out property <bool> reduce-motion: false;
    out property <duration> motion: reduce-motion ? 1ms : 160ms;
    out property <duration> motion-fast: reduce-motion ? 1ms : 90ms;
    // Segoe carries Latin UI; Windows font-links CJK to Microsoft YaHei UI.
    out property <string> type-face: "Segoe UI Variable";
    out property <length> type-caption: 11px;
    out property <length> type-body: 12px;
    out property <length> type-row: 13px;
    out property <length> type-title: 14px;
    out property <length> space-micro: 2px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> row-height: 52px;
    out property <length> bar-height: 48px;
    out property <length> rail-width: 176px;
    out property <length> col-name: 268px;
    out property <length> col-status: 96px;
    out property <length> col-speed: 88px;
    out property <length> col-size: 76px;
    out property <length> col-actions: 108px;
    out property <length> track: 6px;
    out property <length> scrubber: 10px;
    out property <length> control-radius: 6px;
    out property <length> panel-radius: 8px;
    out property <color> bg: dark ? #0b1220 : #eef2f6;
    out property <color> surface: dark ? #121a2b : #ffffff;
    out property <color> surface-2: dark ? #172033 : #f5f7fa;
    out property <color> surface-3: dark ? #243047 : #e8edf3;
    out property <color> ink: dark ? #e8eef8 : #0f172a;
    out property <color> muted: dark ? #a8b3c7 : #475569;
    out property <color> faint: dark ? #7f8ba3 : #64748b;
    out property <color> accent: dark ? #3b82f6 : #2563eb;
    out property <color> accent-hover: dark ? #60a5fa : #1d4ed8;
    out property <color> accent-soft: dark ? #1e3a8a : #dbeafe;
    out property <color> on-accent: #ffffff;
    out property <color> done: dark ? #22c55e : #16a34a;
    out property <color> warn: dark ? #f59e0b : #d97706;
    out property <color> fail: dark ? #ef4444 : #dc2626;
    out property <color> line: dark ? #2a364c : #d8dee8;
    out property <color> stage: #0b1220;
    out property <color> on-stage: #e8eef8;
    out property <color> on-stage-muted: #a8b3c7;
}

component ChromeBtn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked;
    min-width: compact ? 32px : 36px;
    height: compact ? 28px : 32px;
    border-radius: Tokens.control-radius;
    background: !enabled ? Tokens.surface-3 : (touch.has-hover ? (primary ? Tokens.accent-hover : Tokens.surface-3) : (primary ? Tokens.accent : (danger ? Tokens.surface : Tokens.surface-2)));
    border-width: primary ? 0px : 1px;
    border-color: danger ? Tokens.fail : Tokens.line;
    opacity: enabled ? 1.0 : 0.45;
    animate background { duration: Tokens.motion-fast; easing: ease-out; }
    HorizontalLayout {
        padding-left: compact ? Tokens.space-2 : Tokens.space-3;
        padding-right: compact ? Tokens.space-2 : Tokens.space-3;
        Text {
            text: label;
            color: primary ? Tokens.on-accent : (danger ? Tokens.fail : Tokens.ink);
            font-size: Tokens.type-body;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ConnectionBar inherits HorizontalLayout {
    in property <[int]> cells;
    in property <color> fill;
    spacing: 1px;
    min-height: Tokens.track;
    for cell in cells : Rectangle {
        horizontal-stretch: 1;
        min-width: 2px;
        height: Tokens.track;
        border-radius: 1px;
        background: cell == 2 ? Tokens.done : (cell == 1 ? fill : Tokens.line);
    }
}

component RangeCell inherits Rectangle {
    in property <bool> on;
    in property <color> fill;
    width: 6px;
    height: 10px;
    border-radius: 2px;
    background: on ? fill : Tokens.line;
    animate background { duration: Tokens.motion; easing: ease-out; }
}

component RangeMosaic inherits HorizontalLayout {
    in property <float> filled;
    in property <color> fill;
    spacing: Tokens.space-micro;
    alignment: center;
    RangeCell { on: filled > 0.00; fill: root.fill; }
    RangeCell { on: filled > 0.125; fill: root.fill; }
    RangeCell { on: filled > 0.25; fill: root.fill; }
    RangeCell { on: filled > 0.375; fill: root.fill; }
    RangeCell { on: filled > 0.50; fill: root.fill; }
    RangeCell { on: filled > 0.625; fill: root.fill; }
    RangeCell { on: filled > 0.75; fill: root.fill; }
    RangeCell { on: filled > 0.875; fill: root.fill; }
}

component StatusChip inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    height: 20px;
    border-radius: Tokens.control-radius;
    background: Tokens.surface-3;
    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-1;
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: fill;
        }
        Text {
            text: label;
            color: Tokens.ink;
            font-size: Tokens.type-caption;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <string> count;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: Tokens.control-radius;
    background: selected ? Tokens.accent-soft : (touch.has-hover ? Tokens.surface : transparent);
    animate background { duration: Tokens.motion-fast; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        Text {
            text: label;
            color: selected ? Tokens.accent : Tokens.ink;
            vertical-alignment: center;
            font-size: Tokens.type-body;
            font-weight: selected ? 600 : 500;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: count;
            color: selected ? Tokens.accent : Tokens.muted;
            vertical-alignment: center;
            font-size: Tokens.type-caption;
            font-weight: 600;
        }
    }
}

component SectionLabel inherits Text {
    in property <string> label;
    text: label;
    color: Tokens.muted;
    font-size: Tokens.type-caption;
    font-weight: 700;
}

component HelpText inherits Text {
    in property <string> label;
    text: label;
    color: Tokens.muted;
    font-size: Tokens.type-caption;
    wrap: word-wrap;
}

component FieldLine inherits HorizontalLayout {
    in property <string> caption;
    spacing: Tokens.space-2;
    alignment: center;
    Text {
        text: caption;
        color: Tokens.muted;
        vertical-alignment: center;
        font-size: Tokens.type-body;
        font-weight: 600;
        min-width: 128px;
    }
    @children
}

component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: Tokens.control-radius;
    background: selected ? Tokens.accent-soft : (touch.has-hover ? Tokens.surface : transparent);
    animate background { duration: Tokens.motion-fast; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        Text {
            text: label;
            color: selected ? Tokens.accent : Tokens.ink;
            font-size: Tokens.type-body;
            font-weight: selected ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

component WindowHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: Tokens.bar-height;
    background: Tokens.surface;
    HorizontalLayout {
        padding-left: Tokens.space-4;
        padding-right: Tokens.space-4;
        spacing: Tokens.space-3;
        Text {
            text: title;
            color: Tokens.ink;
            font-size: Tokens.type-title;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: subtitle;
            color: Tokens.muted;
            font-size: Tokens.type-caption;
            vertical-alignment: center;
        }
    }
}

component FooterBar inherits Rectangle {
    height: Tokens.row-height;
    background: Tokens.surface;
    HorizontalLayout {
        padding-left: Tokens.space-4;
        padding-right: Tokens.space-4;
        spacing: Tokens.space-2;
        alignment: center;
        @children
    }
}

component GroupCard inherits Rectangle {
    border-radius: Tokens.panel-radius;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.line;
    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-2;
        @children
    }
}

component OverlayKicker inherits Text {
    in property <string> label;
    in property <color> fill: Tokens.muted;
    text: label;
    color: fill;
    font-size: Tokens.type-caption;
    font-weight: 600;
}

component BandLabel inherits Text {
    in property <string> label;
    text: label;
    color: Tokens.muted;
    font-size: Tokens.type-caption;
    font-weight: 700;
    vertical-alignment: center;
}

component TaskRowView inherits Rectangle {
    in property <TaskRow> task;
    in property <bool> chosen;
    callback selected;
    callback reorder(int);
    callback action(string);
    property <int> last-delta: 0;
    height: Tokens.row-height;
    border-radius: Tokens.control-radius;
    background: chosen ? Tokens.accent-soft : (touch.has-hover ? Tokens.surface : transparent);
    animate background { duration: Tokens.motion-fast; easing: ease-out; }
    touch := TouchArea {
        changed pressed => {
            if (self.pressed) {
                root.last-delta = 0;
            }
        }
        clicked => { root.selected(); }
        moved => {
            if (self.pressed) {
                let d = floor((self.mouse-y - self.pressed-y) / 52px);
                if (d != root.last-delta) {
                    let step = d - root.last-delta;
                    if (step != 0) {
                        root.reorder(step);
                    }
                    root.last-delta = d;
                }
            }
        }
            HorizontalLayout {
            padding-left: Tokens.space-3;
            padding-right: Tokens.space-3;
            spacing: Tokens.space-3;
            alignment: center;
            TouchArea {
                width: 18px;
                height: 18px;
                clicked => { root.action("toggle"); }
                Text {
                    text: task.picked ? "▣" : "▢";
                    color: task.picked ? Tokens.accent : Tokens.muted;
                    font-size: Tokens.type-title;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                width: Tokens.col-name;
                alignment: center;
                spacing: Tokens.space-micro;
                Text {
                    text: task.title;
                    color: Tokens.ink;
                    font-size: Tokens.type-row;
                    font-weight: 600;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Text {
                        text: task.kind;
                        color: Tokens.accent;
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                    }
                    Text {
                        text: task.filename;
                        color: Tokens.muted;
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Tokens.space-1;
                Rectangle {
                    height: Tokens.track;
                    border-radius: 3px;
                    background: Tokens.line;
                    clip: true;
                    if task.map_cells.length > 0 : ConnectionBar {
                        width: 100%;
                        cells: task.map_cells;
                        fill: task.accent;
                    }
                    if task.map_cells.length == 0 : Rectangle {
                        x: 0px;
                        width: parent.width * task.progress;
                        height: parent.height;
                        border-radius: 3px;
                        background: task.accent;
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    RangeMosaic { filled: task.ranges; fill: task.accent; }
                    Text {
                        text: task.workers;
                        color: Tokens.muted;
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: task.eta;
                        color: Tokens.muted;
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            StatusChip {
                width: Tokens.col-status;
                label: task.status;
                fill: task.live ? task.accent : (task.status == "失败" ? Tokens.fail : (task.status == "已完成" ? Tokens.done : Tokens.muted));
            }
            Text {
                width: Tokens.col-speed;
                text: task.speed;
                color: task.live ? Tokens.accent : Tokens.muted;
                font-size: Tokens.type-body;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                width: Tokens.col-size;
                text: task.size;
                color: Tokens.muted;
                font-size: Tokens.type-body;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            HorizontalLayout {
                width: Tokens.col-actions;
                spacing: Tokens.space-1;
                alignment: center;
                opacity: touch.has-hover || chosen ? 1 : 0;
                ChromeBtn {
                    label: "开";
                    compact: true;
                    enabled: touch.has-hover || chosen;
                    clicked => { root.action("open"); }
                }
                ChromeBtn {
                    label: task.live ? "停" : "起";
                    compact: true;
                    enabled: touch.has-hover || chosen;
                    clicked => { root.action(task.live ? "pause" : "start"); }
                }
            }
        }
    }
}

component EmptyHint inherits Rectangle {
    vertical-stretch: 1;
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: start;
            spacing: Tokens.space-2;
            width: 420px;
            padding-top: 24px;
            Text {
                text: "还没有任务";
                color: Tokens.ink;
                font-size: Tokens.type-title;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "点「新建」粘贴链接，或从浏览器接管下载。确认窗已经预热，点击即出。";
                color: Tokens.muted;
                font-size: Tokens.type-body;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}

export component LegalWindow inherits Window {
    title: "使用前请确认";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    always-on-top: true;
    preferred-width: 460px;
    preferred-height: 280px;
    background: Tokens.surface;
    in-out property <bool> agreed;
    callback command(string);
    VerticalLayout {
        padding: Tokens.space-5;
        spacing: Tokens.space-3;
        Text { text: "使用前请确认"; color: Tokens.ink; font-size: Tokens.type-title; font-weight: 700; }
        Text {
            text: "本工具只下载你有权保存的内容，不绕过 DRM，也不提供破解。请阅读用户协议后再继续。";
            color: Tokens.muted;
            font-size: Tokens.type-row;
            wrap: word-wrap;
        }
        CheckBox { text: "已阅读并同意用户协议"; checked <=> root.agreed; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: Tokens.space-2;
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn {
                label: "同意并继续";
                primary: true;
                enabled: root.agreed;
                clicked => { root.command("accept_legal"); }
            }
        }
    }
}

export component ConfirmWindow inherits Window {
    title: "确认下载";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    always-on-top: true;
    no-frame: false;
    preferred-width: 420px;
    preferred-height: 228px;
    background: Tokens.surface;
    in-out property <string> filename;
    in-out property <string> url;
    in-out property <string> size_text;
    in-out property <string> remaining;
    callback command(string);
    VerticalLayout {
        padding: Tokens.space-5;
        spacing: Tokens.space-3;
        OverlayKicker { label: "确认下载"; }
        LineEdit { text <=> root.filename; }
        Text { text: url; color: Tokens.muted; font-size: Tokens.type-body; overflow: elide; }
        Text { text: size_text; color: Tokens.ink; font-size: Tokens.type-row; font-weight: 600; }
        Text {
            text: root.remaining;
            color: Tokens.muted;
            font-size: Tokens.type-caption;
            visible: root.remaining != "";
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: Tokens.space-2;
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "拒绝"; clicked => { root.command("reject"); } }
            ChromeBtn { label: "开始下载"; primary: true; clicked => { root.command("accept"); } }
        }
    }
}

export component ProgressWindow inherits Window {
    title: headline;
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    preferred-width: 380px;
    preferred-height: 156px;
    background: Tokens.surface;
    in-out property <string> headline: "下载进度";
    in-out property <string> filename;
    in-out property <string> speed;
    in-out property <float> progress;
    callback command(string);
    VerticalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-3;
        OverlayKicker { label: headline; }
        Text { text: filename; color: Tokens.ink; font-size: Tokens.type-title; font-weight: 600; overflow: elide; }
        HorizontalLayout {
            Text { text: speed; color: Tokens.accent; font-size: Tokens.type-body; font-weight: 600; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "\{Math.round(root.progress * 100)}%";
                color: Tokens.muted;
                font-size: Tokens.type-body;
                font-weight: 600;
            }
        }
        Rectangle {
            height: Tokens.track;
            border-radius: 3px;
            background: Tokens.surface-3;
            clip: true;
            Rectangle {
                x: 0px;
                width: parent.width * root.progress;
                height: parent.height;
                border-radius: 3px;
                background: Tokens.accent;
                animate width { duration: Tokens.motion; easing: ease-out; }
            }
        }
        HorizontalLayout {
            spacing: Tokens.space-2;
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "暂停"; clicked => { root.command("pause"); } }
            ChromeBtn { label: "取消"; danger: true; clicked => { root.command("cancel"); } }
        }
    }
}

export component CompleteWindow inherits Window {
    title: "下载完成";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    always-on-top: true;
    preferred-width: 420px;
    preferred-height: 176px;
    background: Tokens.surface;
    in-out property <string> filename;
    in-out property <string> power_hint;
    callback command(string);
    VerticalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-3;
        OverlayKicker { label: "已完成"; fill: Tokens.done; }
        Text { text: filename; color: Tokens.ink; font-size: Tokens.type-title; font-weight: 600; overflow: elide; }
        Text {
            text: root.power_hint;
            color: Tokens.warn;
            font-size: Tokens.type-body;
            wrap: word-wrap;
            visible: root.power_hint != "";
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: Tokens.space-2;
            ChromeBtn { label: "打开文件"; primary: true; clicked => { root.command("open_file"); } }
            ChromeBtn { label: "打开目录"; clicked => { root.command("open_folder"); } }
            Rectangle { horizontal-stretch: 1; }
            if root.power_hint != "" : ChromeBtn {
                label: "取消关机";
                danger: true;
                clicked => { root.command("cancel_power"); }
            }
            ChromeBtn { label: "关闭"; clicked => { root.command("hide_complete"); } }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "设置";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    preferred-width: 720px;
    preferred-height: 640px;
    background: Tokens.bg;
    in-out property <string> settings_tab: "general";
    in-out property <bool> legal_accepted;
    in-out property <bool> takeover_enabled;
    in-out property <string> speed_limit;
    in-out property <bool> schedule_enabled;
    in-out property <string> schedule_start: "22:00";
    in-out property <string> schedule_end: "08:00";
    in-out property <string> schedule_kib: "512";
    in-out property <bool> auto_category;
    in-out property <string> category_dir_media;
    in-out property <string> category_dir_program;
    in-out property <string> category_dir_archive;
    in-out property <string> category_dir_other;
    in-out property <string> queue_max: "3";
    in-out property <string> site_rules;
    in-out property <bool> av_scan;
    in-out property <string> av_scan_command;
    in-out property <string> torrent_watch;
    in-out property <string> download_dir;
    in-out property <string> default_concurrency: "12";
    in-out property <string> proxy_url;
    in-out property <string> ffmpeg_path;
    in-out property <bool> clipboard_watch;
    in-out property <bool> completion_sound;
    in-out property <bool> progress_window;
    in-out property <bool> complete_popup;
    in-out property <bool> resume_interrupted;
    in-out property <string> auto_retry_max: "0";
    in-out property <string> existing_file_policy: "rename";
    in-out property <string> live_max_minutes: "0";
    in-out property <bool> download_subtitles: true;
    in-out property <bool> skip_ad_segments: true;
    in-out property <bool> keep_temp_files;
    in-out property <string> default_user_agent;
    in-out property <string> tvbox_endpoint;
    in-out property <bool> allow_duplicate;
    in-out property <bool> queue_auto_start;
    in-out property <string> queue_auto_start_time: "00:00";
    in-out property <bool> queue_auto_stop;
    in-out property <string> queue_auto_stop_time: "07:30";
    in-out property <string> default_referer;
    in-out property <string> http_chunk_size_mb: "8";
    in-out property <string> completion_power_action: "none";
    in-out property <bool> start_on_login;
    in-out property <string> site_host;
    in-out property <string> site_conn: "12";
    in-out property <string> site_speed;
    in-out property <string> site_proxy;
    callback command(string);
    VerticalLayout {
        spacing: 0px;
        WindowHeader { title: "设置"; subtitle: "界面、下载行为与运行环境"; }
        Rectangle { height: 1px; background: Tokens.line; }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: Tokens.rail-width;
                background: Tokens.surface-2;
                VerticalLayout {
                    padding: Tokens.space-3;
                    spacing: Tokens.space-micro;
                    SettingsTab { label: "通用"; selected: root.settings_tab == "general"; clicked => { root.settings_tab = "general"; } }
                    SettingsTab { label: "网络与下载"; selected: root.settings_tab == "network"; clicked => { root.settings_tab = "network"; } }
                    SettingsTab { label: "维护"; selected: root.settings_tab == "maintenance"; clicked => { root.settings_tab = "maintenance"; } }
                }
            }
            Rectangle { width: 1px; background: Tokens.line; }
            Flickable {
                vertical-stretch: 1;
                viewport-height: root.settings_tab == "general" ? 720px : (root.settings_tab == "network" ? 920px : 700px);
                VerticalLayout {
                    padding: Tokens.space-4;
                    spacing: Tokens.space-4;
                    if root.settings_tab == "general" : VerticalLayout {
                        spacing: Tokens.space-4;
                        GroupCard {
                            SectionLabel { label: "法律与接管"; }
                            CheckBox { text: "已阅读并同意用户协议"; checked <=> root.legal_accepted; }
                            CheckBox { text: "浏览器下载接管"; checked <=> root.takeover_enabled; }
                            CheckBox { text: "开机随 Windows 启动"; checked <=> root.start_on_login; }
                            CheckBox { text: "监视剪贴板链接"; checked <=> root.clipboard_watch; }
                            CheckBox { text: "显示进度小窗"; checked <=> root.progress_window; }
                            CheckBox { text: "显示完成弹窗"; checked <=> root.complete_popup; }
                            CheckBox { text: "完成提示音"; checked <=> root.completion_sound; }
                        }
                        GroupCard {
                            SectionLabel { label: "目录与分类"; }
                            FieldLine { caption: "下载目录"; LineEdit { text <=> root.download_dir; horizontal-stretch: 1; } }
                            CheckBox { text: "按分类自动分子文件夹"; checked <=> root.auto_category; }
                            HelpText { label: "分类目录留空则用下载目录\\中文分类名。填了就覆盖自动子目录。"; }
                            FieldLine { caption: "媒体"; LineEdit { text <=> root.category_dir_media; horizontal-stretch: 1; placeholder-text: "例如 E:\\Videos"; } }
                            FieldLine { caption: "程序"; LineEdit { text <=> root.category_dir_program; horizontal-stretch: 1; } }
                            FieldLine { caption: "压缩包"; LineEdit { text <=> root.category_dir_archive; horizontal-stretch: 1; } }
                            FieldLine { caption: "其他"; LineEdit { text <=> root.category_dir_other; horizontal-stretch: 1; } }
                        }
                    }
                    if root.settings_tab == "network" : VerticalLayout {
                        spacing: Tokens.space-4;
                        GroupCard {
                            SectionLabel { label: "连接与限速"; }
                            FieldLine { caption: "默认连接数"; LineEdit { text <=> root.default_concurrency; width: 80px; } }
                            FieldLine { caption: "同时下载数"; LineEdit { text <=> root.queue_max; width: 80px; } }
                            FieldLine { caption: "限速 KiB/s"; LineEdit { text <=> root.speed_limit; width: 100px; placeholder-text: "0 不限"; } }
                            FieldLine { caption: "HTTP 分块 MB"; LineEdit { text <=> root.http_chunk_size_mb; width: 80px; } }
                            CheckBox { text: "分时段限速"; checked <=> root.schedule_enabled; }
                            FieldLine {
                                caption: "限速时段";
                                LineEdit { text <=> root.schedule_start; width: 70px; }
                                Text { text: "至"; color: Tokens.muted; font-size: Tokens.type-body; font-weight: 600; vertical-alignment: center; }
                                LineEdit { text <=> root.schedule_end; width: 70px; }
                                LineEdit { text <=> root.schedule_kib; width: 80px; placeholder-text: "KiB/s"; }
                            }
                            CheckBox { text: "定时开始队列"; checked <=> root.queue_auto_start; }
                            CheckBox { text: "定时暂停队列"; checked <=> root.queue_auto_stop; }
                            FieldLine {
                                caption: "队列时刻";
                                LineEdit { text <=> root.queue_auto_start_time; width: 70px; }
                                LineEdit { text <=> root.queue_auto_stop_time; width: 70px; }
                            }
                        }
                        GroupCard {
                            SectionLabel { label: "代理与站点"; }
                            FieldLine { caption: "代理 URL"; LineEdit { text <=> root.proxy_url; horizontal-stretch: 1; } }
                            FieldLine { caption: "默认 Referer"; LineEdit { text <=> root.default_referer; horizontal-stretch: 1; } }
                            FieldLine { caption: "默认 UA"; LineEdit { text <=> root.default_user_agent; horizontal-stretch: 1; placeholder-text: "空则用 Chrome"; } }
                            HelpText { label: "站点规则 host=speed:KiB,conn:N,proxy:..."; }
                            FieldLine { caption: "主机"; LineEdit { text <=> root.site_host; horizontal-stretch: 1; placeholder-text: "cdn.example.com"; } }
                            FieldLine { caption: "连接 / 限速"; LineEdit { text <=> root.site_conn; width: 70px; } LineEdit { text <=> root.site_speed; width: 80px; placeholder-text: "KiB/s"; } }
                            FieldLine { caption: "代理"; LineEdit { text <=> root.site_proxy; horizontal-stretch: 1; } }
                            ChromeBtn { label: "添加这条规则"; clicked => { root.command("add_site_rule"); } }
                            TextEdit { text <=> root.site_rules; min-height: 80px; }
                        }
                    }
                    if root.settings_tab == "maintenance" : VerticalLayout {
                        spacing: Tokens.space-4;
                        GroupCard {
                            SectionLabel { label: "任务与文件"; }
                            CheckBox { text: "启动时恢复中断任务"; checked <=> root.resume_interrupted; }
                            CheckBox { text: "允许相同链接重复任务"; checked <=> root.allow_duplicate; }
                            CheckBox { text: "保留临时分段"; checked <=> root.keep_temp_files; }
                            FieldLine { caption: "失败重试"; LineEdit { text <=> root.auto_retry_max; width: 70px; } }
                            FieldLine { caption: "已存在文件"; LineEdit { text <=> root.existing_file_policy; width: 130px; placeholder-text: "rename/overwrite/skip"; } }
                        }
                        GroupCard {
                            SectionLabel { label: "媒体与完成"; }
                            CheckBox { text: "下载字幕轨道"; checked <=> root.download_subtitles; }
                            CheckBox { text: "跳过 HLS 广告标记分片"; checked <=> root.skip_ad_segments; }
                            FieldLine { caption: "直播最长分钟"; LineEdit { text <=> root.live_max_minutes; width: 70px; } }
                            FieldLine { caption: "FFmpeg"; LineEdit { text <=> root.ffmpeg_path; horizontal-stretch: 1; } }
                            FieldLine { caption: "TVBox"; LineEdit { text <=> root.tvbox_endpoint; horizontal-stretch: 1; } }
                            FieldLine { caption: "完成后电源"; LineEdit { text <=> root.completion_power_action; width: 140px; placeholder-text: "none/shutdown/sleep/hibernate"; } }
                            CheckBox { text: "完成后病毒扫描"; checked <=> root.av_scan; }
                            FieldLine { caption: "扫描命令"; LineEdit { text <=> root.av_scan_command; horizontal-stretch: 1; placeholder-text: "须含 {file}"; } }
                            FieldLine { caption: "种子监视"; LineEdit { text <=> root.torrent_watch; horizontal-stretch: 1; } }
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.line; }
        FooterBar {
            ChromeBtn { label: "检查更新"; clicked => { root.command("check_update"); } }
            ChromeBtn { label: "下载安装包"; clicked => { root.command("download_update"); } }
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "保存"; primary: true; clicked => { root.command("save_settings"); } }
        }
    }
}

export component NewTaskWindow inherits Window {
    title: "新建下载";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    preferred-width: 560px;
    preferred-height: 560px;
    background: Tokens.bg;
    in-out property <string> url;
    in-out property <string> filename;
    in-out property <bool> harvest;
    in-out property <string> recognize_label: "粘贴链接后点识别";
    in-out property <[string]> variants;
    in-out property <string> selected_variant;
    in-out property <[string]> audio_tracks;
    in-out property <string> selected_audio;
    in-out property <string> cookie;
    in-out property <string> referer;
    in-out property <string> checksum;
    in-out property <bool> allow_duplicate;
    in-out property <string> mirrors;
    in-out property <string> concurrency: "12";
    in-out property <string> body_path;
    in-out property <string> extra_headers;
    callback command(string);
    VerticalLayout {
        spacing: 0px;
        WindowHeader { title: "新建任务"; subtitle: "每行一个链接，或本地 .torrent / .url / .m3u8"; }
        Rectangle { height: 1px; background: Tokens.line; }
        VerticalLayout {
            padding: Tokens.space-4;
            spacing: Tokens.space-4;
            GroupCard {
                TextEdit { text <=> root.url; min-height: 88px; }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    ChromeBtn { label: "识别"; clicked => { root.command("probe"); } }
                    ChromeBtn { label: "抓取本页"; clicked => { root.command("harvest"); } }
                    ChromeBtn { label: "粘贴"; clicked => { root.command("paste"); } }
                    ChromeBtn { label: "导入文件"; clicked => { root.command("import_files"); } }
                    Text { text: root.recognize_label; color: Tokens.accent; font-size: Tokens.type-body; font-weight: 600; vertical-alignment: center; }
                }
                ComboBox {
                    model: root.variants;
                    current-value <=> root.selected_variant;
                }
                if root.audio_tracks.length > 1 : ComboBox {
                    model: root.audio_tracks;
                    current-value <=> root.selected_audio;
                }
            }
            GroupCard {
                FieldLine { caption: "文件名"; LineEdit { text <=> root.filename; horizontal-stretch: 1; placeholder-text: "可选，仅首条"; } }
                FieldLine { caption: "Referer"; LineEdit { text <=> root.referer; horizontal-stretch: 1; } }
                FieldLine { caption: "Cookie"; LineEdit { text <=> root.cookie; horizontal-stretch: 1; placeholder-text: "只进本机凭证，不写任务表"; } }
                FieldLine { caption: "校验和"; LineEdit { text <=> root.checksum; horizontal-stretch: 1; placeholder-text: "sha256: / md5: / sha1:"; } }
                FieldLine { caption: "镜像"; LineEdit { text <=> root.mirrors; horizontal-stretch: 1; placeholder-text: "每行一个备用 URL"; } }
                FieldLine { caption: "连接数"; LineEdit { text <=> root.concurrency; width: 80px; } }
                FieldLine { caption: "额外头"; LineEdit { text <=> root.extra_headers; horizontal-stretch: 1; placeholder-text: "Name: value，每行一个"; } }
                CheckBox { text: "抓取页面里的下载链接 / Metalink"; checked <=> root.harvest; }
                CheckBox { text: "允许与已有任务相同链接"; checked <=> root.allow_duplicate; }
            }
            Rectangle { vertical-stretch: 1; }
        }
        Rectangle { height: 1px; background: Tokens.line; }
        FooterBar {
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "开始"; primary: true; clicked => { root.command("create_task"); } }
        }
    }
}

export component PlayerWindow inherits Window {
    title: "HLS Downloader 播放器";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    preferred-width: 720px;
    preferred-height: 480px;
    background: Tokens.bg;
    in-out property <string> status;
    in-out property <[string]> devices;
    in-out property <string> selected_device;
    in-out property <int> preview-pct: 0;
    callback command(string);
    VerticalLayout {
        spacing: 0px;
        WindowHeader { title: "播放器"; subtitle: "同进程 libmpv · 画面嵌在本窗"; }
        Rectangle { height: 1px; background: Tokens.line; }
        Rectangle {
            vertical-stretch: 1;
            background: Tokens.stage;
            VerticalLayout {
                padding: Tokens.space-4;
                spacing: Tokens.space-2;
                alignment: center;
                Text { text: "画面由同进程 libmpv 画进这块区域。拖时间轴可预览帧。"; color: Tokens.on-stage-muted; font-size: Tokens.type-body; wrap: word-wrap; horizontal-alignment: center; }
                Text { text: status; color: Tokens.on-stage; font-size: Tokens.type-body; font-weight: 600; wrap: word-wrap; horizontal-alignment: center; }
            }
        }
        Rectangle { height: 1px; background: Tokens.line; }
        Rectangle {
            background: Tokens.surface;
            VerticalLayout {
                padding: Tokens.space-3;
                spacing: Tokens.space-3;
                Rectangle {
                    height: Tokens.scrubber;
                    border-radius: Tokens.control-radius;
                    background: Tokens.line;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: parent.width * root.preview-pct / 100;
                        height: parent.height;
                        border-radius: Tokens.control-radius;
                        background: Tokens.accent;
                    }
                    TouchArea {
                        clicked => {
                            root.preview-pct = max(0, min(100, 100 * self.mouse-x / parent.width));
                            root.command("preview:" + root.preview-pct);
                        }
                        moved => {
                            if (self.pressed) {
                                root.preview-pct = max(0, min(100, 100 * self.mouse-x / parent.width));
                                root.command("preview:" + root.preview-pct);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    alignment: center;
                    BandLabel { label: "播放"; }
                    ChromeBtn { label: "播放选中"; primary: true; clicked => { root.command("play"); } }
                    ChromeBtn { label: "暂停"; clicked => { root.command("pause"); } }
                    ChromeBtn { label: "继续"; clicked => { root.command("resume"); } }
                    ChromeBtn { label: "停止"; clicked => { root.command("stop"); } }
                    Rectangle { horizontal-stretch: 1; }
                    BandLabel { label: "投屏"; }
                    ChromeBtn { label: "扫描设备"; clicked => { root.command("scan_cast"); } }
                    ChromeBtn { label: "投屏"; clicked => { root.command("cast_device"); } }
                }
                ComboBox {
                    model: root.devices;
                    current-value <=> root.selected_device;
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    alignment: center;
                    BandLabel { label: "速度"; }
                    ChromeBtn { label: "0.5x"; compact: true; clicked => { root.command("speed:0.5"); } }
                    ChromeBtn { label: "1x"; compact: true; clicked => { root.command("speed:1"); } }
                    ChromeBtn { label: "1.5x"; compact: true; clicked => { root.command("speed:1.5"); } }
                    ChromeBtn { label: "2x"; compact: true; clicked => { root.command("speed:2"); } }
                    Rectangle { horizontal-stretch: 1; }
                    ChromeBtn { label: "全屏"; clicked => { root.command("fullscreen"); } }
                    ChromeBtn { label: "画中画"; clicked => { root.command("pip"); } }
                    ChromeBtn { label: "退出画中画"; clicked => { root.command("unpip"); } }
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    alignment: center;
                    BandLabel { label: "跳转"; }
                    ChromeBtn { label: "音量-"; clicked => { root.command("vol_down"); } }
                    ChromeBtn { label: "音量+"; clicked => { root.command("vol_up"); } }
                    ChromeBtn { label: "后退 10s"; clicked => { root.command("seek_back"); } }
                    ChromeBtn { label: "前进 10s"; clicked => { root.command("seek_fwd"); } }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "HLS Downloader";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    min-width: 1080px;
    min-height: 640px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Tokens.bg;

    in-out property <[TaskRow]> tasks;
    in-out property <string> search_text;
    in-out property <string> selected_filter: "全部";
    in-out property <bool> dark_mode: false;
    in-out property <string> all_count: "0";
    in-out property <string> downloading_count: "0";
    in-out property <string> queued_count: "0";
    in-out property <string> paused_count: "0";
    in-out property <string> processing_count: "0";
    in-out property <string> completed_count: "0";
    in-out property <string> failed_count: "0";
    in-out property <string> media_count: "0";
    in-out property <string> program_count: "0";
    in-out property <string> archive_count: "0";
    in-out property <string> other_count: "0";
    in-out property <string> selected_task: "";
    in-out property <string> detail_line: "选择任务查看连接、分段、日志和媒体轨道";
    in-out property <[int]> detail_map;
    in-out property <string> core_status: "Rust Core · 已连接";
    in-out property <string> toast_text: "";
    in-out property <string> browser_status: "插件未连接";
    in-out property <string> total_speed: "0 B/s";
    in-out property <[float]> speed_bars;
    callback command(string);
    callback wake();

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: Tokens.bar-height;
            background: Tokens.surface;
            HorizontalLayout {
                padding-left: Tokens.space-4;
                padding-right: Tokens.space-4;
                spacing: Tokens.space-2;
                Text {
                    text: "HLS Downloader";
                    color: Tokens.ink;
                    font-size: Tokens.type-row;
                    font-weight: 700;
                    letter-spacing: 0.2px;
                    vertical-alignment: center;
                }
                Text { text: "v6"; color: Tokens.accent; font-size: Tokens.type-caption; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 1px; height: 16px; y: 16px; background: Tokens.line; }
                ChromeBtn { label: "新建"; primary: true; clicked => { root.command("new_task"); } }
                ChromeBtn { label: "粘贴"; clicked => { root.command("paste_new"); } }
                ChromeBtn { label: "抓取"; clicked => { root.command("open_harvest"); } }
                ChromeBtn { label: "开始"; clicked => { root.command("start"); } }
                ChromeBtn { label: "暂停"; clicked => { root.command("pause"); } }
                ChromeBtn { label: "重试"; clicked => { root.command("retry"); } }
                ChromeBtn { label: "取消"; clicked => { root.command("cancel"); } }
                ChromeBtn { label: "打开"; clicked => { root.command("open"); } }
                ChromeBtn { label: "系统打开"; clicked => { root.command("launch"); } }
                ChromeBtn { label: "投屏"; clicked => { root.command("cast"); } }
                ChromeBtn { label: "TVBox"; clicked => { root.command("push_tvbox"); } }
                ChromeBtn { label: "删除"; danger: true; clicked => { root.command("delete"); } }
                ChromeBtn { label: "刷新"; clicked => { root.command("refresh"); } }
                Rectangle { horizontal-stretch: 1; }
                LineEdit {
                    width: 220px;
                    placeholder-text: "搜索文件名或标题";
                    text <=> root.search_text;
                    edited(text) => { root.command("search:" + text); }
                }
                ChromeBtn { label: "播放"; clicked => { root.command("play"); } }
                ChromeBtn { label: "插件"; clicked => { root.command("extension"); } }
                ChromeBtn { label: "更新"; clicked => { root.command("check_update"); } }
                ChromeBtn { label: "设置"; clicked => { root.command("settings"); } }
                ChromeBtn {
                    label: root.dark_mode ? "浅色" : "深色";
                    clicked => {
                        root.dark_mode = !root.dark_mode;
                        Tokens.dark = root.dark_mode;
                        root.command("dark");
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.line; }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: Tokens.rail-width;
                background: Tokens.surface-2;
                VerticalLayout {
                    padding: Tokens.space-3;
                    spacing: Tokens.space-micro;
                    Text { text: "队列"; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 700; }
                    SidebarItem { label: "全部"; count: root.all_count; selected: root.selected_filter == "全部"; clicked => { root.selected_filter = "全部"; root.command("filter:全部"); } }
                    SidebarItem { label: "下载中"; count: root.downloading_count; selected: root.selected_filter == "下载中"; clicked => { root.selected_filter = "下载中"; root.command("filter:下载中"); } }
                    SidebarItem { label: "排队中"; count: root.queued_count; selected: root.selected_filter == "排队中"; clicked => { root.selected_filter = "排队中"; root.command("filter:排队中"); } }
                    SidebarItem { label: "已暂停"; count: root.paused_count; selected: root.selected_filter == "已暂停"; clicked => { root.selected_filter = "已暂停"; root.command("filter:已暂停"); } }
                    SidebarItem { label: "本地处理中"; count: root.processing_count; selected: root.selected_filter == "本地处理中"; clicked => { root.selected_filter = "本地处理中"; root.command("filter:本地处理中"); } }
                    SidebarItem { label: "已完成"; count: root.completed_count; selected: root.selected_filter == "已完成"; clicked => { root.selected_filter = "已完成"; root.command("filter:已完成"); } }
                    SidebarItem { label: "失败"; count: root.failed_count; selected: root.selected_filter == "失败"; clicked => { root.selected_filter = "失败"; root.command("filter:失败"); } }
                    Rectangle { height: Tokens.space-3; }
                    Text { text: "分类"; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 700; }
                    SidebarItem { label: "媒体"; count: root.media_count; selected: root.selected_filter == "媒体"; clicked => { root.selected_filter = "媒体"; root.command("filter:媒体"); } }
                    SidebarItem { label: "程序"; count: root.program_count; selected: root.selected_filter == "程序"; clicked => { root.selected_filter = "程序"; root.command("filter:程序"); } }
                    SidebarItem { label: "压缩包"; count: root.archive_count; selected: root.selected_filter == "压缩包"; clicked => { root.selected_filter = "压缩包"; root.command("filter:压缩包"); } }
                    SidebarItem { label: "其他"; count: root.other_count; selected: root.selected_filter == "其他"; clicked => { root.selected_filter = "其他"; root.command("filter:其他"); } }
                    Rectangle { vertical-stretch: 1; }
                    ChromeBtn { label: "全部开始"; clicked => { root.command("start_all"); } }
                    ChromeBtn { label: "全部暂停"; clicked => { root.command("pause_all"); } }
                    ChromeBtn { label: "清空已完成"; clicked => { root.command("clear_completed"); } }
                    Text { text: root.core_status; color: Tokens.done; font-size: Tokens.type-caption; font-weight: 600; wrap: word-wrap; }
                    Text { text: root.browser_status; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 600; wrap: word-wrap; }
                }
            }
            Rectangle { width: 1px; background: Tokens.line; }
            Rectangle {
                horizontal-stretch: 1;
                background: Tokens.bg;
                VerticalLayout {
                    padding: Tokens.space-3;
                    spacing: Tokens.space-2;
                    HorizontalLayout {
                        height: 32px;
                        spacing: Tokens.space-2;
                        Text { text: root.selected_filter; color: Tokens.ink; font-size: Tokens.type-row; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ChromeBtn { label: "上移"; clicked => { root.command("queue_up"); } }
                        ChromeBtn { label: "下移"; clicked => { root.command("queue_down"); } }
                        ChromeBtn { label: "置顶"; clicked => { root.command("queue_top"); } }
                        ChromeBtn { label: "置底"; clicked => { root.command("queue_bottom"); } }
                        ChromeBtn { label: "复制链接"; clicked => { root.command("copy_url"); } }
                        ChromeBtn { label: "复制文件"; clicked => { root.command("copy_file"); } }
                        ChromeBtn { label: "日志"; clicked => { root.command("log"); } }
                        ChromeBtn { label: "导出列表"; clicked => { root.command("export_urls"); } }
                        ChromeBtn { label: "保存站点规则"; clicked => { root.command("save_site_profile"); } }
                        ChromeBtn { label: "删除文件"; danger: true; clicked => { root.command("delete_files"); } }
                    }
                    HorizontalLayout {
                        height: 20px;
                        padding-left: Tokens.space-3;
                        padding-right: Tokens.space-3;
                        spacing: Tokens.space-3;
                        Text { text: "名称"; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 600; width: Tokens.col-name; vertical-alignment: center; }
                        Text { text: "进度 / 分段"; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: "状态"; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 600; width: Tokens.col-status; horizontal-alignment: center; vertical-alignment: center; }
                        Text { text: "速度"; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 600; width: Tokens.col-speed; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: "大小"; color: Tokens.muted; font-size: Tokens.type-caption; font-weight: 600; width: Tokens.col-size; horizontal-alignment: right; vertical-alignment: center; }
                        Rectangle { width: Tokens.col-actions; }
                    }
                    if root.tasks.length == 0 : EmptyHint {}
                    if root.tasks.length > 0 : Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: root.tasks.length * 52px;
                        property <int> first-visible: max(0, floor(-self.viewport-y / 52px));
                        property <int> visible-count: min(root.tasks.length - first-visible, max(1, ceil(self.height / 52px) + 2));
                        for i in visible-count : TaskRowView {
                            y: (first-visible + i) * 52px;
                            height: Tokens.row-height;
                            width: parent.width;
                            task: root.tasks[first-visible + i];
                            chosen: root.tasks[first-visible + i].task_id == root.selected_task;
                            selected => {
                                root.selected_task = root.tasks[first-visible + i].task_id;
                                root.command("select:" + root.tasks[first-visible + i].task_id);
                            }
                            reorder(delta) => {
                                root.selected_task = root.tasks[first-visible + i].task_id;
                                root.command("select:" + root.tasks[first-visible + i].task_id);
                                root.command("reorder:\{delta}");
                            }
                            action(name) => {
                                root.selected_task = root.tasks[first-visible + i].task_id;
                                root.command("select:" + root.tasks[first-visible + i].task_id);
                                if (name == "toggle") {
                                    root.command("toggle:" + root.tasks[first-visible + i].task_id);
                                } else {
                                    root.command(name);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 28px;
                        spacing: Tokens.space-2;
                        alignment: end;
                        Text {
                            text: root.total_speed;
                            color: Tokens.accent;
                            font-size: Tokens.type-caption;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        for bar in root.speed_bars : Rectangle {
                            width: 3px;
                            height: 6px + 18px * bar;
                            border-radius: 1px;
                            background: Tokens.accent;
                            y: parent.height - self.height;
                        }
                    }
                    if root.toast_text != "" : Rectangle {
                        height: 36px;
                        border-radius: Tokens.control-radius;
                        background: Tokens.accent-soft;
                        HorizontalLayout {
                            padding-left: Tokens.space-3;
                            padding-right: Tokens.space-3;
                            spacing: Tokens.space-2;
                            Text { text: root.toast_text; color: Tokens.ink; font-size: Tokens.type-body; font-weight: 600; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            ChromeBtn { label: "知道了"; compact: true; clicked => { root.toast_text = ""; } }
                        }
                    }
                    Rectangle {
                        height: root.selected_task == "" ? 56px : 64px;
                        border-radius: Tokens.panel-radius;
                        background: Tokens.surface;
                        border-width: 1px;
                        border-color: Tokens.line;
                        VerticalLayout {
                            padding-left: Tokens.space-3;
                            padding-right: Tokens.space-3;
                            padding-top: Tokens.space-2;
                            padding-bottom: Tokens.space-2;
                            spacing: Tokens.space-1;
                            Text { text: root.detail_line; color: Tokens.ink; font-size: Tokens.type-body; wrap: word-wrap; }
                            if root.detail_map.length > 0 : ConnectionBar {
                                width: 100%;
                                cells: root.detail_map;
                                fill: Tokens.accent;
                            }
                            if root.selected_task == "" : Text {
                                text: "确认窗预创建 · 无 WebView2 · 无 Python · 分段写入零二次下载";
                                color: Tokens.muted;
                                font-size: Tokens.type-caption;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component CastHudWindow inherits Window {
    title: "投屏";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    always-on-top: true;
    preferred-width: 360px;
    preferred-height: 140px;
    background: Tokens.surface;
    in-out property <string> status: "未开始投屏";
    in-out property <string> device;
    callback command(string);
    VerticalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-3;
        OverlayKicker { label: "投屏会话"; }
        Text { text: root.device; color: Tokens.ink; font-size: Tokens.type-title; font-weight: 600; overflow: elide; }
        Text { text: root.status; color: Tokens.muted; font-size: Tokens.type-body; wrap: word-wrap; }
        HorizontalLayout {
            spacing: Tokens.space-2;
            ChromeBtn { label: "播放"; clicked => { root.command("play"); } }
            ChromeBtn { label: "暂停"; clicked => { root.command("pause"); } }
            ChromeBtn { label: "停止"; danger: true; clicked => { root.command("stop"); } }
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "关闭"; clicked => { root.command("hide"); } }
        }
    }
}

export component LogWindow inherits Window {
    title: "任务日志";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    preferred-width: 520px;
    preferred-height: 360px;
    background: Tokens.surface;
    in-out property <string> text;
    callback command(string);
    VerticalLayout {
        spacing: 0px;
        WindowHeader { title: "任务日志"; subtitle: "最近传输记录"; }
        Rectangle { height: 1px; background: Tokens.line; }
        TextEdit { text <=> root.text; vertical-stretch: 1; }
        FooterBar {
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "关闭"; clicked => { root.command("hide"); } }
        }
    }
}

export component ExtensionWindow inherits Window {
    title: "浏览器插件";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    preferred-width: 460px;
    preferred-height: 280px;
    background: Tokens.surface;
    in-out property <string> status: "插件未连接";
    in-out property <string> detail: "Chrome / Edge 加载解压版：扩展管理 → 开发者模式 → 加载已解压的扩展程序。Firefox 使用同一扩展 ID 的签名包。";
    callback command(string);
    VerticalLayout {
        spacing: 0px;
        WindowHeader { title: "浏览器插件"; subtitle: "资源识别、点击接管、请求身份"; }
        Rectangle { height: 1px; background: Tokens.line; }
        VerticalLayout {
            padding: Tokens.space-4;
            spacing: Tokens.space-3;
            Text { text: root.status; color: Tokens.ink; font-size: Tokens.type-title; font-weight: 600; wrap: word-wrap; }
            Text { text: root.detail; color: Tokens.muted; font-size: Tokens.type-body; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
        }
        Rectangle { height: 1px; background: Tokens.line; }
        FooterBar {
            ChromeBtn { label: "打开插件目录"; clicked => { root.command("open_dir"); } }
            ChromeBtn { label: "Firefox 商店"; clicked => { root.command("firefox"); } }
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "关闭"; clicked => { root.command("hide"); } }
        }
    }
}

export component HarvestWindow inherits Window {
    title: "网页抓取";
    default-font-family: Tokens.type-face;
    default-font-size: Tokens.type-body;
    preferred-width: 620px;
    preferred-height: 520px;
    background: Tokens.bg;
    in-out property <[HarvestRow]> links;
    in-out property <string> status: "输入页面地址后抓取本页静态链接";
    in-out property <string> filter: "全部";
    in-out property <string> all_count: "0";
    in-out property <string> video_count: "0";
    in-out property <string> audio_count: "0";
    in-out property <string> archive_count: "0";
    in-out property <string> document_count: "0";
    in-out property <string> program_count: "0";
    in-out property <string> playlist_count: "0";
    in-out property <string> torrent_count: "0";
    callback command(string);
    VerticalLayout {
        spacing: 0px;
        WindowHeader { title: "网页抓取"; subtitle: "只读当前页 HTML，不执行脚本"; }
        Rectangle { height: 1px; background: Tokens.line; }
        VerticalLayout {
            padding: Tokens.space-3;
            spacing: Tokens.space-2;
            Text { text: root.status; color: Tokens.muted; font-size: Tokens.type-body; wrap: word-wrap; }
            HorizontalLayout {
                spacing: Tokens.space-1;
                ChromeBtn { label: "全部 " + root.all_count; compact: true; primary: root.filter == "全部"; clicked => { root.filter = "全部"; root.command("harvest_filter:全部"); } }
                ChromeBtn { label: "视频 " + root.video_count; compact: true; primary: root.filter == "video"; clicked => { root.filter = "video"; root.command("harvest_filter:video"); } }
                ChromeBtn { label: "音频 " + root.audio_count; compact: true; primary: root.filter == "audio"; clicked => { root.filter = "audio"; root.command("harvest_filter:audio"); } }
                ChromeBtn { label: "压缩包 " + root.archive_count; compact: true; primary: root.filter == "archive"; clicked => { root.filter = "archive"; root.command("harvest_filter:archive"); } }
            }
            HorizontalLayout {
                spacing: Tokens.space-1;
                ChromeBtn { label: "文档 " + root.document_count; compact: true; primary: root.filter == "document"; clicked => { root.filter = "document"; root.command("harvest_filter:document"); } }
                ChromeBtn { label: "程序 " + root.program_count; compact: true; primary: root.filter == "program"; clicked => { root.filter = "program"; root.command("harvest_filter:program"); } }
                ChromeBtn { label: "清单 " + root.playlist_count; compact: true; primary: root.filter == "playlist"; clicked => { root.filter = "playlist"; root.command("harvest_filter:playlist"); } }
                ChromeBtn { label: "种子 " + root.torrent_count; compact: true; primary: root.filter == "torrent"; clicked => { root.filter = "torrent"; root.command("harvest_filter:torrent"); } }
            }
            HorizontalLayout {
                spacing: Tokens.space-2;
                ChromeBtn { label: "全选当前"; compact: true; clicked => { root.command("harvest_all"); } }
                ChromeBtn { label: "取消当前"; compact: true; clicked => { root.command("harvest_none"); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Flickable {
                vertical-stretch: 1;
                viewport-height: root.links.length * 44px;
                for i in root.links.length : Rectangle {
                    y: i * 44px;
                    height: 44px;
                    width: parent.width;
                    background: root.links[i].picked ? Tokens.accent-soft : Tokens.surface;
                    TouchArea {
                        clicked => { root.command("harvest_toggle:" + root.links[i].url); }
                        HorizontalLayout {
                            padding-left: Tokens.space-2;
                            padding-right: Tokens.space-2;
                            spacing: Tokens.space-2;
                            alignment: center;
                            Text {
                                text: root.links[i].picked ? "▣" : "▢";
                                color: root.links[i].picked ? Tokens.accent : Tokens.muted;
                                font-size: Tokens.type-title;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.links[i].label; color: Tokens.ink; font-size: Tokens.type-body; font-weight: 600; overflow: elide; }
                                Text { text: root.links[i].detail; color: Tokens.muted; font-size: Tokens.type-caption; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.line; }
        FooterBar {
            ChromeBtn { label: "关闭"; clicked => { root.command("hide"); } }
            Rectangle { horizontal-stretch: 1; }
            ChromeBtn { label: "添加勾选"; primary: true; clicked => { root.command("harvest_add"); } }
        }
    }
}
