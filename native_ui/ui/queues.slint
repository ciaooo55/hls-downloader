import { LineEdit } from "std-widgets.slint";
import { Tokens, HotButton, FieldLabel, FocusRing, HotCheckBox, HotScrollView, HotComboBox, Panel } from "theme.slint";
import { DialogFooter } from "dialog_components.slint";
import { NavigationItem, WorkbenchButton } from "workbench_components.slint";

component WeekdayPill inherits Rectangle {
    in property <string> label;
    in property <string> day-name;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback toggled;
    private property <bool> focus-visible: false;
    height: Tokens.control-height;
    horizontal-stretch: 1;
    min-width: 36px;
    border-radius: Tokens.control-height / 2;
    border-width: 1px;
    border-color: root.active ? Tokens.accent : (touch.has-hover && root.enabled ? Tokens.border-strong : Tokens.line);
    background: root.active
        ? (touch.pressed && root.enabled ? Tokens.accent-pressed : touch.has-hover && root.enabled ? Tokens.accent-hover : Tokens.accent)
        : (touch.pressed && root.enabled ? Tokens.control-pressed : touch.has-hover && root.enabled ? Tokens.control-hover : Tokens.surface);
    opacity: root.enabled ? 1 : 0.58;
    animate background, border-color { duration: Tokens.motion-fast; easing: ease-out; }
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-label: root.day-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    forward-focus: focus;
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; radius: root.border-radius; shown: root.focus-visible && focus.has-focus; }
    Text {
        text: root.label;
        color: root.active ? Tokens.on-accent : Tokens.ink;
        font-size: 12px;
        font-weight: root.active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-visible = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.focus-visible = false; }
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.toggled(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { focus.focus(); root.toggled(); }
    }
}

export component QueueWindow inherits Window {
    icon: @image-url("../../assets/app-icon.png");
    title: "下载队列"; background: Tokens.canvas;
    default-font-family: Tokens.type-face; default-font-size: 13px;
    preferred-width: 780px; preferred-height: 580px; min-width: 640px;
    // 最小高度保证左侧队列列表至少显示约三项，列表不会被按钮挤成一行。
    min-height: 400px;
    in property <[string]> profiles;
    in-out property <int> selected;
    in-out property <string> queue-name;
    in-out property <string> priority;
    in-out property <string> max-active;
    in-out property <string> speed-limit;
    in-out property <bool> queue-enabled;
    in-out property <bool> schedule-enabled;
    in-out property <string> start-time;
    in-out property <string> stop-time;
    in-out property <string> active-days: "1,2,3,4,5,6,7";
    in-out property <[bool]> active-day-flags: [true, true, true, true, true, true, true];
    in-out property <string> completion-action;
    in property <bool> can-remove;
    in property <bool> can-assign;
    in property <bool> busy;
    in property <string> status;
    // 页脚状态语气：info / success / warning / error，由 Rust 随状态文字一起设置。
    in property <string> status-tone: "warning";
    callback select-profile(int);
    callback toggle-day(int);
    callback action(string);
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 180px; background: Tokens.rail;
                VerticalLayout {
                padding: 12px; spacing: 10px;
                profile-scroll := HotScrollView {
                    horizontal-scrollbar-policy: always-off;
                    viewport-width: self.width;
                    VerticalLayout {
                        // 队列多到需要滚动时，右侧让出覆盖式滚动条的宽度，滚动条不压在选中项上。
                        spacing: 4px; padding-right: root.profiles.length * 40px - 4px > profile-scroll.visible-height ? 12px : 0px;
                        for name[index] in root.profiles: NavigationItem {
                            label: name; icon: "queue"; active: index == root.selected; show-count: false; enabled: !root.busy;
                            clicked => { root.select-profile(index); }
                        }
                    }
                }
                WorkbenchButton { label: "新建队列"; icon: "new"; outlined: true; enabled: !root.busy; clicked => { root.action("add"); } }
                HorizontalLayout {
                    spacing: 8px;
                    WorkbenchButton { label: "上移队列"; icon: "arrow-up"; icon-only: true; outlined: true; enabled: !root.busy && root.selected > 0; clicked => { root.action("up"); } }
                    WorkbenchButton { label: "下移队列"; icon: "arrow-down"; icon-only: true; outlined: true; enabled: !root.busy && root.selected < root.profiles.length - 1; clicked => { root.action("down"); } }
                }
                HotButton { label: "删除队列"; icon: "delete"; danger: true; enabled: !root.busy && root.can-remove; clicked => { root.action("remove"); } }
                }
            }
            Rectangle { width: 1px; background: Tokens.line; }
            HotScrollView {
                horizontal-scrollbar-policy: always-off;
                viewport-width: self.width;
                enabled: !root.busy;
                VerticalLayout {
                    padding: 20px; padding-left: 24px; padding-right: 24px; spacing: 14px; alignment: start;
                    Panel {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Text { text: "队列设置"; color: Tokens.ink; font-size: 15px; font-weight: 700; }
                            // 标签与输入框成组（6px），组与组之间 12px，与左右并排字段一致。
                            VerticalLayout { spacing: 6px; FieldLabel { label: "队列名称"; } LineEdit { text <=> root.queue-name; height: Tokens.control-height; accessible-label: "队列名称"; } }
                            HotCheckBox { text: "启用队列"; checked <=> root.queue-enabled; }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout { spacing: 6px; FieldLabel { label: "优先级 -100 至 100"; } LineEdit { text <=> root.priority; height: Tokens.control-height; } }
                                VerticalLayout { spacing: 6px; FieldLabel { label: "活动任务 1 至 64"; } LineEdit { text <=> root.max-active; height: Tokens.control-height; } }
                            }
                            VerticalLayout { spacing: 6px; FieldLabel { label: "队列总限速 KiB/s（0 不限制）"; } LineEdit { text <=> root.speed-limit; height: Tokens.control-height; } }
                        }
                    }
                    Panel {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Text { text: "时间与完成动作"; color: Tokens.ink; font-size: 15px; font-weight: 700; }
                            HotCheckBox { text: "启用时间表"; checked <=> root.schedule-enabled; }
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout { spacing: 6px; FieldLabel { label: "开始 HH:mm"; } LineEdit { text <=> root.start-time; height: Tokens.control-height; enabled: root.schedule-enabled; } }
                                VerticalLayout { spacing: 6px; FieldLabel { label: "停止 HH:mm"; } LineEdit { text <=> root.stop-time; height: Tokens.control-height; enabled: root.schedule-enabled; } }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                FieldLabel { label: "生效星期"; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for day[index] in ["一", "二", "三", "四", "五", "六", "日"]: WeekdayPill {
                                        label: day;
                                        day-name: "周" + day;
                                        active: index < root.active-day-flags.length && root.active-day-flags[index];
                                        enabled: !root.busy;
                                        toggled => { root.toggle-day(index + 1); }
                                    }
                                }
                            }
                            VerticalLayout { spacing: 6px; FieldLabel { label: "队列全部完成后"; } HotComboBox {
                                model: ["无操作", "关机", "睡眠", "休眠"];
                                property <string> bound: root.completion-action;
                                current-index: root.completion-action == "休眠" ? 3 : root.completion-action == "睡眠" ? 2 : root.completion-action == "关机" ? 1 : 0;
                                changed bound => { self.current-index = root.completion-action == "休眠" ? 3 : root.completion-action == "睡眠" ? 2 : root.completion-action == "关机" ? 1 : 0; }
                                selected(value) => { root.completion-action = value; }
                                height: Tokens.control-height;
                            } }
                            Text { text: "仅在队列中的任务全部成功后触发，执行前可取消。"; color: Tokens.faint; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
        DialogFooter {
            status: root.status; tone: root.status-tone;
            HotButton { label: "取消"; enabled: !root.busy; clicked => { root.action("close"); } }
            if root.can-assign: HotButton { label: "保存并移动所选任务"; enabled: !root.busy; clicked => { root.action("assign"); } }
            HotButton { label: root.busy ? "保存中…" : "保存队列"; icon: "save"; primary: true; enabled: !root.busy; clicked => { root.action("save"); } }
        }
    }
}
