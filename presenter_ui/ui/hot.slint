import { LineEdit } from "std-widgets.slint";

export global Tokens {
    in-out property <bool> dark: false;
    in-out property <bool> reduce-motion: false;
    out property <duration> motion: reduce-motion ? 1ms : 150ms;
    out property <duration> motion-fast: reduce-motion ? 1ms : 90ms;
    out property <string> type-face: "Segoe UI Variable";
    out property <color> surface: dark ? #1c1f23 : #fcfdfe;
    out property <color> surface-2: dark ? #23272b : #f5f7fa;
    out property <color> surface-3: dark ? #2b3035 : #e8edf3;
    out property <color> ink: dark ? #f4f5f6 : #0f172a;
    out property <color> muted: dark ? #c5c9cf : #475569;
    out property <color> accent: dark ? #5ea2f3 : #2563eb;
    out property <color> accent-hover: dark ? #7eb7f6 : #1d4ed8;
    out property <color> on-accent: #ffffff;
    out property <color> done: #16a34a;
    out property <color> warn: #d97706;
    out property <color> fail: #dc2626;
    out property <color> line: dark ? #383d43 : #d8e0ea;
}

component HotButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked;
    min-width: 72px;
    height: 34px;
    border-radius: 7px;
    background: primary ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) : (touch.has-hover ? Tokens.surface-3 : Tokens.surface-2);
    border-width: primary ? 0px : 1px;
    border-color: danger ? Tokens.fail : Tokens.line;
    animate background { duration: Tokens.motion-fast; easing: ease-out; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            color: primary ? Tokens.on-accent : (danger ? Tokens.fail : Tokens.ink);
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Kicker inherits HorizontalLayout {
    in property <string> label;
    in property <color> tone: Tokens.accent;
    spacing: 7px;
    alignment: center;
    Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.tone; }
    Text { text: root.label; color: Tokens.muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
}

component Panel inherits Rectangle {
    border-radius: 10px;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.line;
    @children
}

export component ConfirmWindow inherits Window {
    title: "确认下载";
    default-font-family: Tokens.type-face;
    default-font-size: 12px;
    always-on-top: true;
    no-frame: true;
    min-width: 440px;
    min-height: 246px;
    preferred-width: 440px;
    preferred-height: 246px;
    background: transparent;
    in-out property <string> filename;
    in-out property <string> url;
    in-out property <string> size_text;
    in-out property <string> remaining;
    in-out property <float> intro: 1;
    callback command(string);
    Panel {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            opacity: Tokens.reduce-motion ? 1 : root.intro;
            animate opacity { duration: Tokens.motion; easing: ease-out; }
            TouchArea {
                height: 22px;
                mouse-cursor: move;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.command("drag");
                    }
                }
                Kicker { label: "浏览器下载确认"; }
            }
            Text { text: "文件名"; color: Tokens.muted; font-size: 11px; font-weight: 600; }
            LineEdit { text <=> root.filename; }
            Text { text: root.url; color: Tokens.muted; font-size: 11px; overflow: elide; }
            Text { text: root.size_text; color: Tokens.ink; font-size: 12px; font-weight: 600; }
            Text { text: root.remaining; color: Tokens.muted; font-size: 11px; visible: root.remaining != ""; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                HotButton { label: "保留浏览器下载"; clicked => { root.command("reject"); } }
                HotButton { label: "确认下载"; primary: true; clicked => { root.command("accept"); } }
            }
        }
    }
}

export component ProgressWindow inherits Window {
    title: headline;
    default-font-family: Tokens.type-face;
    default-font-size: 12px;
    min-width: 400px;
    min-height: 174px;
    preferred-width: 400px;
    preferred-height: 174px;
    background: transparent;
    always-on-top: true;
    no-frame: true;
    in-out property <string> headline: "下载进度";
    in-out property <string> filename;
    in-out property <string> speed;
    in-out property <float> progress;
    callback command(string);
    Panel {
        VerticalLayout {
            padding: 16px;
            spacing: 11px;
            Kicker { label: root.headline; }
            Text { text: root.filename; color: Tokens.ink; font-size: 14px; font-weight: 600; overflow: elide; }
            HorizontalLayout {
                Text { text: root.speed; color: Tokens.accent; font-size: 12px; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "\{Math.round(root.progress * 100)}%"; color: Tokens.muted; font-size: 12px; font-weight: 600; }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Tokens.surface-3;
                clip: true;
                Rectangle {
                    width: parent.width * root.progress;
                    height: parent.height;
                    border-radius: 3px;
                    background: Tokens.accent;
                    animate width { duration: Tokens.motion; easing: ease-out; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                HotButton { label: "暂停"; clicked => { root.command("pause"); } }
                HotButton { label: "取消"; danger: true; clicked => { root.command("cancel"); } }
            }
        }
    }
}

export component CompleteWindow inherits Window {
    title: "下载完成";
    default-font-family: Tokens.type-face;
    default-font-size: 12px;
    always-on-top: true;
    no-frame: true;
    min-width: 440px;
    min-height: 188px;
    preferred-width: 440px;
    preferred-height: 188px;
    background: transparent;
    in-out property <string> filename;
    in-out property <string> power_hint;
    callback command(string);
    Panel {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Kicker { label: "下载完成"; tone: Tokens.done; }
            Text { text: root.filename; color: Tokens.ink; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.power_hint; color: Tokens.warn; font-size: 12px; wrap: word-wrap; visible: root.power_hint != ""; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                HotButton { label: "打开文件"; primary: true; clicked => { root.command("open_file"); } }
                HotButton { label: "打开目录"; clicked => { root.command("open_folder"); } }
                Rectangle { horizontal-stretch: 1; }
                if root.power_hint != "" : HotButton { label: "取消关机"; danger: true; clicked => { root.command("cancel_power"); } }
                HotButton { label: "关闭"; clicked => { root.command("hide_complete"); } }
            }
        }
    }
}
