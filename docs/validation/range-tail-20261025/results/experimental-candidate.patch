+    #[test]
+    fn idle_range_worker_helps_large_active_tail_without_overlapping_a_pending_write() {
+        let mib = 1024 * 1024u64;
+        let scheduler = RangeScheduler::new(vec![WorkRange { start: 0, end: 8 * mib - 1 }], 2);
+        let first = scheduler.claim(0).unwrap();
+        first.progress.lock().unwrap().cursor = 128 * 1024;
+        // 写线程可能仍在锁外限速/落盘，已取出的最多一个 WRITE_BATCH 也必须保留。
+        let reserved_end = 128 * 1024 + WRITE_BATCH as u64 - 1;
+        let second = scheduler.claim(1).expect("idle worker must help a large active tail");
+        let first_state = first.progress.lock().unwrap();
+        let second_state = second.progress.lock().unwrap();
+        assert!(first_state.stop >= reserved_end);
+        assert_eq!(first_state.stop + 1, second_state.cursor);
+        assert_eq!(second_state.stop, 8 * mib - 1);
+        drop(second_state);
+        drop(first_state);
+        scheduler.complete(second.id);
+
+        // 允许多次帮助，但最后小段不能被继续拆出大量细碎请求。
+        let mut right = Vec::new();
+        loop {
+            let Some(helper) = scheduler.claim(1) else { break };
+            let state = helper.progress.lock().unwrap();
+            assert!(state.stop - state.cursor + 1 >= mib);
+            right.push((state.cursor, state.stop));
+            drop(state);
+            scheduler.complete(helper.id);
+        }
+        let first_state = first.progress.lock().unwrap();
+        assert!(first_state.stop >= reserved_end);
+        right.push((0, first_state.stop));
+        drop(first_state);
+        // 第二个 worker 的首段也属于完整覆盖。
+        let state = second.progress.lock().unwrap();
+        right.push((state.cursor, state.stop));
+        right.sort_unstable();
+        assert_eq!(right.first().unwrap().0, 0);
+        assert_eq!(right.last().unwrap().1, 8 * mib - 1);
+        assert!(right.windows(2).all(|pair| pair[0].1 + 1 == pair[1].0));
+    }
